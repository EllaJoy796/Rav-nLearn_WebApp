@{
    ViewData["Title"] = "My Flashcards";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn - My Flashcards</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg:            #0d0d12;
            --sidebar-bg:    #111118;
            --sidebar-width: 72px;
            --sidebar-expanded: 220px;
            --card-bg:       #1e1a2e;
            --card-hover:    #251f3a;
            --card-new-bg:   #16132a;
            --accent:        #7c5cbf;
            --accent-soft:   rgba(124, 92, 191, 0.18);
            --accent-chip:   #5a3f9e;
            --text-white:    #f0eeff;
            --text-muted:    #7a7490;
            --text-dim:      #4e4868;
            --border:        rgba(124, 92, 191, 0.12);
            --icon-bg:       rgba(124, 92, 191, 0.22);
            --topbar-h:      64px;
        }

        /* ── LIGHT MODE ── */
        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --card-new-bg: #e8e4f8;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
            --icon-bg:     rgba(124,92,191,.15);
        }
        body.light-mode .search-bar input { background: #edeaf8; border-color: rgba(124,92,191,.3); color: var(--text-white); }
        body.light-mode .search-bar .search-icon svg { stroke: var(--text-muted); }
        body.light-mode .card-fc-banner { background: linear-gradient(135deg, #ded8f5 0%, #e8e3f8 100%); }
        body.light-mode .nav-item     { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }
        body.light-mode .ctx-menu { background: #f4f3ff; }

        html, body {
            height: 100%;
            background-color: var(--bg);
            font-family: 'DM Sans', sans-serif;
            color: var(--text-white);
            overflow: hidden;
        }

        .shell {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* ═══════════════════════════════════════
           SIDEBAR
        ═══════════════════════════════════════ */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding: 16px 0;
            gap: 0;
            flex-shrink: 0;
            z-index: 100;
            overflow: hidden;
            transition: width 0.25s ease;
            position: relative;
        }

        .sidebar:hover {
            width: var(--sidebar-expanded);
        }

        .sidebar-logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 15px;
            margin-bottom: 28px;
            flex-shrink: 0;
            overflow: hidden;
        }

        .logo-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
        }

        .logo-icon img {
            width: 38px;
            height: 38px;
            object-fit: contain;
            border-radius: 10px;
        }

        .logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 15px;
            font-weight: 800;
            color: var(--text-white);
            white-space: nowrap;
            opacity: 0;
            transition: opacity 0.2s ease 0.05s;
        }

        .sidebar:hover .logo-text { opacity: 1; }

        .nav-group {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            width: 100%;
            padding: 0 12px;
        }

        .nav-group + .nav-group {
            margin-top: 8px;
            padding-top: 16px;
            border-top: 1px solid var(--border);
        }

        .nav-group-label {
            font-size: 10px;
            font-weight: 700;
            color: var(--text-dim);
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 0 4px;
            margin-bottom: 6px;
            white-space: nowrap;
            opacity: 0;
            max-height: 0;
            overflow: hidden;
            transition: opacity 0.2s ease, max-height 0.2s ease;
        }

        .sidebar:hover .nav-group-label {
            opacity: 1;
            max-height: 20px;
        }

        .nav-item {
            width: 100%;
            height: 44px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 11px;
            cursor: pointer;
            transition: background 0.2s ease, color 0.2s ease;
            color: white;
            text-decoration: none;
            overflow: hidden;
            white-space: nowrap;
        }

        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }

        .nav-item svg {
            width: 20px;
            height: 20px;
            min-width: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .nav-label {
            font-size: 13px;
            font-weight: 600;
            opacity: 0;
            transition: opacity 0.2s ease 0.05s;
            overflow: hidden;
        }

        .sidebar:hover .nav-label { opacity: 1; }

        .nav-item::after {
            content: attr(data-tip);
            position: absolute;
            left: 82px;
            top: auto;
            background: #1e1e2e;
            color: var(--text-white);
            font-size: 12px;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 6px;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.15s ease;
            border: 1px solid var(--border);
            z-index: 200;
        }

        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }

        .sidebar-bottom {
            margin-top: auto;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
            width: 100%;
            padding: 0 12px;
        }

        /* ═══════════════════════════════════════
           MAIN
        ═══════════════════════════════════════ */
        .main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .topbar {
            height: var(--topbar-h);
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 0 28px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px;
            font-weight: 900;
            color: var(--text-white);
            letter-spacing: -0.3px;
            white-space: nowrap;
            flex: 1;
        }

        .search-bar {
            width: 600px;
            position: relative;
        }

        .search-bar input {
            width: 100%;
            height: 40px;
            background: #1a1726;
            border: 1px solid white;
            border-radius: 10px;
            padding: 0 16px 0 40px;
            color: var(--text-white);
            font-size: 13px;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s ease;
        }

        .search-bar input:focus { border-color: var(--accent); }
        .search-bar input::placeholder { color: var(--text-dim); }

        .search-bar .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
        }

        .search-bar .search-icon svg {
            width: 16px;
            height: 16px;
            stroke: white;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ─── CONTENT ─── */
        .content {
            flex: 1;
            overflow-y: auto;
            padding: 32px 28px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-track { background: transparent; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        .section-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            letter-spacing: 0.5px;
            margin-bottom: 20px;
        }

        /* ─── GRID ─── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        /* ─── FLASHCARD CARD ─── */
        .card-fc {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            display: flex;
            flex-direction: column;
            cursor: pointer;
            position: relative;
            min-height: 200px;
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
            animation: fadeUp 0.4s ease both;
            overflow: hidden;
        }

        .card-fc:hover {
            background: var(--card-hover);
            border-color: rgba(124, 92, 191, 0.3);
            transform: translateY(-2px);
        }

        /* Coloured top banner */
        .card-fc-banner {
            width: 100%;
            height: 110px;
            background: linear-gradient(135deg, #251f3a 0%, #1a1530 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            flex-shrink: 0;
        }

        /* Stacked cards illustration */
        .fc-stack {
            position: relative;
            width: 64px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .fc-icon-back {
            width: 64px;
            height: 52px;
        }

        /* Chip on banner */
        .banner-chip {
            position: absolute;
            top: 12px;
            left: 14px;
            padding: 3px 10px;
            background: var(--accent-chip);
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            color: #c8b8f0;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Three-dot menu */
        .btn-more {
            position: absolute;
            top: 10px;
            right: 10px;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-dim);
            padding: 4px 5px;
            border-radius: 6px;
            display: flex;
            flex-direction: column;
            gap: 3px;
            align-items: center;
            transition: color 0.2s ease, background 0.2s ease;
        }

        .btn-more:hover {
            color: var(--text-muted);
            background: var(--accent-soft);
        }

        .btn-more span {
            width: 3px;
            height: 3px;
            background: currentColor;
            border-radius: 50%;
            display: block;
        }

        /* Card body */
        .card-fc-body {
            padding: 14px 16px 14px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .fc-name {
            font-family: 'Syne', sans-serif;
            font-size: 14px;
            font-weight: 700;
            color: var(--text-white);
            letter-spacing: 0.3px;
        }

        .fc-subject {
            display: inline-block;
            padding: 3px 10px;
            background: var(--accent-chip);
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
            color: #c8b8f0;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            width: fit-content;
        }

        .fc-subject.hidden { display: none; }

        .card-fc-meta {
            display: flex;
            align-items: center;
            gap: 6px;
            color: var(--text-dim);
            font-size: 11px;
            margin-top: auto;
        }

        .card-fc-meta svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }

        .meta-files {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: 4px;
            color: var(--text-dim);
            font-size: 11px;
        }

        .meta-files svg {
            width: 12px;
            height: 12px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ─── EMPTY STATE ─── */
        .empty-state {
            grid-column: 1 / -1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 60px 20px;
            color: var(--text-dim);
            text-align: center;
        }

        .empty-state svg {
            width: 48px;
            height: 48px;
            stroke: var(--text-dim);
            fill: none;
            stroke-width: 1.2;
            stroke-linecap: round;
            stroke-linejoin: round;
            opacity: 0.5;
        }

        .empty-state p { font-size: 14px; }

        /* ── CONTEXT MENU ── */
        .ctx-menu {
            position: fixed;
            background: #1e1a2e;
            border: 1px solid rgba(124,92,191,0.25);
            border-radius: 10px;
            padding: 6px;
            min-width: 150px;
            z-index: 999;
            box-shadow: 0 8px 24px rgba(0,0,0,0.4);
            display: none;
        }
        .ctx-menu.visible { display: block; }
        .ctx-item {
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 13px;
            cursor: pointer;
            color: var(--text-muted);
            transition: background 0.15s, color 0.15s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .ctx-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .ctx-item.danger { color: #e07070; }
        .ctx-item.danger:hover { background: rgba(224,112,112,0.12); }

        /* ── MODALS ── */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(4px);
            z-index: 500;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .modal-overlay.open { display: flex; }
        .modal {
            background: #1a1626;
            border: 1px solid rgba(124,92,191,0.25);
            border-radius: 20px;
            padding: 32px;
            width: min(420px, 90vw);
            box-shadow: 0 24px 60px rgba(0,0,0,0.5);
            animation: modalIn 0.2s ease;
        }
        @@keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: none; } }
        .modal-title { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: var(--text-white); margin-bottom: 6px; }
        .modal-sub { font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
        .field-label { font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 0.6px; text-transform: uppercase; margin-bottom: 7px; display: block; }
        .field-input { width: 100%; height: 44px; background: #0f0d1a; border: 1px solid rgba(124,92,191,0.2); border-radius: 10px; padding: 0 14px; color: var(--text-white); font-size: 14px; font-family: inherit; outline: none; transition: border-color 0.2s; margin-bottom: 16px; }
        .field-input:focus { border-color: var(--accent); }
        .field-input::placeholder { color: var(--text-dim); }
        .modal-actions { display: flex; gap: 10px; margin-top: 8px; }
        .btn-cancel { flex: 1; height: 44px; background: none; border: 1px solid rgba(124,92,191,0.2); border-radius: 10px; color: var(--text-muted); font-size: 14px; font-weight: 600; font-family: inherit; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
        .btn-cancel:hover { border-color: var(--accent); color: var(--text-white); }
        .btn-create { flex: 2; height: 44px; background: var(--accent); border: none; border-radius: 10px; color: #fff; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; transition: background 0.2s; }
        .btn-create:hover { background: #6b4daa; }
        .btn-create:disabled { background: #3a3050; color: var(--text-dim); cursor: not-allowed; }
        .error-msg { font-size: 12px; color: #e07070; margin-top: -10px; margin-bottom: 12px; display: none; }
        .error-msg.visible { display: block; }

        .delete-modal {
            background: #1a1626;
            border: 1px solid rgba(224,112,112,0.2);
            border-radius: 20px;
            padding: 32px;
            width: min(380px, 90vw);
            box-shadow: 0 24px 60px rgba(0,0,0,0.5);
            animation: modalIn 0.2s ease;
        }
        .delete-modal .modal-title { color: #e07070; }
        .btn-delete-confirm { flex: 2; height: 44px; background: #c0392b; border: none; border-radius: 10px; color: #fff; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; transition: background 0.2s; }
        .btn-delete-confirm:hover { background: #a93226; }
        .btn-delete-confirm:disabled { background: #5a2a2a; color: #888; cursor: not-allowed; }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar {
                width: 100% !important;
                flex-direction: row;
                height: 56px;
                padding: 0 16px;
                gap: 8px;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-icon { width: 34px; height: 34px; min-width: 34px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
            .search-bar { width: 100%; }
        }
    </style>
</head>
<body>
<div class="shell">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <aside class="sidebar">

        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                     alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item active" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Help/Index" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>

        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="Profile"
               style="height:auto; padding:8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>

    </aside>

    <!-- ══════════════ MAIN ══════════════ -->
    <div class="main">

        <!-- TOP BAR -->
        <header class="topbar">
            <span class="page-title">My Flashcards</span>

            <div class="search-bar">
                <span class="search-icon">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                </span>
                <input type="text" placeholder="Search flashcards..." id="searchInput" oninput="filterCards()" />
            </div>

        </header>

        <!-- CONTENT -->
        <div class="content">
            <div class="section-label">Your collections of flashcards</div>

            <div class="cards-grid" id="cardsGrid">

                @if (ViewBag.Flashcards != null && ((IEnumerable<dynamic>)ViewBag.Flashcards).Any())
                {
                    int i = 0;
                    foreach (var set in ViewBag.Flashcards)
                    {
                        <div class="card-fc" data-id="@set.Id" data-name="@set.Name?.ToLower()"
                             onclick="window.location.href='/Chat/FlashcardView?id=@(set.Id)'"
                             style="animation-delay: @(i * 0.05)s">
                            <div class="card-fc-banner">
                                <span class="banner-chip">@set.CardCount Flashcards</span>
                                <div class="fc-stack">
                                    <svg class="fc-icon-back" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="10" y="14" width="30" height="22" rx="3" stroke="rgba(255,255,255,0.35)" stroke-width="2" transform="rotate(-6 10 14)"/>
                                        <rect x="8" y="12" width="30" height="22" rx="3" fill="rgba(124,92,191,0.3)" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
                                    </svg>
                                </div>
                                <button class="btn-more" onclick="event.stopPropagation(); showContextMenu(event, @(set.Id), '@(set.Name?.Replace("'", "\\'"))')">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                            <div class="card-fc-body">
                                <div class="fc-name">@set.Name?.ToUpper()</div>
                                @if (!string.IsNullOrWhiteSpace((string)set.Subject))
                                {
                                    <span class="fc-subject">@set.Subject</span>
                                }
                                <div class="card-fc-meta">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @set.Date?.ToString("MMM dd, yyyy")
                                </div>
                            </div>
                        </div>
                        i++;
                    }
                }
                else
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        <p>No flashcard sets yet.<br>Go to <strong>My Chats</strong> to create one.</p>
                    </div>
                }

            </div>
        </div>

    </div>
</div>

<!-- ── RENAME MODAL ── -->
<div class="modal-overlay" id="renameOverlay" onclick="handleRenameOverlayClick(event)">
    <div class="modal">
        <div class="modal-title">Rename Flashcard Set</div>
        <div class="modal-sub">Enter a new name for this flashcard set.</div>

        <label class="field-label" for="renameInput">New name</label>
        <input class="field-input" id="renameInput" type="text"
               placeholder="e.g. Linux Reviewer" maxlength="100"
               oninput="validateRenameForm()" onkeydown="handleRenameKey(event)" />
        <div class="error-msg" id="renameError">Please enter a name.</div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeRenameModal()">Cancel</button>
            <button class="btn-create" id="btnRename" onclick="submitRename()" disabled>Save</button>
        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal-overlay" id="deleteOverlay" onclick="handleDeleteOverlayClick(event)">
    <div class="delete-modal">
        <div class="modal-title">Delete Flashcard Set?</div>
        <div class="modal-sub" id="deleteModalSub">This will permanently delete this set and all its flashcards. This cannot be undone.</div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-delete-confirm" id="btnDeleteConfirm" onclick="submitDelete()">Delete</button>
        </div>
    </div>
</div>

<!-- ── CONTEXT MENU ── -->
<div class="ctx-menu" id="ctxMenu">
    <div class="ctx-item" onclick="ctxRename()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Rename
    </div>
    <div class="ctx-item danger" onclick="ctxDelete()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v6M14 11v6"/>
        </svg>
        Delete
    </div>
</div>

<!-- ── LOGOUT MODAL ── -->
<div id="logoutModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:16px; padding:28px 28px 24px;
        width:340px; text-align:center; font-family:'DM Sans',sans-serif;">
        <div style="width:48px; height:48px; border-radius:14px;
            background:rgba(220,60,60,.12); display:flex; align-items:center;
            justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Syne',sans-serif; font-size:16px; font-weight:800;
                    color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            Are you sure you want to log out of Rev'nLearn?
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border);
                       background:transparent; color:var(--text-white);
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">
                Cancel
            </button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none;
                       background:#c0392b; color:#fff; text-decoration:none;
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer; display:flex; align-items:center; justify-content:center;">
                Yes, Log Out
            </a>
        </div>
    </div>
</div>

<script>
    /* ── THEME INIT ── */
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();

    let ctxSetId   = null;
    let ctxSetName = '';

    // ── SEARCH ────────────────────────────────────────────
    function filterCards() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.card-fc').forEach(card => {
            const name = card.dataset.name ?? '';
            card.style.display = name.includes(q) ? '' : 'none';
        });
    }

    // ── CONTEXT MENU ──────────────────────────────────────
    function showContextMenu(e, setId, setName) {
        ctxSetId   = setId;
        ctxSetName = setName;
        const menu = document.getElementById('ctxMenu');
        menu.classList.add('visible');
        const x = Math.min(e.clientX, window.innerWidth - 170);
        const y = Math.min(e.clientY + 4, window.innerHeight - 100);
        menu.style.left = x + 'px';
        menu.style.top  = y + 'px';
    }

    function hideContextMenu() { document.getElementById('ctxMenu').classList.remove('visible'); }

    document.addEventListener('click', hideContextMenu);
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { hideContextMenu(); closeRenameModal(); closeDeleteModal(); }
    });

    function ctxRename() { hideContextMenu(); openRenameModal(ctxSetId, ctxSetName); }
    function ctxDelete() { hideContextMenu(); openDeleteModal(ctxSetId, ctxSetName); }

    // ── RENAME MODAL ──────────────────────────────────────
    function openRenameModal(id, currentName) {
        ctxSetId = id;
        const input = document.getElementById('renameInput');
        input.value = currentName;
        document.getElementById('renameError').classList.remove('visible');
        document.getElementById('btnRename').disabled = false;
        document.getElementById('renameOverlay').classList.add('open');
        setTimeout(() => { input.focus(); input.select(); }, 100);
    }
    function closeRenameModal() { document.getElementById('renameOverlay').classList.remove('open'); }
    function handleRenameOverlayClick(e) { if (e.target === document.getElementById('renameOverlay')) closeRenameModal(); }
    function handleRenameKey(e) {
        if (e.key === 'Escape') closeRenameModal();
        if (e.key === 'Enter' && !document.getElementById('btnRename').disabled) submitRename();
    }
    function validateRenameForm() {
        const val = document.getElementById('renameInput').value.trim();
        document.getElementById('btnRename').disabled = val.length === 0;
        document.getElementById('renameError').classList.remove('visible');
    }

    async function submitRename() {
        const newName = document.getElementById('renameInput').value.trim();
        if (!newName) { document.getElementById('renameError').classList.add('visible'); return; }

        const btn = document.getElementById('btnRename');
        btn.disabled = true; btn.textContent = 'Saving…';
        try {
            const res  = await fetch('/Chat/RenameProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: ctxSetId, name: newName })
            });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }

            const card = document.querySelector(`.card-fc[data-id="${ctxSetId}"]`);
            if (card) {
                card.dataset.name = newName.toLowerCase();
                const nameEl = card.querySelector('.fc-name');
                if (nameEl) nameEl.textContent = newName.toUpperCase();
            }
            closeRenameModal();
        } catch (err) { alert('Network error: ' + err.message); }
        finally { btn.disabled = false; btn.textContent = 'Save'; }
    }

    // ── DELETE CONFIRM MODAL ──────────────────────────────
    function openDeleteModal(id, name) {
        ctxSetId = id;
        document.getElementById('deleteModalSub').textContent =
            `"${name}" and all its flashcards will be permanently deleted. This cannot be undone.`;
        document.getElementById('deleteOverlay').classList.add('open');
    }
    function closeDeleteModal() { document.getElementById('deleteOverlay').classList.remove('open'); }
    function handleDeleteOverlayClick(e) { if (e.target === document.getElementById('deleteOverlay')) closeDeleteModal(); }

    async function submitDelete() {
        if (!ctxSetId) return;
        const btn = document.getElementById('btnDeleteConfirm');
        btn.disabled = true; btn.textContent = 'Deleting…';
        try {
            const res  = await fetch(`/Chat/DeleteProject/${ctxSetId}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }

            document.querySelector(`.card-fc[data-id="${ctxSetId}"]`)?.remove();
            ctxSetId = null;
            closeDeleteModal();

            if (document.querySelectorAll('.card-fc').length === 0) {
                document.getElementById('cardsGrid').innerHTML = `
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        <p>No flashcard sets yet.<br>Go to <strong>My Chats</strong> to create one.</p>
                    </div>`;
            }
        } catch (err) { alert('Network error: ' + err.message); }
        finally { btn.disabled = false; btn.textContent = 'Delete'; }
    }


</script>
</body>
</html>
