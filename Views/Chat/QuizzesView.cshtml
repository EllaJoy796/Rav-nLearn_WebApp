@{
    ViewData["Title"] = "Quiz Set";
    Layout = null;

    var setName = ViewBag.SetName ?? "LINUX REVIEWER";
    var setDate  = ViewBag.SetDate  ?? "May 13, 2026";
    var quizzes  = ViewBag.Quizzes  as IEnumerable<dynamic>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn – @setName</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:               #0d0d12;
            --sidebar-bg:       #111118;
            --sidebar-width:    72px;
            --sidebar-expanded: 220px;
            --card-bg:          #1e1a2e;
            --card-hover:       #251f3a;
            --accent:           #7c5cbf;
            --accent-soft:      rgba(124,92,191,.18);
            --accent-chip:      #5a3f9e;
            --text-white:       #f0eeff;
            --text-muted:       #7a7490;
            --text-dim:         #4e4868;
            --border:           rgba(124,92,191,.12);
            --topbar-h:         64px;
        }

        /* ── LIGHT MODE ── */
        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
        }
        body.light-mode .nav-item     { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }

        html, body {
            height: 100%;
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            color: var(--text-white);
            overflow: hidden;
        }

        .shell { display: flex; height: 100vh; width: 100vw; }

        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding: 16px 0;
            flex-shrink: 0;
            z-index: 100;
            overflow: hidden;
            transition: width .25s ease;
        }
        .sidebar:hover { width: var(--sidebar-expanded); }

        .sidebar-logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 15px;
            margin-bottom: 28px;
            overflow: hidden;
        }
        .logo-icon {
            width: 42px; height: 42px; min-width: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 15px; font-weight: 800;
            color: var(--text-white); white-space: nowrap;
            opacity: 0; transition: opacity .2s ease .05s;
        }
        .sidebar:hover .logo-text { opacity: 1; }

        .nav-group {
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }
        .nav-group + .nav-group {
            margin-top: 8px; padding-top: 16px;
            border-top: 1px solid var(--border);
        }
        .nav-group-label {
            font-size: 10px; font-weight: 700;
            color: var(--text-dim); letter-spacing: .8px;
            text-transform: uppercase;
            padding: 0 4px; margin-bottom: 6px;
            white-space: nowrap; opacity: 0;
            max-height: 0; overflow: hidden;
            transition: opacity .2s ease, max-height .2s ease;
        }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }

        .nav-item {
            width: 100%; height: 44px; border-radius: 10px;
            display: flex; align-items: center; gap: 12px;
            padding: 0 11px; cursor: pointer;
            transition: background .2s ease, color .2s ease;
            color: white; text-decoration: none;
            overflow: hidden; white-space: nowrap;
            position: relative;
        }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg {
            width: 20px; height: 20px; min-width: 20px;
            stroke: currentColor; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .nav-label {
            font-size: 13px; font-weight: 600;
            opacity: 0; transition: opacity .2s ease .05s; overflow: hidden;
        }
        .sidebar:hover .nav-label { opacity: 1; }

        .nav-item::after {
            content: attr(data-tip);
            position: absolute; left: 82px;
            background: #1e1e2e; color: var(--text-white);
            font-size: 12px; font-weight: 600;
            padding: 5px 10px; border-radius: 6px;
            white-space: nowrap; pointer-events: none;
            opacity: 0; transition: opacity .15s ease;
            border: 1px solid var(--border); z-index: 200;
        }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }

        .sidebar-bottom {
            margin-top: auto;
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }

        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

        .topbar {
            height: var(--topbar-h);
            display: flex; align-items: center; gap: 16px;
            padding: 0 28px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .btn-back {
            display: flex; align-items: center; gap: 8px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-white);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            padding: 0 14px; height: 36px;
            cursor: pointer; text-decoration: none;
            flex-shrink: 0;
            transition: background .2s ease, border-color .2s ease;
        }
        .btn-back:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-back svg {
            width: 14px; height: 14px;
            stroke: currentColor; fill: none;
            stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
        }

        .set-header { display: flex; flex-direction: column; gap: 2px; flex: 1; }
        .set-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px; font-weight: 900;
            color: var(--text-white); letter-spacing: -.3px;
        }
        .set-meta {
            font-size: 12px; color: var(--text-muted);
            display: flex; align-items: center; gap: 6px;
        }
        .set-meta .dot { width: 3px; height: 3px; background: var(--text-dim); border-radius: 50%; }

        .content {
            flex: 1; overflow-y: auto;
            padding: 32px 28px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        .section-label {
            font-size: 13px; font-weight: 600;
            color: var(--text-muted); letter-spacing: .5px;
            margin-bottom: 20px;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        /* QUIZ CARD */
        .qz-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            display: flex; flex-direction: column;
            padding: 16px;
            gap: 12px;
            cursor: pointer;
            transition: background .2s ease, border-color .2s ease, transform .15s ease;
            animation: fadeUp .4s ease both;
            position: relative;
        }
        .qz-item:hover {
            background: var(--card-hover);
            border-color: rgba(124,92,191,.35);
            transform: translateY(-2px);
        }
        .qz-item:nth-child(2) { animation-delay: .05s; }
        .qz-item:nth-child(3) { animation-delay: .10s; }
        .qz-item:nth-child(4) { animation-delay: .15s; }
        .qz-item:nth-child(5) { animation-delay: .20s; }
        .qz-item:nth-child(6) { animation-delay: .25s; }

        .qz-toprow {
            display: flex; align-items: center;
            justify-content: space-between; gap: 8px;
        }

        .qz-chips { display: flex; align-items: center; gap: 6px; }

        .chip {
            display: flex; align-items: center; gap: 5px;
            border-radius: 20px;
            padding: 4px 10px 4px 8px;
            font-size: 11px; font-weight: 700;
            letter-spacing: .3px;
        }
        .chip svg {
            width: 13px; height: 13px;
            stroke: currentColor; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .chip-download {
            background: rgba(124,92,191,.15);
            border: 1px solid rgba(124,92,191,.25);
            color: #c8b8f0;
        }
        .chip-buddy {
            background: var(--accent-soft);
            border: 1px solid rgba(124,92,191,.25);
            color: #c8b8f0;
        }

        .btn-dots {
            background: none; border: 1px solid var(--border);
            border-radius: 7px; cursor: pointer;
            color: var(--text-dim);
            width: 28px; height: 28px;
            display: flex; align-items: center; justify-content: center;
            gap: 2.5px; flex-direction: column;
            transition: color .2s ease, background .2s ease;
            flex-shrink: 0;
        }
        .btn-dots:hover { color: var(--text-muted); background: var(--accent-soft); }
        .btn-dots span { width: 3px; height: 3px; background: currentColor; border-radius: 50%; display: block; }

        .qz-name {
            font-family: 'Syne', sans-serif;
            font-size: 15px; font-weight: 800;
            color: var(--text-white); letter-spacing: .3px;
        }
        .qz-sub {
            font-size: 12px; color: var(--text-muted);
            margin-top: 2px;
        }

        .qz-prog-row {
            display: flex; align-items: center;
            justify-content: space-between;
            font-size: 11px; color: var(--text-muted);
        }
        .qz-prog-bar {
            height: 4px; background: rgba(124,92,191,.15);
            border-radius: 2px; overflow: hidden;
            margin-top: 6px;
        }
        .qz-prog-fill {
            height: 100%; background: var(--accent);
            border-radius: 2px; transition: width .4s ease;
        }

        .btn-take {
            width: 100%; height: 38px;
            background: transparent;
            border: 1px solid rgba(124,92,191,.35);
            border-radius: 10px;
            color: var(--text-white);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            display: flex; align-items: center; justify-content: center;
            gap: 8px; cursor: pointer;
            transition: background .2s ease, border-color .2s ease;
            margin-top: auto;
        }
        .btn-take:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-take svg {
            width: 14px; height: 14px; fill: currentColor; stroke: none;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar {
                width: 100% !important; flex-direction: row;
                height: 56px; padding: 0 16px; gap: 8px;
                border-right: none; border-bottom: 1px solid var(--border);
            }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-icon { width: 34px; height: 34px; min-width: 34px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                     alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item active" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Help/Index" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>

        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="Profile"
               style="height:auto; padding:8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <div class="main">

        <header class="topbar">
            <a class="btn-back" href="/Chat/Quizzes">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Back
            </a>
            <div class="set-header">
                <div class="set-title">@setName</div>
                <div class="set-meta">
                    @(ViewBag.QuizCount ?? 6) Quizzes
                    <span class="dot"></span>
                    @setDate
                </div>
            </div>
        </header>

        <div class="content">
            <div class="section-label">Quizzes</div>

            <div class="cards-grid">

                @if (quizzes != null)
                {
                    foreach (var quiz in quizzes)
                    {
                        int studied  = (int)(quiz.Studied ?? 0);
                        int total    = (int)(quiz.Total   ?? 1);
                        int progress = total > 0 ? (int)Math.Round((double)studied / total * 100) : 0;

                        <div class="qz-item" onclick="window.location.href='/Chat/QuizView?id=@(quiz.Id)'">
                            <div class="qz-toprow">
                                <div class="qz-chips">
                                    <div class="chip chip-download">
                                        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        Download
                                    </div>
                                    <div class="chip chip-buddy">
                                        <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                        Study Buddy
                                    </div>
                                </div>
                                <button class="btn-dots" onclick="event.stopPropagation(); showQuizMenu(@(quiz.Id))">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                            <div>
                                <div class="qz-name">@(quiz.Name?.ToUpper())</div>
                                <div class="qz-sub">@(quiz.Total) Questions</div>
                            </div>
                            <div>
                                <div class="qz-prog-row">
                                    <span>Progress</span>
                                    <span>@(quiz.Studied ?? 0)/@(quiz.Total ?? 0)</span>
                                </div>
                                <div class="qz-prog-bar">
                                    <div class="qz-prog-fill" style="width: @(progress)%"></div>
                                </div>
                            </div>
                            <button class="btn-take" onclick="event.stopPropagation(); window.location.href='/Chat/QuizView?id=@(quiz.Id)'">
                                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="none"/></svg>
                                Take the Quiz
                            </button>
                        </div>
                    }
                }
                else
                {
                    for (int i = 1; i <= 6; i++)
                    {
                        <div class="qz-item">
                            <div class="qz-toprow">
                                <div class="qz-chips">
                                    <div class="chip chip-download">
                                        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                        Download
                                    </div>
                                    <div class="chip chip-buddy">
                                        <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                        Study Buddy
                                    </div>
                                </div>
                                <button class="btn-dots" onclick="event.stopPropagation()">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                            <div>
                                <div class="qz-name">QUIZ 0@(i)</div>
                                <div class="qz-sub">10 Questions</div>
                            </div>
                            <div>
                                <div class="qz-prog-row">
                                    <span>Progress</span>
                                    <span>5/8</span>
                                </div>
                                <div class="qz-prog-bar">
                                    <div class="qz-prog-fill" style="width: 62%"></div>
                                </div>
                            </div>
                            <button class="btn-take">
                                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="none"/></svg>
                                Take the Quiz
                            </button>
                        </div>
                    }
                }

            </div>
        </div>

    </div>

    <!-- QUIZ MODAL -->
<div id="quizModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
    <div style="background:#1e1a2e;border:1px solid rgba(124,92,191,0.3);border-radius:20px;width:min(620px,92vw);max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.5);">
        <!-- Header -->
        <div style="display:flex;align-items:center;justify-content:space-between;padding:18px 24px;border-bottom:1px solid rgba(124,92,191,0.15);flex-shrink:0;">
            <div>
                <div id="modalQuizTitle" style="font-family:'Syne',sans-serif;font-size:16px;font-weight:800;color:#f0eeff;"></div>
                <div id="modalQuizSub" style="font-size:12px;color:#7a7490;margin-top:2px;"></div>
            </div>
            <button onclick="closeQuizModal()" style="background:none;border:none;color:#555;font-size:20px;cursor:pointer;padding:4px 8px;border-radius:6px;line-height:1;">✕</button>
        </div>
        <!-- Progress bar -->
        <div style="height:3px;background:rgba(124,92,191,0.15);flex-shrink:0;">
            <div id="modalProgress" style="height:100%;background:#7c5cbf;border-radius:2px;transition:width 0.3s;width:0%;"></div>
        </div>
        <!-- Body -->
        <div id="modalBody" style="flex:1;overflow-y:auto;padding:24px;scrollbar-width:thin;scrollbar-color:rgba(124,92,191,0.2) transparent;"></div>
        <!-- Footer -->
        <div style="padding:16px 24px;border-top:1px solid rgba(124,92,191,0.15);display:flex;align-items:center;justify-content:space-between;flex-shrink:0;">
            <div id="modalScore" style="font-size:13px;color:#7a7490;"></div>
            <div style="display:flex;gap:10px;">
                <button onclick="retryQuiz()" style="background:none;border:1px solid rgba(124,92,191,0.3);border-radius:10px;color:#c8b8f0;font-size:13px;font-weight:600;padding:8px 18px;cursor:pointer;font-family:inherit;transition:all .2s;">↺ Retry</button>
                <button onclick="closeQuizModal()" style="background:#7c5cbf;border:none;border-radius:10px;color:#fff;font-size:13px;font-weight:600;padding:8px 18px;cursor:pointer;font-family:inherit;transition:background .2s;">Done</button>
            </div>
        </div>
    </div>
</div>
</div>

<!-- ── LOGOUT MODAL ── -->
<div id="logoutModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:16px; padding:28px 28px 24px;
        width:340px; text-align:center; font-family:'DM Sans',sans-serif;">
        <div style="width:48px; height:48px; border-radius:14px;
            background:rgba(220,60,60,.12); display:flex; align-items:center;
            justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Syne',sans-serif; font-size:16px; font-weight:800;
                    color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            Are you sure you want to log out of Rev'nLearn?
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border);
                       background:transparent; color:var(--text-white);
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">
                Cancel
            </button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none;
                       background:#c0392b; color:#fff; text-decoration:none;
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer; display:flex; align-items:center; justify-content:center;">
                Yes, Log Out
            </a>
        </div>
    </div>
</div>

<script>
  (function () {
    if (localStorage.getItem('lightMode') === 'true')
        document.body.classList.add('light-mode');
})();

const projectId = new URLSearchParams(window.location.search).get('id');
let allSessions = [];
let currentSession = [];
let score = 0;
let answered = 0;

document.addEventListener('DOMContentLoaded', loadQuizzes);

async function loadQuizzes() {
    try {
        const res  = await fetch(`/Chat/GetQuizzesByProject?projectId=${projectId}`);
        const data = await res.json();
        const grid = document.querySelector('.cards-grid');
        grid.innerHTML = '';

        if (!data.length) {
            grid.innerHTML = `
                <div style="grid-column:1/-1;display:flex;flex-direction:column;align-items:center;
                    gap:12px;padding:60px 20px;color:var(--text-dim);text-align:center;">
                    <svg width="48" height="48" viewBox="0 0 24 24" stroke="currentColor" fill="none"
                        stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" opacity=".5">
                        <path d="M9 11l3 3L22 4"/>
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
                    </svg>
                    <p style="font-size:14px">No quizzes yet.<br>Go to a chat and ask to create a quiz.</p>
                </div>`;
            return;
        }

        // Group by session_id
        const sessions = new Map();
        data.forEach(q => {
            const sid = q.sessionId || q.quizId;
            if (!sessions.has(sid)) sessions.set(sid, []);
            sessions.get(sid).push(q);
        });

        allSessions = [...sessions.values()];

        let cardNum = 1;
        sessions.forEach((questions) => {
            grid.appendChild(makeQuizCard(cardNum++, questions));
        });

        // Update topbar count
        const countEl = document.querySelector('.set-meta');
        if (countEl) countEl.innerHTML = countEl.innerHTML.replace(/\d+ Quizzes?/, `${sessions.size} Quiz${sessions.size !== 1 ? 'zes' : ''}`);

    } catch (err) { console.error('Failed to load quizzes:', err); }
}

function makeQuizCard(num, questions) {
    const total = questions.length;
    const date  = questions[0]?.createdAt ?? '';
    const label = `QUIZ ${String(num).padStart(2, '0')}`;

    const div = document.createElement('div');
    div.className = 'qz-item';
    div.style.animationDelay = `${(num - 1) * 0.05}s`;
    div.innerHTML = `
        <div class="qz-toprow">
            <div class="qz-chips">
                <div class="chip chip-download">
                    <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Download
                </div>
                <div class="chip chip-buddy">
                    <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="8" y1="23" x2="16" y2="23"/></svg>
                    Study Buddy
                </div>
            </div>
            <button class="btn-dots" onclick="event.stopPropagation()">
                <span></span><span></span><span></span>
            </button>
        </div>
        <div>
            <div class="qz-name">${label}</div>
            <div class="qz-sub">${total} Question${total !== 1 ? 's' : ''} · ${date}</div>
        </div>
        <div>
            <div class="qz-prog-row">
                <span>Progress</span>
                <span>0/${total}</span>
            </div>
            <div class="qz-prog-bar">
                <div class="qz-prog-fill" style="width:0%"></div>
            </div>
        </div>
        <button class="btn-take">
            <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="none"/></svg>
            Take the Quiz
        </button>`;

    div.querySelector('.btn-take').addEventListener('click', (e) => {
        e.stopPropagation();
        openQuizModal(label, questions);
    });

    return div;
}

// ── MODAL ──────────────────────────────────────────────
function openQuizModal(label, questions) {
    currentSession = questions;
    score = 0;
    answered = 0;

    document.getElementById('modalQuizTitle').textContent = label;
    document.getElementById('modalQuizSub').textContent = `${questions.length} Questions`;
    document.getElementById('modalScore').textContent = '';
    document.getElementById('modalProgress').style.width = '0%';

    buildModalBody(questions);

    const modal = document.getElementById('quizModal');
    modal.style.display = 'flex';
}

function closeQuizModal() {
    document.getElementById('quizModal').style.display = 'none';
    document.getElementById('modalBody').innerHTML = '';
}

function retryQuiz() {
    score = 0;
    answered = 0;
    document.getElementById('modalScore').textContent = '';
    document.getElementById('modalProgress').style.width = '0%';
    buildModalBody(currentSession);
}

function buildModalBody(questions) {
    const body = document.getElementById('modalBody');
    body.innerHTML = '';

    const letters = ['A','B','C','D'];

    questions.forEach((q, idx) => {
        const qwrap = document.createElement('div');
        qwrap.style.cssText = 'margin-bottom:24px;';

        const qtext = document.createElement('div');
        qtext.style.cssText = 'font-size:14px;color:#f0eeff;line-height:1.6;margin-bottom:10px;';
        qtext.innerHTML = `<span style="color:#7c5cbf;font-weight:700;">Q${idx+1}.</span> ${escHtml(q.question)}`;
        qwrap.appendChild(qtext);

        const type = q.questionType || 'mcq';

        if (type === 'fillblank') {
            const row = document.createElement('div');
            row.style.cssText = 'display:flex;gap:8px;';
            const inp = document.createElement('input');
            inp.type = 'text';
            inp.placeholder = 'Type your answer…';
            inp.style.cssText = 'flex:1;background:#13101f;border:1px solid rgba(124,92,191,0.25);border-radius:8px;padding:8px 12px;color:#f0eeff;font-size:13px;font-family:inherit;outline:none;';
            const btn = document.createElement('button');
            btn.textContent = 'Check';
            btn.style.cssText = 'background:#7c5cbf;border:none;border-radius:8px;color:#fff;font-size:13px;padding:8px 16px;cursor:pointer;font-family:inherit;';
            const fb = document.createElement('div');
            fb.style.cssText = 'font-size:12px;margin-top:6px;padding:6px 10px;border-radius:6px;display:none;';
            let picked = false;
            btn.onclick = () => {
                if (picked) return;
                picked = true; answered++;
                const ua = inp.value.trim().toLowerCase();
                const ca = (q.answerText || '').toLowerCase();
                const correct = ua === ca || (ca.length > 2 && ca.includes(ua) && ua.length > 2);
                if (correct) {
                    score++;
                    fb.style.cssText += 'display:block;background:#1a2d1a;color:#6dbf6d;';
                    fb.textContent = '✓ Correct!';
                    inp.style.borderColor = '#2d522d';
                } else {
                    fb.style.cssText += 'display:block;background:#2d1a1a;color:#e07070;';
                    fb.textContent = `✗ Answer: ${q.answerText}`;
                    inp.style.borderColor = '#52302d';
                }
                updateModalScore();
            };
            inp.onkeydown = e => { if (e.key === 'Enter') btn.click(); };
            row.appendChild(inp); row.appendChild(btn);
            qwrap.appendChild(row); qwrap.appendChild(fb);

        } else {
            // MCQ or True/False
            const opts = type === 'truefalse'
                ? ['True', 'False']
                : [q.choiceA, q.choiceB, q.choiceC, q.choiceD].filter(Boolean);

            const correctLetter = (q.correctAnswer || '').toUpperCase();
            const correctIndex  = type === 'truefalse'
                ? (correctLetter === 'A' ? 0 : 1)
                : letters.indexOf(correctLetter);

            let picked = false;
            const fb = document.createElement('div');
            fb.style.cssText = 'font-size:12px;margin-top:6px;padding:6px 10px;border-radius:6px;display:none;';

            const optEls = [];
            opts.forEach((opt, oi) => {
                const ob = document.createElement('div');
                ob.style.cssText = 'display:flex;align-items:flex-start;gap:10px;padding:9px 12px;border-radius:8px;margin-bottom:6px;cursor:pointer;border:1px solid rgba(124,92,191,0.15);transition:background .15s,border-color .15s;';
                const letter = type === 'truefalse' ? (oi === 0 ? 'T' : 'F') : letters[oi];
                ob.innerHTML = `<span style="font-size:11px;font-weight:700;color:#7c5cbf;flex-shrink:0;width:16px;">${letter}</span><span style="font-size:13px;color:#ccc;line-height:1.5;">${escHtml(opt)}</span>`;
                ob.onmouseenter = () => { if (!picked) ob.style.background = 'rgba(124,92,191,0.1)'; };
                ob.onmouseleave = () => { if (!picked) ob.style.background = ''; };
                ob.onclick = () => {
                    if (picked) return;
                    picked = true; answered++;
                    if (oi === correctIndex) {
                        score++;
                        ob.style.cssText += 'background:#1a2d1a!important;border-color:#2d522d;cursor:default;';
                        fb.style.cssText += 'display:block;background:#1a2d1a;color:#6dbf6d;';
                        fb.textContent = '✓ Correct!';
                    } else {
                        ob.style.cssText += 'background:#2d1a1a!important;border-color:#52302d;cursor:default;';
                        if (optEls[correctIndex]) optEls[correctIndex].style.cssText += 'background:#1a2d1a!important;border-color:#2d522d;';
                        fb.style.cssText += 'display:block;background:#2d1a1a;color:#e07070;';
                        fb.textContent = `✗ Correct: ${type === 'truefalse' ? (correctIndex === 0 ? 'True' : 'False') : letters[correctIndex]}`;
                    }
                    optEls.forEach(el => el.onclick = null);
                    updateModalScore();
                };
                optEls.push(ob);
                qwrap.appendChild(ob);
            });
            qwrap.appendChild(fb);
        }

        // Divider
        if (idx < questions.length - 1) {
            const hr = document.createElement('hr');
            hr.style.cssText = 'border:none;border-top:1px solid rgba(124,92,191,0.1);margin-top:20px;';
            qwrap.appendChild(hr);
        }

        body.appendChild(qwrap);
    });
}

function updateModalScore() {
    const total = currentSession.length;
    document.getElementById('modalScore').textContent = `${score}/${answered} correct`;
    document.getElementById('modalProgress').style.width = `${(answered / total) * 100}%`;
}

// Close on backdrop click
document.getElementById('quizModal').addEventListener('click', function(e) {
    if (e.target === this) closeQuizModal();
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeQuizModal(); });

function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
</body>
</html>