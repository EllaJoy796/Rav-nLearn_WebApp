@{
    ViewData["Title"] = "RavnLearn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RavnLearn</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:           #141414;
            --left-bg:      #1a1a1a;
            --center-bg:    #141414;
            --right-bg:     #1a1a1a;
            --panel-border: #2a2a2a;
            --input-bg:     #252525;
            --input-border: #333;
            --bubble-user:  #50387a;
            --bubble-ai:    #2d2d2d;
            --text:         #f0f0f0;
            --text-muted:   #888;
            --text-dim:     #555;
            --accent:       #7c5cbf;
            --accent-hover: #6a4eaa;
            --btn-flat:     #2a2a2a;
            --radius:       10px;
        }

        html, body { height: 100%; background: var(--bg); font-family: 'Inter', sans-serif; color: var(--text); overflow: hidden; }

        .app-shell { display: flex; height: 100vh; width: 100vw; }

        /* ── LEFT ── */
        .panel-left {
            width: 220px;
            min-width: 140px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--left-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .left-logo { padding: 16px; font-size: 18px; font-weight: 700; border-bottom: 1px solid var(--panel-border); display: flex; align-items: center; gap: 8px; }
        .btn-new-chat { margin: 14px 12px 8px; padding: 10px 14px; background: var(--accent); color: #fff; border: none; border-radius: var(--radius); font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; display: flex; align-items: center; gap: 7px; transition: background 0.18s; }
        .btn-new-chat:hover { background: var(--accent-hover); }
        .section-label { padding: 10px 16px 6px; font-size: 10px; font-weight: 600; letter-spacing: 1px; color: var(--text-dim); text-transform: uppercase; }
        .chat-list { flex: 1; overflow-y: auto; padding: 4px 8px; }
        .chat-list::-webkit-scrollbar { width: 4px; }
        .chat-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        .chat-item { display: flex; align-items: center; justify-content: space-between; padding: 9px 10px; border-radius: 8px; cursor: pointer; color: var(--text-muted); font-size: 13px; transition: background 0.15s, color 0.15s; gap: 6px; }
        .chat-item:hover { background: #242424; color: var(--text); }
        .chat-item.active { background: rgba(124,92,191,0.18); color: var(--text); }
        .chat-item-title { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .btn-del-chat { opacity: 0; background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 14px; padding: 2px 5px; border-radius: 4px; transition: opacity 0.15s, color 0.15s; flex-shrink: 0; }
        .chat-item:hover .btn-del-chat { opacity: 1; }
        .btn-del-chat:hover { color: #e74c3c; }
        .user-area { border-top: 1px solid var(--panel-border); padding: 12px 14px; display: flex; align-items: center; gap: 10px; }
        .user-avatar { width: 32px; height: 32px; background: var(--accent); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; color: #fff; flex-shrink: 0; }
        .user-name { font-size: 13px; font-weight: 600; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .btn-logout { background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 16px; padding: 4px; border-radius: 4px; transition: color 0.15s; }
        .btn-logout:hover { color: #e74c3c; }

        /* ── HORIZONTAL RESIZE HANDLES (left/right panels) ── */
        .resize-handle {
            width: 5px;
            min-width: 5px;
            cursor: col-resize;
            background: var(--panel-border);
            flex-shrink: 0;
            position: relative;
            z-index: 10;
            transition: background 0.15s;
        }
        .resize-handle:hover,
        .resize-handle.dragging { background: var(--accent); }
        .resize-handle::after {
            content: '';
            position: absolute;
            top: 0; bottom: 0;
            left: -4px; right: -4px;
            cursor: col-resize;
        }
        body.resizing { user-select: none; cursor: col-resize; }

        /* ── CENTER ── */
        .panel-center { flex: 1; background: var(--center-bg); display: flex; flex-direction: column; overflow: hidden; min-width: 200px; }
        .welcome-screen { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; }
        .welcome-screen h1 { font-size: 36px; font-weight: 700; letter-spacing: -1px; margin-bottom: 10px; }
        .welcome-screen p { font-size: 15px; color: var(--text-muted); }
        .messages-area { flex: 1; overflow-y: auto; padding: 24px 32px; display: none; flex-direction: column; gap: 4px; }
        .messages-area.visible { display: flex; }
        .messages-area::-webkit-scrollbar { width: 5px; }
        .messages-area::-webkit-scrollbar-thumb { background: #2e2e2e; border-radius: 4px; }
        .msg-wrapper { display: flex; flex-direction: column; margin: 3px 0; max-width: 72%; }
        .msg-wrapper.user { align-self: flex-end; align-items: flex-end; }
        .msg-wrapper.ai { align-self: flex-start; align-items: flex-start; }
        .bubble { padding: 11px 15px; border-radius: 14px; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .msg-wrapper.user .bubble { background: var(--bubble-user); color: #fff; border-bottom-right-radius: 4px; }
        .msg-wrapper.ai .bubble { background: var(--bubble-ai); color: var(--text); border-bottom-left-radius: 4px; }
        .msg-actions { display: flex; gap: 4px; margin-top: 4px; opacity: 0; transition: opacity 0.15s; }
        .msg-wrapper:hover .msg-actions { opacity: 1; }
        .btn-action { background: none; border: none; color: var(--text-dim); font-size: 11px; cursor: pointer; padding: 3px 7px; border-radius: 4px; font-family: inherit; transition: background 0.15s, color 0.15s; }
        .btn-action:hover { background: #222; color: var(--text-muted); }
        .typing-indicator { display: none; align-self: flex-start; background: var(--bubble-ai); padding: 12px 16px; border-radius: 14px; border-bottom-left-radius: 4px; gap: 5px; }
        .typing-indicator.visible { display: flex; }
        .typing-indicator span { width: 7px; height: 7px; background: var(--text-dim); border-radius: 50%; animation: bounce 1.2s infinite; }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
        .input-bar { padding: 14px 24px 18px; border-top: 1px solid var(--panel-border); background: var(--center-bg); }
        .input-row { display: flex; align-items: center; gap: 10px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: 12px; padding: 10px 14px; transition: border-color 0.2s; }
        .input-row:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124,92,191,0.12); }
        #txtInput { flex: 1; background: none; border: none; outline: none; color: var(--text); font-size: 14px; font-family: inherit; resize: none; max-height: 120px; line-height: 1.5; }
        #txtInput::placeholder { color: var(--text-dim); }
        .btn-send { background: var(--accent); border: none; border-radius: 8px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.18s; }
        .btn-send:hover { background: var(--accent-hover); }
        .btn-send:disabled { background: #333; cursor: not-allowed; }
        .btn-send svg { width: 16px; height: 16px; fill: #fff; }
        .input-hint { text-align: center; font-size: 11px; color: var(--text-dim); margin-top: 8px; }

        /* ── RIGHT PANEL ── */
        .panel-right {
            width: 220px;
            min-width: 140px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--right-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .right-header {
            padding: 16px 14px 10px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-dim);
            border-bottom: 1px solid var(--panel-border);
            flex-shrink: 0;
        }

        /* ── SOURCES SECTION ── */
        .sources-section {
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .right-section { padding: 12px 14px 8px; flex-shrink: 0; }
        .right-section-title { font-size: 10px; font-weight: 600; letter-spacing: 0.8px; text-transform: uppercase; color: var(--text-dim); margin-bottom: 8px; }
        .btn-add-source { width: 100%; padding: 9px 12px; background: var(--btn-flat); border: 1px dashed #3a3a3a; border-radius: var(--radius); color: var(--text-muted); font-size: 12.5px; font-family: inherit; cursor: pointer; display: flex; align-items: center; gap: 7px; transition: background 0.15s, border-color 0.15s, color 0.15s; }
        .btn-add-source:hover { background: #2e2e2e; border-color: var(--accent); color: var(--text); }
        .source-list { flex: 1; overflow-y: auto; padding: 0 10px 8px; }
        .source-list::-webkit-scrollbar { width: 3px; }
        .source-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        .source-item { background: #222; border: 1px solid #2e2e2e; border-radius: 8px; padding: 7px 10px; font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; min-width: 0; margin-bottom: 6px; }
        .source-item-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .source-item-spinner { width: 12px; height: 12px; border: 2px solid #444; border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; flex-shrink: 0; }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .btn-del-source { background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 13px; padding: 1px 4px; border-radius: 3px; flex-shrink: 0; opacity: 0; transition: opacity 0.15s, color 0.15s; line-height: 1; }
        .source-item:hover .btn-del-source { opacity: 1; }
        .btn-del-source:hover { color: #e74c3c; }
        .source-drag-handle { color: var(--text-dim); font-size: 11px; cursor: grab; flex-shrink: 0; opacity: 0; transition: opacity 0.15s; padding: 0 2px; user-select: none; line-height: 1; }
        .source-item:hover .source-drag-handle { opacity: 1; }
        .source-drag-handle:active { cursor: grabbing; }
        .source-item.dragging-source { opacity: 0.4; border: 1px dashed var(--accent); }
        .source-item.drag-over-source { border-color: var(--accent); background: #2a2040; }

        /* ── VERTICAL RESIZE HANDLE (between Sources and Quizzes) ── */
        .resize-handle-vertical {
            height: 6px;
            min-height: 6px;
            cursor: row-resize;
            background: var(--panel-border);
            flex-shrink: 0;
            position: relative;
            z-index: 10;
            transition: background 0.15s;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .resize-handle-vertical:hover,
        .resize-handle-vertical.dragging { background: var(--accent); }
        .resize-handle-vertical::before {
            content: '';
            position: absolute;
            left: 0; right: 0;
            top: -5px; bottom: -5px;
            cursor: row-resize;
        }
        .resize-handle-vertical::after {
            content: '· · ·';
            font-size: 10px;
            letter-spacing: 2px;
            color: var(--text-dim);
            pointer-events: none;
            line-height: 1;
            transition: color 0.15s;
        }
        .resize-handle-vertical:hover::after,
        .resize-handle-vertical.dragging::after { color: #fff; }
        body.resizing-vertical { user-select: none; cursor: row-resize; }

        /* ── QUIZZES SECTION ── */
        .quizzes-section {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex: 1;
        }
        .quiz-section-header {
            padding: 10px 14px 6px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            color: var(--text-dim);
            flex-shrink: 0;
        }
        .quiz-list { flex: 1; overflow-y: auto; padding: 4px 10px 12px; }
        .quiz-list::-webkit-scrollbar { width: 3px; }
        .quiz-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }

        /* ── QUIZ CARDS (new) ── */
        .quiz-card { background: #222; border: 1px solid #2e2e2e; border-radius: 8px; margin-bottom: 6px; overflow: hidden; }
        .quiz-card-header { padding: 9px 12px; cursor: pointer; display: flex; align-items: center; gap: 8px; user-select: none; transition: background .15s; }
        .quiz-card-header:hover { background: #282828; }
        .quiz-card-num { font-size: 10px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase; color: var(--accent); flex-shrink: 0; }
        .quiz-card-title { font-size: 12px; color: #ccc; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .quiz-card-arrow { font-size: 10px; color: #555; flex-shrink: 0; transition: transform .2s; }
        .quiz-card-arrow.open { transform: rotate(90deg); }
        .quiz-card-body { display: none; padding: 0 12px 10px; border-top: 1px solid #2a2a2a; }
        .quiz-card-body.open { display: block; }
        .quiz-q-text { font-size: 12px; color: #ccc; line-height: 1.5; margin: 8px 0 6px; }
        .quiz-opt { display: flex; align-items: flex-start; gap: 7px; padding: 6px 8px; border-radius: 6px; margin-bottom: 4px; cursor: pointer; transition: background .15s; border: 1px solid transparent; }
        .quiz-opt:hover { background: #2a2040; border-color: #3a2d52; }
        .quiz-opt.correct { background: #1a2d1a; border-color: #2d522d; }
        .quiz-opt.wrong { background: #2d1a1a; border-color: #52302d; }
        .quiz-opt-letter { font-size: 11px; font-weight: 700; color: var(--accent); flex-shrink: 0; width: 14px; }
        .quiz-opt-text { font-size: 12px; color: #ccc; line-height: 1.4; }
        .quiz-feedback { font-size: 11px; margin-top: 6px; padding: 5px 8px; border-radius: 5px; display: none; }
        .quiz-feedback.show { display: block; }
        .quiz-feedback.correct { background: #1a2d1a; color: #6dbf6d; }
        .quiz-feedback.wrong { background: #2d1a1a; color: #e07070; }
        .quiz-score { font-size: 10px; color: #555; text-align: right; margin-top: 4px; }

        #fileInput { display: none; }

        #quizModal.open { display: flex !important; }
.btn-modal-open {
    background: none;
    border: 1px solid #3a3a3a;
    border-radius: 5px;
    color: var(--accent);
    font-size: 10px;
    padding: 2px 7px;
    cursor: pointer;
    font-family: inherit;
    transition: background .15s, border-color .15s;
    flex-shrink: 0;
    line-height: 1.6;
}
.btn-modal-open:hover { background: rgba(124,92,191,0.15); border-color: var(--accent); }
    </style>
</head>
<body>

<input type="file" id="fileInput" accept=".pdf,.docx,.txt" multiple />

<div class="app-shell">

    <!-- LEFT -->
    <aside class="panel-left" id="panelLeft">
        <div class="left-logo">
            <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                 alt="Logo" style="width:28px;height:28px;object-fit:contain;"
                 onerror="this.style.display='none'" />
            RavnLearn
        </div>
        <button class="btn-new-chat" id="btnNewChat">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
            </svg>
            New Chat
        </button>
        <div class="section-label">Recents</div>
        <div class="chat-list" id="chatList"></div>
        <div class="user-area">
            <div class="user-avatar">@ViewBag.UserInitial</div>
            <span class="user-name">@ViewBag.Username</span>
            <button class="btn-logout" id="btnLogout" title="Logout">⏻</button>
        </div>
    </aside>

    <!-- LEFT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeLeft"></div>

    <!-- CENTER -->
    <main class="panel-center">
        <div class="welcome-screen" id="welcomeScreen">
            <h1>Ready to Learn?</h1>
            <p>Start a new chat or select one from the left.<br>Upload a document to get AI-powered insights.</p>
        </div>
        <div class="messages-area" id="messagesArea">
            <div class="typing-indicator" id="typingIndicator">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="input-bar">
            <div class="input-row">
                <textarea id="txtInput" rows="1" placeholder="Ask anything…" oninput="autoResize(this)"></textarea>
                <button class="btn-send" id="btnSend" title="Send">
                    <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
                </button>
            </div>
            <div class="input-hint">Enter to send · Shift+Enter for new line</div>
        </div>
    </main>

    <!-- RIGHT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeRight"></div>

    <!-- RIGHT -->
    <aside class="panel-right" id="panelRight">
        <div class="right-header">Study Tools</div>

        <!-- SOURCES SECTION (resizable height) -->
        <div class="sources-section" id="sourcesSection">
            <div class="right-section">
                <div class="right-section-title">📎 Sources</div>
                <button class="btn-add-source" id="btnAddSource"><span>＋</span> Add Document</button>
            </div>
            <div id="sourceList" class="source-list"></div>
        </div>

        <!-- VERTICAL DRAG HANDLE -->
        <div class="resize-handle-vertical" id="resizeVertical"></div>

        <!-- QUIZZES SECTION (takes remaining space) -->
        <div class="quizzes-section" id="quizzesSection">
            <div class="quiz-section-header">🧠 Quizzes</div>
            <div class="quiz-list" id="quizList"></div>
        </div>
    </aside>
</div>
<!-- QUIZ MODAL -->
<div id="quizModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
    <div style="background:#1e1e1e;border:1px solid #333;border-radius:14px;width:min(560px,90vw);max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.5);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #2a2a2a;flex-shrink:0;">
            <span id="modalQuizLabel" style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent)"></span>
            <button onclick="closeQuizModal()" style="background:none;border:none;color:#666;font-size:18px;cursor:pointer;padding:2px 6px;border-radius:4px;line-height:1;" title="Close">✕</button>
        </div>
        <div id="modalQuizBody" style="flex:1;overflow-y:auto;padding:20px;"></div>
    </div>
</div>
<script>
    let activeFolderId = @(ViewBag.FolderId ?? -1); 
    let activeChatId = @(ViewBag.ChatId ?? -1);
    let isSending = false;
    let speakingBtn = null;
    let quizCount = 0;

    function parseBold(text) {
        const escaped = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const bolded = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        const lines = bolded.split('\n');
        const result = lines.map(line => {
            const trimmed = line.trimStart();
            const indent = line.length - trimmed.length;
            if (trimmed.startsWith('* ')) {
                const content = trimmed.slice(2);
                const pad = indent > 0 ? `margin-left:${indent * 8}px` : '';
                return `<div style="display:flex;align-items:baseline;gap:6px;${pad}"><span style="color:var(--accent);flex-shrink:0;">•</span><span>${content}</span></div>`;
            }
            return line;
        });
        return result.join('\n');
    }

    function speakerSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>`;
    }
    function stopSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><rect x="6" y="6" width="12" height="12"/></svg>`;
    }
    function setSpeakActive(btn) { btn.innerHTML = stopSVG() + 'Stop'; btn.style.color = '#e74c3c'; }
    function setSpeakIdle(btn)   { btn.innerHTML = speakerSVG() + 'Speak'; btn.style.color = ''; if (speakingBtn === btn) speakingBtn = null; }

    document.addEventListener('DOMContentLoaded', async () => {
        await loadChatList();
        setupEventListeners();
        setupResizeHandles();
        setupVerticalResize();
        initSourcesSectionHeight();

         // ADD THIS — auto-load if opened from MyChats
        if (activeChatId !== -1) {
            await loadChat(activeChatId);
        }
    });

    function setupEventListeners() {
        document.getElementById('btnNewChat').addEventListener('click', newChat);
        document.getElementById('btnLogout').addEventListener('click', logout);
        document.getElementById('btnSend').addEventListener('click', sendMessage);
        document.getElementById('btnAddSource').addEventListener('click', () => document.getElementById('fileInput').click());
        document.getElementById('fileInput').addEventListener('change', uploadDocument);
        document.getElementById('txtInput').addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    }

    // ══ HORIZONTAL DRAG RESIZE (left/right panels) ════════
    function setupResizeHandles() {
        const panelLeft   = document.getElementById('panelLeft');
        const panelRight  = document.getElementById('panelRight');
        const handleLeft  = document.getElementById('resizeLeft');
        const handleRight = document.getElementById('resizeRight');

        makeResizable(handleLeft, (dx) => {
            const newWidth = panelLeft.offsetWidth + dx;
            panelLeft.style.width = Math.min(Math.max(newWidth, 140), 420) + 'px';
        });

        makeResizable(handleRight, (dx) => {
            const newWidth = panelRight.offsetWidth - dx;
            panelRight.style.width = Math.min(Math.max(newWidth, 140), 420) + 'px';
        });
    }

    function makeResizable(handle, onDrag) {
        let startX = 0, dragging = false;

        handle.addEventListener('mousedown', (e) => {
            e.preventDefault();
            dragging = true;
            startX = e.clientX;
            handle.classList.add('dragging');
            document.body.classList.add('resizing');
        });
        document.addEventListener('mousemove', (e) => {
            if (!dragging) return;
            const dx = e.clientX - startX;
            startX = e.clientX;
            onDrag(dx);
        });
        document.addEventListener('mouseup', () => {
            if (!dragging) return;
            dragging = false;
            handle.classList.remove('dragging');
            document.body.classList.remove('resizing');
        });
        handle.addEventListener('touchstart', (e) => {
            dragging = true; startX = e.touches[0].clientX;
            handle.classList.add('dragging');
        }, { passive: true });
        document.addEventListener('touchmove', (e) => {
            if (!dragging) return;
            const dx = e.touches[0].clientX - startX;
            startX = e.touches[0].clientX;
            onDrag(dx);
        }, { passive: true });
        document.addEventListener('touchend', () => {
            dragging = false;
            handle.classList.remove('dragging');
            document.body.classList.remove('resizing');
        });
    }

    // ══ VERTICAL DRAG RESIZE (sources ↕ quizzes) ══════════
    function initSourcesSectionHeight() {
        const panelRight = document.getElementById('panelRight');
        const header = panelRight.querySelector('.right-header');
        const handle = document.getElementById('resizeVertical');
        const available = panelRight.offsetHeight - header.offsetHeight - handle.offsetHeight;
        document.getElementById('sourcesSection').style.height = Math.round(available * 0.4) + 'px';
    }

    function setupVerticalResize() {
        const handle          = document.getElementById('resizeVertical');
        const sourcesSection  = document.getElementById('sourcesSection');
        const panelRight      = document.getElementById('panelRight');

        let startY = 0, startH = 0, dragging = false;

        const getMinMax = () => {
            const header  = panelRight.querySelector('.right-header');
            const handleH = handle.offsetHeight;
            const totalAvailable = panelRight.offsetHeight - header.offsetHeight - handleH;
            return { min: 60, max: totalAvailable - 60 };
        };

        const startDrag = (y) => {
            dragging = true;
            startY = y;
            startH = sourcesSection.offsetHeight;
            handle.classList.add('dragging');
            document.body.classList.add('resizing-vertical');
        };
        const doDrag = (y) => {
            if (!dragging) return;
            const dy = y - startY;
            const { min, max } = getMinMax();
            const newH = Math.min(Math.max(startH + dy, min), max);
            sourcesSection.style.height = newH + 'px';
        };
        const endDrag = () => {
            if (!dragging) return;
            dragging = false;
            handle.classList.remove('dragging');
            document.body.classList.remove('resizing-vertical');
        };

        handle.addEventListener('mousedown', (e) => { e.preventDefault(); startDrag(e.clientY); });
        document.addEventListener('mousemove', (e) => doDrag(e.clientY));
        document.addEventListener('mouseup', endDrag);

        handle.addEventListener('touchstart', (e) => { startDrag(e.touches[0].clientY); }, { passive: true });
        document.addEventListener('touchmove', (e) => { doDrag(e.touches[0].clientY); }, { passive: true });
        document.addEventListener('touchend', endDrag);
    }

    // ══ CHAT LIST ════════════════════════════════════════
    async function loadChatList() {
        if (activeFolderId === -1) return;
        try {
            const res = await fetch(`/Chat/GetChatsInProject?projectId=${activeFolderId}`);
            const chats = await res.json();
            const list = document.getElementById('chatList');
            list.innerHTML = '';
            chats.forEach(c => list.appendChild(makeChatItem(c.id, c.title)));
            if (activeChatId !== -1) setActiveChatItem(activeChatId);
        } catch (err) { console.error('loadChatList error:', err); }
    }



    function makeChatItem(id, title) {
        const el = document.createElement('div');
        el.className = 'chat-item';
        el.dataset.id = String(id);
        el.innerHTML = `
            <span class="chat-item-title">💬 ${escHtml(title)}</span>
            <button class="btn-del-chat" title="Delete" onclick="deleteChat(event,${id})">✕</button>
        `;
        el.addEventListener('click', () => loadChat(id));
        return el;
    }

    function addChatItemToTop(id, title) {
        const list = document.getElementById('chatList');
        document.querySelector(`.chat-item[data-id="${id}"]`)?.remove();
        list.prepend(makeChatItem(id, title));
    }

    function updateChatItemTitle(id, title) {
        const el = document.querySelector(`.chat-item[data-id="${id}"] .chat-item-title`);
        if (el) el.textContent = '💬 ' + title;
    }

    function setActiveChatItem(id) {
        document.querySelectorAll('.chat-item').forEach(el =>
            el.classList.toggle('active', el.dataset.id === String(id)));
    }

    async function newChat() {
        try {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            addChatItemToTop(data.id, data.title);
            await loadChat(data.id);
        } catch (err) { alert('Error: ' + err.message); }
    }

    async function deleteChat(e, id) {
        e.stopPropagation();
        if (!confirm('Delete this chat?')) return;
        await fetch(`/Chat/DeleteChat/${id}`, { method: 'DELETE' });
        document.querySelector(`.chat-item[data-id="${id}"]`)?.remove();
        if (activeChatId === id) resetUI();
    }


    // ══ LOAD CHAT ════════════════════════════════════════
    async function loadChat(chatId) {
        activeChatId = parseInt(chatId);
        setActiveChatItem(activeChatId);
        showChatUI();
        clearMessages();
        clearQuizList();
        clearSourceList();

        try {
            const res = await fetch(`/Chat/GetMessages?chatId=${activeChatId}`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();

            if (data.docFilenames && Array.isArray(data.docFilenames) && data.docFilenames.length > 0) {
                data.docFilenames.forEach(name => addSourceItem(name, false));
            } else if (data.docFilename) {
                addSourceItem(data.docFilename, false);
            }

            if (!data.messages || data.messages.length === 0) {
                appendBubble('No messages yet. Start the conversation!', 'ai');
            } else {
                data.messages.forEach(m =>
                    appendBubble(m.content, m.role === 'user' ? 'user' : 'ai'));
            }

            scrollToBottom();

        } catch (err) {
            appendBubble('Could not load messages: ' + err.message, 'ai');
        }

        // Quiz loading in its own separate try/catch
        try {
            const qres = await fetch(`/Chat/GetQuizzesByChat?chatId=${activeChatId}`);
            const quizzes = await qres.json();
            if (quizzes.length > 0) {
                const sessionMap = new Map();
                quizzes.forEach(q => {
                    const sid = q.sessionId;
                    if (!sessionMap.has(sid)) sessionMap.set(sid, []);
                    const type = q.questionType || 'mcq';
                    let item;
                    if (type === 'fillblank') {
                        item = {
                            question:    q.question,
                            type:        'fillblank',
                            options:     [],
                            answerIndex: 0,
                            answer:      q.answerText || ''
                        };
                    } else if (type === 'truefalse') {
                        item = {
                            question:    q.question,
                            type:        'truefalse',
                            options:     ['True', 'False'],
                            answerIndex: q.correctAnswer.toUpperCase() === 'A' ? 0 : 1,
                            answer:      ''
                        };
                    } else {
                        item = {
                            question:    q.question,
                            type:        'mcq',
                            options:     [q.choiceA, q.choiceB, q.choiceC, q.choiceD].filter(Boolean),
                            answerIndex: ['A','B','C','D'].indexOf(q.correctAnswer.toUpperCase()),
                            answer:      ''
                        };
                    }
                    sessionMap.get(sid).push(item);
                });

                // I-render bawat session bilang sariling quiz card
                sessionMap.forEach(questions => {
                    addQuizToPanel_structured(questions);
                });
            }
        } catch (err) { console.error('Quiz load error:', err); }
    }
    
    
    // ══ SEND MESSAGE ══════════════════════════════════════
    async function sendMessage() {
        if (isSending) return;
        const input = document.getElementById('txtInput');
        const message = input.value.trim();
        if (!message) return;

        if (activeChatId === -1) {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            activeChatId = parseInt(data.id);
            addChatItemToTop(data.id, data.title);
            setActiveChatItem(activeChatId);
        }

        showChatUI();
        input.value = '';
        input.style.height = 'auto';
        appendBubble(message, 'user');
        showTyping();
        scrollToBottom();

        isSending = true;
        document.getElementById('btnSend').disabled = true;
        const sendingToChatId = activeChatId;

        try {
            const res = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chatId: sendingToChatId, message })
            });
            const data = await res.json();
            hideTyping();

            if (data.error) {
                appendBubble('Error: ' + data.error, 'ai');
            } else {
                if (data.newTitle) updateChatItemTitle(sendingToChatId, data.newTitle);
                appendBubble(data.reply, 'ai');

                // Detect quiz in response and add to panel
                const replyLower = data.reply?.toLowerCase() || '';
                const hasQuizContent = replyLower.match(/\b(q1[).:\s]|question\s*1[).:\s]|\b1[).]\s)/i)
                    && data.reply.includes('\n')
                    && !replyLower.includes('i am sorry')
                    && !replyLower.includes('i cannot')
                    && !replyLower.includes('i\'m sorry')
                    && !replyLower.includes('unable to')
                    && !replyLower.includes('appears to be empty')
                    && !replyLower.includes('no content');

                if (hasQuizContent) {
                    addQuizToPanel(data.reply);
                }
            }
        } catch (err) {
            hideTyping();
            appendBubble('Network error: ' + err.message, 'ai');
        }

        isSending = false;
        document.getElementById('btnSend').disabled = false;
        scrollToBottom();
    }

    // ══ MESSAGES ══════════════════════════════════════════
    function appendBubble(text, role) {
        const area = document.getElementById('messagesArea');
        const typing = document.getElementById('typingIndicator');

        const wrapper = document.createElement('div');
        wrapper.className = `msg-wrapper ${role}`;

        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.innerHTML = (role === 'ai' ? '🤖  ' : '') + parseBold(text);

        const actions = document.createElement('div');
        actions.className = 'msg-actions';

        const btnCopy = document.createElement('button');
        btnCopy.className = 'btn-action';
        btnCopy.textContent = '⧉ Copy';
        btnCopy.onclick = () => {
            navigator.clipboard.writeText(text);
            btnCopy.textContent = '✓ Copied';
            btnCopy.style.color = '#6dbf6d';
            setTimeout(() => { btnCopy.textContent = '⧉ Copy'; btnCopy.style.color = ''; }, 2000);
        };

        const btnSpeak = document.createElement('button');
        btnSpeak.className = 'btn-action';
        setSpeakIdle(btnSpeak);
        btnSpeak.onclick = () => {
            if (speechSynthesis.speaking && speakingBtn === btnSpeak) {
                speechSynthesis.cancel();
                setSpeakIdle(btnSpeak);
            } else {
                if (speechSynthesis.speaking) { speechSynthesis.cancel(); if (speakingBtn) setSpeakIdle(speakingBtn); }
                const utter = new SpeechSynthesisUtterance(text);
                utter.onend = () => setSpeakIdle(btnSpeak);
                utter.onerror = () => setSpeakIdle(btnSpeak);
                speakingBtn = btnSpeak;
                setSpeakActive(btnSpeak);
                speechSynthesis.speak(utter);
            }
        };

        actions.appendChild(btnCopy);
        actions.appendChild(btnSpeak);
        wrapper.appendChild(bubble);
        wrapper.appendChild(actions);
        area.insertBefore(wrapper, typing);
    }

    function clearMessages() {
        const area = document.getElementById('messagesArea');
        const typing = document.getElementById('typingIndicator');
        [...area.children].forEach(c => { if (c !== typing) c.remove(); });
    }

    function showTyping() { document.getElementById('typingIndicator').classList.add('visible'); }
    function hideTyping() { document.getElementById('typingIndicator').classList.remove('visible'); }
    function scrollToBottom() { const a = document.getElementById('messagesArea'); a.scrollTop = a.scrollHeight; }

    // ══ UPLOAD ════════════════════════════════════════════
    async function uploadDocument(e) {
        const files = Array.from(e.target.files);
        if (!files.length) return;

        if (activeChatId === -1) {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            activeChatId = parseInt(data.id);
            addChatItemToTop(data.id, data.title);
            setActiveChatItem(activeChatId);
        }

        showChatUI();

        for (const file of files) {
            const itemEl = addSourceItem(file.name, true);
            const fd = new FormData();
            fd.append('file', file);
            fd.append('chatId', activeChatId);

            try {
                const res = await fetch('/Chat/UploadDocument', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.error) {
                    removeSourceItem(itemEl);
                    alert('Upload failed: ' + data.error);
                } else {
                    finalizeSourceItem(itemEl, data.fileName);
                    appendBubble(data.welcome, 'ai');
                    scrollToBottom();
                }
            } catch (err) {
                removeSourceItem(itemEl);
                alert('Upload error: ' + err.message);
            }
        }

        e.target.value = '';
    }
    // ── Source list helpers ───────────────────────────────
    let dragSrcEl = null;

    function addSourceItem(name, uploading = false) {
        const list = document.getElementById('sourceList');
        const item = document.createElement('div');
        item.className = 'source-item' + (uploading ? ' source-item-uploading' : '');

        const handle = document.createElement('span');
        handle.className = 'source-drag-handle';
        handle.textContent = '⠿';
        handle.title = 'Drag to reorder';

        const icon = document.createElement('span');
        icon.textContent = '📄';

        const nameEl = document.createElement('span');
        nameEl.className = 'source-item-name';
        nameEl.title = name;
        nameEl.textContent = name;

        item.appendChild(handle);
        item.appendChild(icon);
        item.appendChild(nameEl);

        if (uploading) {
            const spinner = document.createElement('div');
            spinner.className = 'source-item-spinner';
            item.appendChild(spinner);
        } else {
            const delBtn = document.createElement('button');
            delBtn.className = 'btn-del-source';
            delBtn.title = 'Remove';
            delBtn.textContent = '✕';
            delBtn.onclick = () => item.remove();
            item.appendChild(delBtn);
            makeDraggable(item, handle);
        }

        list.appendChild(item);
        return item;
    }

    function makeDraggable(item, handle) {
        item.draggable = false;

        handle.addEventListener('mousedown', () => { item.draggable = true; });
        handle.addEventListener('mouseup',   () => { item.draggable = false; });

        item.addEventListener('dragstart', (e) => {
            dragSrcEl = item;
            item.classList.add('dragging-source');
            e.dataTransfer.effectAllowed = 'move';
        });
        item.addEventListener('dragend', () => {
            item.draggable = false;
            item.classList.remove('dragging-source');
            document.querySelectorAll('.source-item').forEach(el => el.classList.remove('drag-over-source'));
            dragSrcEl = null;
        });
        item.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            if (dragSrcEl && dragSrcEl !== item) {
                document.querySelectorAll('.source-item').forEach(el => el.classList.remove('drag-over-source'));
                item.classList.add('drag-over-source');
            }
        });
        item.addEventListener('dragleave', () => item.classList.remove('drag-over-source'));
        item.addEventListener('drop', (e) => {
            e.preventDefault();
            item.classList.remove('drag-over-source');
            if (!dragSrcEl || dragSrcEl === item) return;
            const list = document.getElementById('sourceList');
            const items = [...list.children];
            const srcIdx = items.indexOf(dragSrcEl);
            const dstIdx = items.indexOf(item);
            if (srcIdx < dstIdx) list.insertBefore(dragSrcEl, item.nextSibling);
            else list.insertBefore(dragSrcEl, item);
        });
    }

    function finalizeSourceItem(item, fileName) {
        item.classList.remove('source-item-uploading');
        const spinner = item.querySelector('.source-item-spinner');
        if (spinner) spinner.remove();
        const nameEl = item.querySelector('.source-item-name');
        if (nameEl && fileName) { nameEl.textContent = fileName; nameEl.title = fileName; }
        const delBtn = document.createElement('button');
        delBtn.className = 'btn-del-source';
        delBtn.title = 'Remove';
        delBtn.textContent = '✕';
        delBtn.onclick = () => item.remove();
        item.appendChild(delBtn);
        const handle = item.querySelector('.source-drag-handle');
        if (handle) makeDraggable(item, handle);
    }

    function removeSourceItem(item) { item?.remove(); }

    // ══ QUIZ PANEL ════════════════════════════════════════
function addQuizToPanel(text, save = true) {
    quizCount++;
    const parsed = parseQuizFromText(text);
    const label = `Quiz ${String(quizCount).padStart(2, '0')}`;
    const title = parsed.questions[0]?.question?.slice(0, 50) || parsed.title || label;
    const list = document.getElementById('quizList');

    const card = document.createElement('div');
    card.className = 'quiz-card';

    const header = document.createElement('div');
    header.className = 'quiz-card-header';
    const arrow = document.createElement('span');
    arrow.className = 'quiz-card-arrow';
    arrow.textContent = '▶';
    header.innerHTML = `<span class="quiz-card-num">${escHtml(label)}</span><span class="quiz-card-title">${escHtml(title)}</span>`;
    const btnModal = document.createElement('button');
    btnModal.className = 'btn-modal-open';
    btnModal.textContent = '⛶ Full';
    btnModal.title = 'Open in full view';
    btnModal.addEventListener('click', (e) => {
        e.stopPropagation(); 
        openQuizModal(label, parsed, card);
    });
    // After btnModal definition, add this:
    const btnFlashcard = document.createElement('button');
    btnFlashcard.className = 'btn-modal-open';
    btnFlashcard.textContent = '🃏 Cards';
    btnFlashcard.title = 'View as flashcards';
    btnFlashcard.addEventListener('click', (e) => {
        e.stopPropagation();
        openFlashcardModal(label, parsed.questions);
    });
    header.appendChild(btnModal);
    header.appendChild(btnFlashcard);
    header.appendChild(arrow);

    // ── buildBody is defined HERE, inside addQuizToPanel ──
    // so it has access to: parsed, card, and the `body` variable below
    function buildBody() {
        const b = document.createElement('div');
        b.className = 'quiz-card-body';

        if (parsed.questions.length === 0) {
            const raw = document.createElement('div');
            raw.style.cssText = 'font-size:12px;color:#888;padding:8px 0;';
            raw.textContent = 'Could not parse quiz questions.';
            b.appendChild(raw);
            return b;
        }

        let score = 0, answered = 0;
        const scoreEl = document.createElement('div');
        scoreEl.className = 'quiz-score';

        parsed.questions.forEach((q, idx) => {
            const qwrap = document.createElement('div');
            qwrap.style.marginBottom = '12px';

            const qtext = document.createElement('div');
            qtext.className = 'quiz-q-text';
            qtext.innerHTML = `<strong style="color:var(--accent)">Q${idx + 1}.</strong> ${escHtml(q.question)}`;
            qwrap.appendChild(qtext);

            if (q.type === 'mcq' || q.type === 'truefalse') {
                const letters = ['A','B','C','D','E'];
                let picked = false;
                q.options.forEach((opt, oi) => {
                    const ob = document.createElement('div');
                    ob.className = 'quiz-opt';
                    const letter = q.type === 'truefalse' ? (oi === 0 ? 'T' : 'F') : letters[oi];
                    ob.innerHTML = `<span class="quiz-opt-letter">${letter}</span><span class="quiz-opt-text">${escHtml(opt)}</span>`;
                    ob.addEventListener('click', () => {
                        if (picked) return;
                        picked = true; answered++;
                        const fb = qwrap.querySelector('.quiz-feedback');
                        if (oi === q.answerIndex) {
                            score++;
                            ob.classList.add('correct');
                            fb.className = 'quiz-feedback show correct';
                            fb.textContent = '✓ Correct!';
                        } else {
                            ob.classList.add('wrong');
                            const allOpts = qwrap.querySelectorAll('.quiz-opt');
                            if (allOpts[q.answerIndex]) allOpts[q.answerIndex].classList.add('correct');
                            fb.className = 'quiz-feedback show wrong';
                            fb.textContent = `✗ Correct: ${q.type === 'truefalse' ? (q.answerIndex === 0 ? 'True' : 'False') : letters[q.answerIndex]}`;
                        }
                        scoreEl.textContent = `${score}/${answered} correct`;
                    });
                    qwrap.appendChild(ob);
                });
                const fb = document.createElement('div');
                fb.className = 'quiz-feedback';
                qwrap.appendChild(fb);

            } else if (q.type === 'fillblank') {
                const inputRow = document.createElement('div');
                inputRow.style.cssText = 'display:flex;gap:6px;margin-top:4px;';
                const inp = document.createElement('input');
                inp.type = 'text';
                inp.placeholder = 'Type your answer…';
                inp.style.cssText = 'flex:1;background:#1e1e1e;border:1px solid #333;border-radius:6px;padding:5px 8px;color:#ccc;font-size:12px;font-family:inherit;outline:none;';
                const submitBtn = document.createElement('button');
                submitBtn.textContent = 'Check';
                submitBtn.style.cssText = 'background:var(--accent);border:none;border-radius:6px;color:#fff;font-size:11px;padding:5px 10px;cursor:pointer;font-family:inherit;';
                const fb = document.createElement('div');
                fb.className = 'quiz-feedback';
                let picked = false;
                submitBtn.addEventListener('click', () => {
                    if (picked) return;
                    const userAnswer = inp.value.trim().toLowerCase();
                    const correct = q.answer.toLowerCase();
                    if (userAnswer === correct || correct.includes(userAnswer) && userAnswer.length > 2) {
                        picked = true; answered++; score++;
                        fb.className = 'quiz-feedback show correct';
                        fb.textContent = '✓ Correct!';
                        inp.style.borderColor = '#2d522d';
                    } else {
                        picked = true; answered++;
                        fb.className = 'quiz-feedback show wrong';
                        fb.textContent = `✗ Answer: ${q.answer}`;
                        inp.style.borderColor = '#52302d';
                    }
                    scoreEl.textContent = `${score}/${answered} correct`;
                });
                inp.addEventListener('keydown', e => { if (e.key === 'Enter') submitBtn.click(); });
                inputRow.appendChild(inp);
                inputRow.appendChild(submitBtn);
                qwrap.appendChild(inputRow);
                qwrap.appendChild(fb);
            }
            b.appendChild(qwrap);
        });

        const retryRow = document.createElement('div');
        retryRow.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;';
        retryRow.appendChild(scoreEl);

        const btnRetry = document.createElement('button');
        btnRetry.textContent = '↺ Retry';
        btnRetry.style.cssText = 'background:none;border:1px solid #3a3a3a;border-radius:6px;color:var(--accent);font-size:11px;padding:4px 10px;cursor:pointer;font-family:inherit;transition:background .15s,border-color .15s;flex-shrink:0;';
        btnRetry.onmouseenter = () => { btnRetry.style.background = 'rgba(124,92,191,0.12)'; btnRetry.style.borderColor = 'var(--accent)'; };
        btnRetry.onmouseleave = () => { btnRetry.style.background = 'none'; btnRetry.style.borderColor = '#3a3a3a'; };
        btnRetry.addEventListener('click', () => {
            const wasOpen = body.classList.contains('open');
            const fresh = buildBody();
            if (wasOpen) fresh.classList.add('open');
            card.replaceChild(fresh, body);
            body = fresh;
        });

        retryRow.appendChild(btnRetry);
        b.appendChild(retryRow);
        return b;
    }
    // ── end buildBody ──

    let body = buildBody(); // ← must be `let`, not `const`, so retry can reassign it

    header.addEventListener('click', () => {
        body.classList.toggle('open');
        arrow.classList.toggle('open');
        arrow.textContent = body.classList.contains('open') ? '▼' : '▶';
    });

    card.appendChild(header);
    card.appendChild(body);
    list.appendChild(card);

    if (save && activeChatId > 0) {
    const questions = parsed.questions.map(q => {
        if (q.type === 'fillblank') {
            return {
                question:      q.question,
                questionType:  'fillblank',
                choiceA: '', choiceB: '', choiceC: '', choiceD: '',
                correctAnswer: '',
                answerText:    q.answer
            };
        } else if (q.type === 'truefalse') {
            return {
                question:      q.question,
                questionType:  'truefalse',
                choiceA: 'True', choiceB: 'False', choiceC: '', choiceD: '',
                correctAnswer: q.answerIndex === 0 ? 'A' : 'B',
                answerText:    ''
            };
        } else {
            return {
                question:      q.question,
                questionType:  'mcq',
                choiceA:       q.options[0] || '',
                choiceB:       q.options[1] || '',
                choiceC:       q.options[2] || '',
                choiceD:       q.options[3] || '',
                correctAnswer: ['A','B','C','D'][q.answerIndex] || 'A',
                answerText:    ''
            };
        }
    });
    if (questions.length > 0) {
        fetch('/Chat/SaveQuizQuestions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ chatId: activeChatId, questions })
        }).catch(err => console.error('Quiz save error:', err));
    }
}
