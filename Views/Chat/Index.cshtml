    function buildQuizBody(parsed, card) {
        let body = document.createElement('div');
        body.className = 'quiz-card-body';
        if (parsed.questions.length === 0) {
            const raw = document.createElement('div');
            raw.style.cssText = 'font-size:12px;color:#888;padding:8px 0;';
            raw.textContent = 'Could not parse quiz questions.';
            body.appendChild(raw); return body;
        }
        let score = 0, answered = 0;
        const scoreEl = document.createElement('div');
        scoreEl.className = 'quiz-score';
        parsed.questions.forEach((q, idx) => {
            const qwrap = document.createElement('div');
            qwrap.style.marginBottom = '12px';
            const qtext = document.createElement('div');
            qtext.className = 'quiz-q-text';
            qtext.innerHTML = `<strong style="color:var(--accent)">Q${idx + 1}.</strong> ${escHtml(q.question)}`;
            qwrap.appendChild(qtext);
            if (q.type === 'mcq' || q.type === 'truefalse') {
                const letters = ['A','B','C','D','E'];
                let picked = false;
                q.options.forEach((opt, oi) => {
                    const ob = document.createElement('div');
                    ob.className = 'quiz-opt';
                    const letter = q.type === 'truefalse' ? (oi === 0 ? 'T' : 'F') : letters[oi];
                    ob.innerHTML = `<span class="quiz-opt-letter">${letter}</span><span class="quiz-opt-text">${escHtml(opt)}</span>`;
                    ob.addEventListener('click', () => {
                        if (picked) return;
                        picked = true; answered++;
                        const fb = qwrap.querySelector('.quiz-feedback');
                        if (oi === q.answerIndex) { score++; ob.classList.add('correct'); fb.className = 'quiz-feedback show correct'; fb.textContent = '✓ Correct!'; }
                        else { ob.classList.add('wrong'); const allOpts = qwrap.querySelectorAll('.quiz-opt'); if (allOpts[q.answerIndex]) allOpts[q.answerIndex].classList.add('correct'); fb.className = 'quiz-feedback show wrong'; fb.textContent = `✗ Correct: ${q.type === 'truefalse' ? (q.answerIndex === 0 ? 'True' : 'False') : letters[q.answerIndex]}`; }
                        scoreEl.textContent = `${score}/${answered} correct`;
                    });
                    qwrap.appendChild(ob);
                });
                const fb = document.createElement('div'); fb.className = 'quiz-feedback'; qwrap.appendChild(fb);
            } else if (q.type === 'fillblank') {
                const inputRow = document.createElement('div');
                inputRow.style.cssText = 'display:flex;gap:6px;margin-top:4px;';
                const inp = document.createElement('input');
                inp.type = 'text'; inp.placeholder = 'Type your answer…';
                inp.style.cssText = 'flex:1;background:#1e1e1e;border:1px solid #333;border-radius:6px;padding:5px 8px;color:#ccc;font-size:12px;font-family:inherit;outline:none;';
                const submitBtn = document.createElement('button');
                submitBtn.textContent = 'Check';
                submitBtn.style.cssText = 'background:var(--accent);border:none;border-radius:6px;color:#fff;font-size:11px;padding:5px 10px;cursor:pointer;font-family:inherit;';
                const fb = document.createElement('div'); fb.className = 'quiz-feedback';
                let picked = false;
                submitBtn.addEventListener('click', () => {
                    if (picked) return;
                    const userAnswer = inp.value.trim().toLowerCase();
                    const correct = q.answer.toLowerCase();
                    if (userAnswer === correct || (correct.includes(userAnswer) && userAnswer.length > 2)) { picked = true; answered++; score++; fb.className = 'quiz-feedback show correct'; fb.textContent = '✓ Correct!'; inp.style.borderColor = '#2d522d'; }
                    else { picked = true; answered++; fb.className = 'quiz-feedback show wrong'; fb.textContent = `✗ Answer: ${q.answer}`; inp.style.borderColor = '#52302d'; }
                    scoreEl.textContent = `${score}/${answered} correct`;
                });
                inp.addEventListener('keydown', e => { if (e.key === 'Enter') submitBtn.click(); });
                inputRow.appendChild(inp); inputRow.appendChild(submitBtn);
                qwrap.appendChild(inputRow); qwrap.appendChild(fb);
            }
            body.appendChild(qwrap);
        });
        const retryRow = document.createElement('div');
        retryRow.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;';
        retryRow.appendChild(scoreEl);
        const btnRetry = document.createElement('button');
        btnRetry.textContent = '↺ Retry';
        btnRetry.style.cssText = 'background:none;border:1px solid #3a3a3a;border-radius:6px;color:var(--accent);font-size:11px;padding:4px 10px;cursor:pointer;font-family:inherit;transition:background .15s,border-color .15s;flex-shrink:0;';
        btnRetry.onmouseenter = () => { btnRetry.style.background = 'rgba(124,92,191,0.12)'; btnRetry.style.borderColor = 'var(--accent)'; };
        btnRetry.onmouseleave = () => { btnRetry.style.background = 'none'; btnRetry.style.borderColor = '#3a3a3a'; };
        btnRetry.addEventListener('click', () => {
            const wasOpen = body.classList.contains('open');
            const fresh = buildQuizBody(parsed, card);
            if (wasOpen) fresh.classList.add('open');
            card.replaceChild(fresh, body); body = fresh;
        });
        retryRow.appendChild(btnRetry);
        body.appendChild(retryRow);
        return body;
    }

    function openFlashcardModal(label, questions) {
        const flashcards = questions.map(q => {
            const letters = ['A','B','C','D','E'];
            let back = '';
            if (q.type === 'mcq' || q.type === 'truefalse') {
                const letter = q.type === 'truefalse' ? (q.answerIndex === 0 ? 'True' : 'False') : letters[q.answerIndex];
                back = `${letter}) ${q.options[q.answerIndex] || ''}`;
            } else { back = q.answer; }
            return { front: q.question, back };
        });
        document.getElementById('modalQuizLabel').textContent = label + ' — Flashcards';
        const body = document.getElementById('modalQuizBody');
        body.innerHTML = '';
        const fc = buildFlashcardBody({ flashcards }, null);
        fc.classList.add('open');
        fc.style.cssText = 'display:block;padding:0;border:none;';
        body.appendChild(fc);
        document.getElementById('quizModal').classList.add('open');
    }

    function parseFlashcardsFromText(text) {
        const cards = [];
        const clean = text.replace(/\*\*(.*?)\*\*/g, '$1').replace(/\*(.*?)\*/g, '$1').replace(/^#+\s*/gm, '').replace(/^---+$/gm, '');
        const lines = clean.split('\n').map(l => l.trim()).filter(Boolean);
        let i = 0;
        while (i < lines.length) {
            const line = lines[i];
            const qMatch = line.match(/^(?:\d+[).:\s]+)?(?:Q|Question|Front|Term)[).:]\s*(.+)/i);
            if (qMatch) {
                const front = qMatch[1].trim(); let back = '';
                for (let j = i + 1; j < Math.min(i + 4, lines.length); j++) {
                    const aMatch = lines[j].match(/^(?:A|Answer|Back|Definition)[).:]\s*(.+)/i);
                    if (aMatch) { back = aMatch[1].trim(); i = j; break; }
                }
                if (front && back) cards.push({ front, back });
                i++; continue;
            }
            const dashMatch = line.match(/^(?:\d+[).:\s]+)?(.+?)\s*[—–:]\s{1,4}(.{10,})/);
            if (dashMatch && !line.match(/^(?:Q|A|Front|Back|Term|Definition|Answer|Question)[).:]/i)) {
                cards.push({ front: dashMatch[1].trim(), back: dashMatch[2].trim() });
                i++; continue;
            }
            i++;
        }
        return cards;
    }

    function buildFlashcardBody(parsed, card) {
        const body = document.createElement('div');
        body.className = 'quiz-card-body';
        const cards = typeof parsed === 'string' ? parseFlashcardsFromText(parsed) : (parsed.flashcards || []);
        if (cards.length === 0) {
            const empty = document.createElement('div');
            empty.style.cssText = 'font-size:12px;color:#888;padding:8px 0;';
            empty.textContent = 'Could not parse flashcards.';
            body.appendChild(empty); return body;
        }
        let current = 0, flipped = false, known = 0, unknown = 0;
        const cardWrap = document.createElement('div');
        cardWrap.style.cssText = 'perspective:800px;margin:8px 0 10px;cursor:pointer;';
        const cardInner = document.createElement('div');
        cardInner.style.cssText = 'position:relative;width:100%;min-height:90px;transform-style:preserve-3d;transition:transform 0.45s cubic-bezier(.4,0,.2,1);border-radius:10px;';
        const makeFace = (side) => {
            const face = document.createElement('div');
            face.style.cssText = `position:${side==='back'?'absolute':'relative'};inset:0;background:${side==='front'?'#252535':'#1e2d1e'};border:1px solid ${side==='front'?'#3a3a52':'#2d522d'};border-radius:10px;padding:12px;backface-visibility:hidden;-webkit-backface-visibility:hidden;display:flex;flex-direction:column;gap:4px;${side==='back'?'transform:rotateY(180deg);':''}`;
            const label = document.createElement('div');
            label.style.cssText = `font-size:9px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:${side==='front'?'var(--accent)':'#6dbf6d'};margin-bottom:4px;`;
            label.textContent = side === 'front' ? '▸ FRONT' : '▸ BACK';
            const text = document.createElement('div');
            text.style.cssText = 'font-size:12.5px;color:#ddd;line-height:1.5;';
            face.appendChild(label); face.appendChild(text);
            return { face, text };
        };
        const { face: frontFace, text: frontText } = makeFace('front');
        const { face: backFace,  text: backText  } = makeFace('back');
        cardInner.appendChild(frontFace); cardInner.appendChild(backFace);
        cardWrap.appendChild(cardInner);
        cardWrap.addEventListener('click', () => { flipped = !flipped; cardInner.style.transform = flipped ? 'rotateY(180deg)' : ''; });
        const counter = document.createElement('div');
        counter.style.cssText = 'font-size:10px;color:#555;text-align:center;margin-bottom:6px;';
        const progressWrap = document.createElement('div');
        progressWrap.style.cssText = 'height:3px;background:#2a2a2a;border-radius:2px;margin-bottom:10px;overflow:hidden;';
        const progressBar = document.createElement('div');
        progressBar.style.cssText = 'height:100%;background:var(--accent);border-radius:2px;transition:width 0.3s;';
        progressWrap.appendChild(progressBar);
        const navRow = document.createElement('div'); navRow.style.cssText = 'display:flex;gap:6px;margin-bottom:8px;';
        const btnPrev = document.createElement('button'); btnPrev.textContent = '← Prev'; btnPrev.style.cssText = 'flex:1;background:none;border:1px solid #3a3a3a;border-radius:6px;color:#888;font-size:11px;padding:5px 0;cursor:pointer;font-family:inherit;';
        const btnFlip = document.createElement('button'); btnFlip.textContent = '↺ Flip'; btnFlip.style.cssText = 'flex:1;background:rgba(124,92,191,0.15);border:1px solid var(--accent);border-radius:6px;color:var(--accent);font-size:11px;padding:5px 0;cursor:pointer;font-family:inherit;';
        const btnNext = document.createElement('button'); btnNext.textContent = 'Next →'; btnNext.style.cssText = 'flex:1;background:none;border:1px solid #3a3a3a;border-radius:6px;color:#888;font-size:11px;padding:5px 0;cursor:pointer;font-family:inherit;';
        const knowRow = document.createElement('div'); knowRow.style.cssText = 'display:flex;gap:6px;margin-bottom:6px;';
        const btnKnow = document.createElement('button'); btnKnow.textContent = '✓ Know it'; btnKnow.style.cssText = 'flex:1;background:#1a2d1a;border:1px solid #2d522d;border-radius:6px;color:#6dbf6d;font-size:11px;padding:5px 0;cursor:pointer;font-family:inherit;';
        const btnDontKnow = document.createElement('button'); btnDontKnow.textContent = '✗ Still learning'; btnDontKnow.style.cssText = 'flex:1;background:#2d1a1a;border:1px solid #52302d;border-radius:6px;color:#e07070;font-size:11px;padding:5px 0;cursor:pointer;font-family:inherit;';
        const scoreRow = document.createElement('div'); scoreRow.style.cssText = 'display:flex;justify-content:space-between;font-size:10px;color:#555;margin-top:2px;';
        const knownEl = document.createElement('span'); const unknownEl = document.createElement('span');
        knownEl.style.color = '#6dbf6d'; unknownEl.style.color = '#e07070';
        scoreRow.appendChild(knownEl); scoreRow.appendChild(unknownEl);
        function renderCard() {
            const c = cards[current]; flipped = false; cardInner.style.transform = '';
            frontText.textContent = c.front; backText.textContent = c.back;
            counter.textContent = `${current + 1} / ${cards.length}`;
            progressBar.style.width = `${((current + 1) / cards.length) * 100}%`;
            btnPrev.disabled = current === 0; btnPrev.style.opacity = current === 0 ? '0.3' : '1';
            btnNext.disabled = current === cards.length - 1; btnNext.style.opacity = current === cards.length - 1 ? '0.3' : '1';
            knownEl.textContent = known ? `✓ ${known} known` : '';
            unknownEl.textContent = unknown ? `✗ ${unknown} learning` : '';
        }
        btnFlip.addEventListener('click', () => { flipped = !flipped; cardInner.style.transform = flipped ? 'rotateY(180deg)' : ''; });
        btnPrev.addEventListener('click', () => { if (current > 0) { current--; renderCard(); } });
        btnNext.addEventListener('click', () => { if (current < cards.length - 1) { current++; renderCard(); } });
        btnKnow.addEventListener('click', () => { known++; if (current < cards.length - 1) { current++; } renderCard(); });
        btnDontKnow.addEventListener('click', () => { unknown++; if (current < cards.length - 1) { current++; } renderCard(); });
        const keyHandler = (e) => {
            if (!body.closest('body')) { document.removeEventListener('keydown', keyHandler); return; }
            if (e.key === 'ArrowRight' && current < cards.length - 1) { current++; renderCard(); }
            if (e.key === 'ArrowLeft'  && current > 0) { current--; renderCard(); }
            if (e.key === ' ') { e.preventDefault(); btnFlip.click(); }
        };
        document.addEventListener('keydown', keyHandler);
        navRow.appendChild(btnPrev); navRow.appendChild(btnFlip); navRow.appendChild(btnNext);
        knowRow.appendChild(btnKnow); knowRow.appendChild(btnDontKnow);
        body.appendChild(counter); body.appendChild(progressWrap); body.appendChild(cardWrap);
        body.appendChild(navRow); body.appendChild(knowRow); body.appendChild(scoreRow);
        renderCard();
        return body;
    }

    function makeVerticalResizable(handle) {
    const chatList = document.getElementById('chatList');
    const docsSection = document.querySelector('.docs-section');
    let startY = 0, startChatH = 0, dragging = false;

    handle.addEventListener('mousedown', (e) => {
        e.preventDefault();
        dragging = true;
        startY = e.clientY;
        startChatH = chatList.offsetHeight;
        handle.classList.add('dragging');
        document.body.classList.add('resizing-vertical');
    });
    document.addEventListener('mousemove', (e) => {
        if (!dragging) return;
        const dy = e.clientY - startY;
        const newH = Math.min(Math.max(startChatH + dy, 60), window.innerHeight * 0.6);
        chatList.style.height = newH + 'px';
        chatList.style.maxHeight = 'none';
        chatList.style.flex = 'none';
    });
    document.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        handle.classList.remove('dragging');
       document.body.classList.remove('resizing-vertical');
    });

    handle.addEventListener('touchstart', (e) => {
        dragging = true;
        startY = e.touches[0].clientY;
        startChatH = chatList.offsetHeight;
        handle.classList.add('dragging');
    }, { passive: true });
    document.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const dy = e.touches[0].clientY - startY;
        const newH = Math.min(Math.max(startChatH + dy, 60), window.innerHeight * 0.6);
        chatList.style.maxHeight = newH + 'px';
        chatList.style.flex = 'none';
    }, { passive: true });
    document.addEventListener('touchend', () => {
        dragging = false;
        handle.classList.remove('dragging');
    });
}


(function () {
    const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
    const btnMic        = document.getElementById('btnMic');
    const txtInput      = document.getElementById('txtInput');
    const statusBar     = document.getElementById('voiceStatusBar');
    const statusText    = document.getElementById('voiceStatusText');
    const countdownEl   = document.getElementById('voiceCountdown');
    const cancelBtn     = document.getElementById('voiceCancelBtn');
    const inputHint     = document.getElementById('inputHint');

    if (!SpeechRecognition) { if (btnMic) btnMic.style.display = 'none'; return; }

    let recognition = null, isRecording = false;
    let countdownInterval = null, silenceSeconds = 0;
    const SILENCE_LIMIT = 5;

    function buildRecognition() {
        const r = new SpeechRecognition();
        r.continuous = true; r.interimResults = true; r.lang = 'en-US';
        let finalTranscript = '';

        r.onstart = () => {
            finalTranscript = txtInput.value.trim();
            statusBar.classList.add('visible');
            inputHint.style.display = 'none';
            setListeningState();
        };
        r.onresult = (e) => {
            let interim = '';
            for (let i = e.resultIndex; i < e.results.length; i++) {
                const t = e.results[i][0].transcript;
                if (e.results[i].isFinal) finalTranscript += (finalTranscript ? ' ' : '') + t.trim();
                else interim = t;
            }
            txtInput.value = finalTranscript + (interim ? ' ' + interim : '');
            autoResize(txtInput);
            resetSilenceTimer();
        };
        r.onspeechend = () => startSilenceTimer();
        r.onsoundend  = () => startSilenceTimer();
        r.onerror = (e) => {
            if (e.error === 'no-speech' || e.error === 'audio-capture') { startSilenceTimer(); return; }
            if (e.error === 'aborted') return;
            stopRecording(false);
        };
        r.onend = () => { if (isRecording) try { r.start(); } catch (_) {} };
        return r;
    }

    function setListeningState() {
        statusText.textContent = 'Listening…';
        countdownEl.textContent = '';
        countdownEl.classList.remove('urgent');
    }
    function startSilenceTimer() {
        clearSilenceTimer();
        silenceSeconds = SILENCE_LIMIT;
        statusText.textContent = 'Auto-sending in…';
        countdownInterval = setInterval(() => {
            silenceSeconds--;
            countdownEl.textContent = silenceSeconds + 's';
            countdownEl.classList.toggle('urgent', silenceSeconds <= 2);
            if (silenceSeconds <= 0) { clearSilenceTimer(); stopRecording(true); }
        }, 1000);
    }
    function resetSilenceTimer() { clearSilenceTimer(); setListeningState(); }
    function clearSilenceTimer() { clearInterval(countdownInterval); countdownInterval = null; }

    function startRecording() {
        if (isRecording) return;
        isRecording = true;
        btnMic.classList.add('recording');
        btnMic.title = 'Stop recording';
        recognition = buildRecognition();
        try { recognition.start(); } catch (_) {}
    }
    function stopRecording(andSend = false) {
        if (!isRecording) return;
        isRecording = false;
        clearSilenceTimer();
        btnMic.classList.remove('recording');
        btnMic.title = 'Voice input';
        statusBar.classList.remove('visible');
        inputHint.style.display = '';
        countdownEl.classList.remove('urgent');
        try { recognition.abort(); } catch (_) {}
        recognition = null;
        if (andSend && txtInput.value.trim()) sendMessage();
    }

    btnMic.addEventListener('click', () => isRecording ? stopRecording(false) : startRecording());
    cancelBtn.addEventListener('click', () => stopRecording(false));
    txtInput.addEventListener('keydown', (e) => {
        if (isRecording && e.key === 'Enter' && !e.shiftKey) stopRecording(false);
    });
    document.getElementById('btnSend').addEventListener('click', () => {
        if (isRecording) stopRecording(false);
    });
})();
</script>
</body>
</html>
