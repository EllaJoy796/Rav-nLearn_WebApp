function parseQuizFromText(text) {
    const result = { title: '', questions: [] };

    // ── 1. Split off Answer Key before doing anything ──────────────
    const keyMatch = text.search(/answer\s+key/i);
    const mainText  = keyMatch > -1 ? text.slice(0, keyMatch) : text;
    const keyText   = keyMatch > -1 ? text.slice(keyMatch)    : '';

    // ── 2. Extract answers from key into a map { qNum → answerStr } ─
    const answerMap = {};
    if (keyText) {
        keyText.split('\n').forEach(line => {
            const m = line.trim().match(/^(\d+)[).:\s]+(.+)/);
            if (m) {
                // Strip leading "a) b) c)" letter labels from MCQ answers in key
                const raw = m[2].trim().replace(/^[a-e][).:\s]/i, '').trim();
                answerMap[parseInt(m[1])] = raw;
            }
        });
    }

    // ── 3. Clean markdown from main text ───────────────────────────
    const clean = mainText
        .replace(/\\_/g, '_')  
        .replace(/\*\*(.*?)\*\*/g, '$1')
        .replace(/\*(.*?)\*/g, '$1')
        .replace(/^---+$/gm, '')
        .replace(/^#+\s*/gm, '');

    const lines = clean.split('\n').map(l => l.trim()).filter(Boolean);

    // ── 4. Extract title ───────────────────────────────────────────
    let startIdx = 0;
    for (let i = 0; i < Math.min(5, lines.length); i++) {
        if (lines[i].match(/^(instructions?|answer the|directions?|section)/i)) continue;
        if (!lines[i].match(/^(\d+[).:\s]|Q\d|question\s*\d)/i)) {
            result.title = lines[i].slice(0, 60);
            startIdx = i + 1;
            break;
        }
    }

    let currentQ  = null;
    let currentNum = 0;

    const pushQ = () => {
        if (!currentQ || !currentQ.question) return;
        // Fill answer from key map if not already set
        if (answerMap[currentNum] !== undefined) {
            const keyAns = answerMap[currentNum];
            if (currentQ.options.length > 0) {
                // Match key answer letter (e.g. "b)") to option index
                const letterM = keyAns.match(/^([a-e])[).:\s]/i);
                if (letterM) {
                    currentQ.answerIndex = letterM[1].toUpperCase().charCodeAt(0) - 65;
                } else {
                    // Try to match by answer text content
                    const lc = keyAns.toLowerCase();
                    const found = currentQ.options.findIndex(o => lc.includes(o.toLowerCase().slice(0,10)));
                    if (found > -1) currentQ.answerIndex = found;
                }
            } else {
                // Fill-in-the-blank — take just the first meaningful word/phrase
                // Strip parenthetical notes like "(The document mentions...)"
                currentQ.answer = keyAns.replace(/\(.*?\)/g, '').split('/')[0].trim();
                currentQ.type   = 'fillblank';
            }
        }
        // Determine type
        if (currentQ.type !== 'fillblank') {
            if (currentQ.options.length === 2 &&
                currentQ.options.map(o => o.toLowerCase()).some(o => o === 'true' || o === 'false')) {
                currentQ.type = 'truefalse';
            } else if (currentQ.options.length > 0) {
                currentQ.type = 'mcq';
            } else {
                // No options and no answer from key → short answer, skip
                currentQ = null;
                return;
            }
        }
        result.questions.push(currentQ);
        currentQ = null;
    };

    const fillRegex    = /_{2,}|\.{3,}/;
    const optRegex     = /^([A-Ea-e])[).:\s]\s*(.+)/;
    const qNumRegex    = /^(\d+)[).:\s]\s*(.+)/;
    const qLabelRegex  = /^Q(?:uestion)?\s*(\d+)[).:]\s*(.+)/i;
    const sectionRegex = /^section\s*\d/i;

    for (let i = startIdx; i < lines.length; i++) {
        const line = lines[i];

        // Skip section headers like "Section 1: Multiple Choice"
        if (sectionRegex.test(line)) continue;

        // Q-label format "Q1. text" or "Question 1. text"
        const qLabelMatch = line.match(qLabelRegex);
        if (qLabelMatch) {
            pushQ();
            currentNum = parseInt(qLabelMatch[1]);
            currentQ = { question: qLabelMatch[2], options: [], answerIndex: 0, answer: '', type: 'mcq' };
            if (fillRegex.test(currentQ.question)) currentQ.type = 'fillblank';
            continue;
        }

        // Numbered question "1. text" — only if not an option letter
        const qNumMatch = line.match(qNumRegex);
        if (qNumMatch && !optRegex.test(line) && line.length > 8) {
            pushQ();
            currentNum = parseInt(qNumMatch[1]);
            currentQ = { question: qNumMatch[2], options: [], answerIndex: 0, answer: '', type: 'mcq' };
            if (fillRegex.test(currentQ.question)) currentQ.type = 'fillblank';
            continue;
        }

        // Option line "a) ..." / "A. ..."
        const optMatch = line.match(optRegex);
        if (optMatch && currentQ) {
            currentQ.options.push(optMatch[2]);
            continue;
        }

        // True/False inline
        if (currentQ && currentQ.options.length === 0 &&
            line.toLowerCase().match(/^(true or false|true\/false)/)) {
            currentQ.options = ['True', 'False'];
            continue;
        }

        // Continuation of question text (before any options)
        if (currentQ && currentQ.options.length === 0 && line.length > 2) {
            currentQ.question += ' ' + line;
            if (fillRegex.test(line)) currentQ.type = 'fillblank';
        }
    }

    pushQ();
    return result;
}
