        document.getElementById('quizModal').classList.remove('open');
        document.getElementById('modalQuizBody').innerHTML = '';
    }

    // Close on backdrop click
    document.getElementById('quizModal').addEventListener('click', function(e) {
        if (e.target === this) closeQuizModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeQuizModal();
    });

    function buildQuizBody(parsed, card) {
        let body = document.createElement('div');
        body.className = 'quiz-card-body';

        if (parsed.questions.length === 0) {
            const raw = document.createElement('div');
            raw.style.cssText = 'font-size:12px;color:#888;padding:8px 0;';
            raw.textContent = 'Could not parse quiz questions.';
            body.appendChild(raw);
            return body;
        }

        let score = 0, answered = 0;
        const scoreEl = document.createElement('div');
        scoreEl.className = 'quiz-score';

    parsed.questions.forEach((q, idx) => {
        const qwrap = document.createElement('div');
        qwrap.style.marginBottom = '12px';

        const qtext = document.createElement('div');
        qtext.className = 'quiz-q-text';
        qtext.innerHTML = `<strong style="color:var(--accent)">Q${idx + 1}.</strong> ${escHtml(q.question)}`;
        qwrap.appendChild(qtext);

        if (q.type === 'mcq' || q.type === 'truefalse') {
            const letters = ['A','B','C','D','E'];
            let picked = false;

            q.options.forEach((opt, oi) => {
                const ob = document.createElement('div');
                ob.className = 'quiz-opt';
                const letter = q.type === 'truefalse' ? (oi === 0 ? 'T' : 'F') : letters[oi];
                ob.innerHTML = `<span class="quiz-opt-letter">${letter}</span><span class="quiz-opt-text">${escHtml(opt)}</span>`;
                ob.addEventListener('click', () => {
                    if (picked) return;
                    picked = true; answered++;
                    const fb = qwrap.querySelector('.quiz-feedback');
                    if (oi === q.answerIndex) {
                        score++;
                        ob.classList.add('correct');
                        fb.className = 'quiz-feedback show correct';
                        fb.textContent = '✓ Correct!';
                    } else {
                        ob.classList.add('wrong');
                        const allOpts = qwrap.querySelectorAll('.quiz-opt');
                        if (allOpts[q.answerIndex]) allOpts[q.answerIndex].classList.add('correct');
                        fb.className = 'quiz-feedback show wrong';
                        fb.textContent = `✗ Correct: ${q.type === 'truefalse' ? (q.answerIndex === 0 ? 'True' : 'False') : letters[q.answerIndex]}`;
                    }
                    scoreEl.textContent = `${score}/${answered} correct`;
                });
                qwrap.appendChild(ob);
            });

            const fb = document.createElement('div');
            fb.className = 'quiz-feedback';
            qwrap.appendChild(fb);

        } else if (q.type === 'fillblank') {
            const inputRow = document.createElement('div');
            inputRow.style.cssText = 'display:flex;gap:6px;margin-top:4px;';

            const inp = document.createElement('input');
            inp.type = 'text';
            inp.placeholder = 'Type your answer…';
            inp.style.cssText = 'flex:1;background:#1e1e1e;border:1px solid #333;border-radius:6px;padding:5px 8px;color:#ccc;font-size:12px;font-family:inherit;outline:none;';

            const submitBtn = document.createElement('button');
            submitBtn.textContent = 'Check';
            submitBtn.style.cssText = 'background:var(--accent);border:none;border-radius:6px;color:#fff;font-size:11px;padding:5px 10px;cursor:pointer;font-family:inherit;';

            const fb = document.createElement('div');
            fb.className = 'quiz-feedback';
            let picked = false;

            submitBtn.addEventListener('click', () => {
                if (picked) return;
                const userAnswer = inp.value.trim().toLowerCase();
                const correct = q.answer.toLowerCase();
                if (userAnswer === correct || (correct.includes(userAnswer) && userAnswer.length > 2)) {
                    picked = true; answered++; score++;
                    fb.className = 'quiz-feedback show correct';
                    fb.textContent = '✓ Correct!';
                    inp.style.borderColor = '#2d522d';
                } else {
                    picked = true; answered++;
                    fb.className = 'quiz-feedback show wrong';
                    fb.textContent = `✗ Answer: ${q.answer}`;
                    inp.style.borderColor = '#52302d';
                }
                scoreEl.textContent = `${score}/${answered} correct`;
            });

            inp.addEventListener('keydown', e => { if (e.key === 'Enter') submitBtn.click(); });
            inputRow.appendChild(inp);
            inputRow.appendChild(submitBtn);
            qwrap.appendChild(inputRow);
            qwrap.appendChild(fb);
        }

        body.appendChild(qwrap);
    });

    const retryRow = document.createElement('div');
    retryRow.style.cssText = 'display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;';
    retryRow.appendChild(scoreEl);

    const btnRetry = document.createElement('button');
    btnRetry.textContent = '↺ Retry';
    btnRetry.style.cssText = 'background:none;border:1px solid #3a3a3a;border-radius:6px;color:var(--accent);font-size:11px;padding:4px 10px;cursor:pointer;font-family:inherit;transition:background .15s,border-color .15s;flex-shrink:0;';
    btnRetry.onmouseenter = () => { btnRetry.style.background = 'rgba(124,92,191,0.12)'; btnRetry.style.borderColor = 'var(--accent)'; };
    btnRetry.onmouseleave = () => { btnRetry.style.background = 'none'; btnRetry.style.borderColor = '#3a3a3a'; };
    btnRetry.addEventListener('click', () => {
        const wasOpen = body.classList.contains('open');
        const fresh = buildQuizBody(parsed, card);
        if (wasOpen) fresh.classList.add('open');
        card.replaceChild(fresh, body);
        body = fresh;
    });

    retryRow.appendChild(btnRetry);
    body.appendChild(retryRow);
    return body;
    }

    function openFlashcardModal(label, questions) {
