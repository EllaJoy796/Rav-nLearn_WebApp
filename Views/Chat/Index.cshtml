@{
    ViewData["Title"] = "RavnLearn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RavnLearn</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:           #141414;
            --left-bg:      #1a1a1a;
            --center-bg:    #141414;
            --right-bg:     #1a1a1a;
            --panel-border: #2a2a2a;
            --input-bg:     #252525;
            --input-border: #333;
            --bubble-user:  #50387a;
            --bubble-ai:    #2d2d2d;
            --text:         #f0f0f0;
            --text-muted:   #888;
            --text-dim:     #555;
            --accent:       #7c5cbf;
            --accent-hover: #6a4eaa;
            --btn-flat:     #2a2a2a;
            --radius:       10px;
        }

        html, body { height: 100%; background: var(--bg); font-family: 'Inter', sans-serif; color: var(--text); overflow: hidden; }

        .app-shell { display: flex; height: 100vh; width: 100vw; }

        /* ── LEFT ── */
        .panel-left {
            width: 240px;
            min-width: 160px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--left-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .left-logo {
            padding: 14px 16px;
            font-size: 17px;
            font-weight: 700;
            border-bottom: 1px solid var(--panel-border);
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        /* ── BACK + NEW CHAT BUTTONS ── */
        .left-actions {
            padding: 10px 10px 4px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-shrink: 0;
        }
        .btn-back {
            padding: 9px 14px;
            background: none;
            color: var(--text-muted);
            border: 1px solid #2e2e2e;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .btn-back:hover { background: #222; color: var(--text); border-color: #3a3a3a; }
        .btn-new-chat {
            padding: 9px 14px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.18s;
        }
        .btn-new-chat:hover { background: var(--accent-hover); }

        /* ── CHAT LIST SECTION ── */
        .left-section-label {
            padding: 10px 16px 4px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: var(--text-dim);
            text-transform: uppercase;
            flex-shrink: 0;
        }
        .chat-list {
            overflow-y: auto;
            padding: 2px 8px 4px;
            flex: 1;
            min-height: 80px;
            max-height: 40vh;
        }
        .chat-list::-webkit-scrollbar { width: 4px; }
        .chat-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        .chat-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 12.5px;
            transition: background 0.15s, color 0.15s;
            gap: 6px;
        }
        .chat-item:hover { background: #242424; color: var(--text); }
        .chat-item.active { background: rgba(124,92,191,0.18); color: var(--text); }
        .chat-item-title { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .btn-del-chat {
            opacity: 0;
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 13px;
            padding: 2px 5px;
            border-radius: 4px;
            transition: opacity 0.15s, color 0.15s;
            flex-shrink: 0;
        }
        .chat-item:hover .btn-del-chat { opacity: 1; }
        .btn-del-chat:hover { color: #e74c3c; }

        /* ── DIVIDER ── */
        .left-divider {
            height: 5px;
            background: var(--panel-border);
            margin: 0;
            flex-shrink: 0;
            cursor: row-resize;
            transition: background 0.15s;
        }
.left-divider:hover, .left-divider.dragging { background: var(--accent); }

        /* ── DOCUMENTS SECTION (in left panel) ── */
        .docs-section {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex: 1;
            min-height: 120px;
        }
        .btn-add-doc {
            margin: 4px 10px 6px;
            padding: 8px 12px;
            background: var(--btn-flat);
            border: 1px dashed #3a3a3a;
            border-radius: var(--radius);
            color: var(--text-muted);
            font-size: 12px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
            flex-shrink: 0;
        }
        .btn-add-doc:hover { background: #2e2e2e; border-color: var(--accent); color: var(--text); }
        .doc-list {
            flex: 1;
            overflow-y: auto;
            padding: 0 8px 8px;
        }
        .doc-list::-webkit-scrollbar { width: 3px; }
        .doc-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }
        .doc-item {
            background: #1e1e1e;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            padding: 7px 10px;
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 7px;
            min-width: 0;
            margin-bottom: 5px;
            transition: border-color 0.15s, background 0.15s;
        }
        .doc-item:hover { background: #222; border-color: #333; }
        .doc-item-icon { font-size: 13px; flex-shrink: 0; }
        .doc-item-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 11.5px; }
        .doc-item-spinner {
            width: 11px; height: 11px;
            border: 2px solid #444;
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .btn-del-doc {
            background: none; border: none; color: var(--text-dim);
            cursor: pointer; font-size: 12px; padding: 1px 3px;
            border-radius: 3px; flex-shrink: 0; opacity: 0;
            transition: opacity 0.15s, color 0.15s; line-height: 1;
        }
        .doc-item:hover .btn-del-doc { opacity: 1; }
        .btn-del-doc:hover { color: #e74c3c; }
        .doc-drag-handle {
            color: var(--text-dim); font-size: 10px; cursor: grab;
            flex-shrink: 0; opacity: 0; transition: opacity 0.15s;
            padding: 0 2px; user-select: none; line-height: 1;
        }
        .doc-item:hover .doc-drag-handle { opacity: 1; }
        .doc-drag-handle:active { cursor: grabbing; }
        .doc-item.dragging-source { opacity: 0.4; border: 1px dashed var(--accent); }
        .doc-item.drag-over-source { border-color: var(--accent); background: #2a2040; }

        /* ── USER AREA ── */
        .user-area {
            border-top: 1px solid var(--panel-border);
            padding: 11px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            position: sticky;
            bottom: 0;
            background: var(--left-bg);
            z-index: 2;
        }
        .user-avatar {
            width: 30px; height: 30px;
            background: var(--accent);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
        }
        .user-name { font-size: 12.5px; font-weight: 600; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .btn-logout { background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 16px; padding: 4px; border-radius: 4px; transition: color 0.15s; }
        .btn-logout:hover { color: #e74c3c; }

        /* ── HORIZONTAL RESIZE HANDLES ── */
        .resize-handle {
            width: 5px; min-width: 5px;
            cursor: col-resize;
            background: var(--panel-border);
            flex-shrink: 0; position: relative; z-index: 10;
            transition: background 0.15s;
        }
        .resize-handle:hover, .resize-handle.dragging { background: var(--accent); }
        .resize-handle::after {
            content: ''; position: absolute;
            top: 0; bottom: 0; left: -2px; right: -2px;
            cursor: col-resize;
        }
        body.resizing { user-select: none; cursor: col-resize; }
body.resizing-vertical { user-select: none; cursor: row-resize; }

        /* ── CENTER ── */
        .panel-center { flex: 1; background: var(--center-bg); display: flex; flex-direction: column; overflow: hidden; min-width: 200px; }
        .welcome-screen { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; }
        .welcome-screen h1 { font-size: 34px; font-weight: 700; letter-spacing: -1px; margin-bottom: 10px; }
        .welcome-screen p { font-size: 14px; color: var(--text-muted); }
        .messages-area { flex: 1; overflow-y: auto; padding: 24px 32px; display: none; flex-direction: column; gap: 4px; }
        .messages-area.visible { display: flex; }
        .messages-area::-webkit-scrollbar { width: 5px; }
        .messages-area::-webkit-scrollbar-thumb { background: #2e2e2e; border-radius: 4px; }
        .msg-wrapper { display: flex; flex-direction: column; margin: 3px 0; max-width: 72%; }
        .msg-wrapper.user { align-self: flex-end; align-items: flex-end; }
        .msg-wrapper.ai { align-self: flex-start; align-items: flex-start; }
        .bubble { padding: 11px 15px; border-radius: 14px; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .msg-wrapper.user .bubble { background: var(--bubble-user); color: #fff; border-bottom-right-radius: 4px; }
        .msg-wrapper.ai .bubble { background: var(--bubble-ai); color: var(--text); border-bottom-left-radius: 4px; }
        .msg-actions { display: flex; gap: 4px; margin-top: 4px; opacity: 0; transition: opacity 0.15s; }
        .msg-wrapper:hover .msg-actions { opacity: 1; }
        .btn-action { background: none; border: none; color: var(--text-dim); font-size: 11px; cursor: pointer; padding: 3px 7px; border-radius: 4px; font-family: inherit; transition: background 0.15s, color 0.15s; }
        .btn-action:hover { background: #222; color: var(--text-muted); }
        .typing-indicator { display: none; align-self: flex-start; background: var(--bubble-ai); padding: 12px 16px; border-radius: 14px; border-bottom-left-radius: 4px; gap: 5px; }
        .typing-indicator.visible { display: flex; }
        .typing-indicator span { width: 7px; height: 7px; background: var(--text-dim); border-radius: 50%; animation: bounce 1.2s infinite; }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
        .input-bar { padding: 14px 24px 18px; border-top: 1px solid var(--panel-border); background: var(--center-bg); }
        .input-row { display: flex; align-items: center; gap: 10px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: 12px; padding: 10px 14px; transition: border-color 0.2s; }
        .input-row:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124,92,191,0.12); }
        #txtInput { flex: 1; background: none; border: none; outline: none; color: var(--text); font-size: 14px; font-family: inherit; resize: none; max-height: 120px; line-height: 1.5; }
        #txtInput::placeholder { color: var(--text-dim); }
        .btn-send { background: var(--accent); border: none; border-radius: 8px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.18s; }
        .btn-send:hover { background: var(--accent-hover); }
        .btn-send:disabled { background: #333; cursor: not-allowed; }
        .btn-send svg { width: 16px; height: 16px; fill: #fff; }
        .input-hint { text-align: center; font-size: 11px; color: var(--text-dim); margin-top: 8px; }

        /* ── RIGHT PANEL — STUDY GUIDE ── */
        .panel-right {
            width: 260px;
            min-width: 180px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--right-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .right-header {
            padding: 14px 16px 10px;
            border-bottom: 1px solid var(--panel-border);
            flex-shrink: 0;
        }
        .right-header-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 2px;
        }
        .right-header-sub {
            font-size: 11px;
            color: var(--text-dim);
        }

        /* ── QUIZ CARDS (Study Guide style) ── */
        .quiz-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 10px 16px;
        }
        .quiz-list::-webkit-scrollbar { width: 3px; }
        .quiz-list::-webkit-scrollbar-thumb { background: #333; border-radius: 4px; }

        .quiz-card {
            background: #1e1e1e;
            border: 1px solid #2a2a2a;
            border-radius: 10px;
            margin-bottom: 8px;
            overflow: hidden;
            transition: border-color 0.15s;
        }
        .quiz-card:hover { border-color: #333; }

        /* ── REVIEWER CARD HEADER ── */
        .quiz-card-header {
            padding: 10px 12px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            user-select: none;
            transition: background .15s;
        }
        .quiz-card-header:hover { background: #242424; }

        .reviewer-icon {
            width: 34px; height: 34px;
            background: #252525;
            border: 1px solid #333;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

        .reviewer-meta { flex: 1; min-width: 0; }
        .reviewer-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .reviewer-info {
            font-size: 10px;
            color: var(--text-dim);
            margin-top: 1px;
        }

        .reviewer-type-badge {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 2px 6px;
            border-radius: 4px;
            flex-shrink: 0;
        }
        .badge-quiz { background: rgba(124,92,191,0.18); color: var(--accent); border: 1px solid rgba(124,92,191,0.3); }
        .badge-flashcard { background: rgba(109,191,109,0.12); color: #6dbf6d; border: 1px solid rgba(109,191,109,0.25); }

        /* ── REVIEWER ACTION BUTTONS ── */
        .reviewer-actions {
            display: flex;
            gap: 6px;
            padding: 0 12px 10px;
        }
        .btn-reviewer-action {
            flex: 1;
            padding: 7px 4px;
            background: #252525;
            border: 1px solid #2e2e2e;
            border-radius: 7px;
            color: var(--text-muted);
            font-size: 11px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
            font-weight: 500;
        }
        .btn-reviewer-action:hover {
            background: rgba(124,92,191,0.12);
            border-color: var(--accent);
            color: var(--text);
        }
        .btn-reviewer-action svg { width: 11px; height: 11px; fill: currentColor; }

        /* ── EXPANDABLE QUIZ BODY ── */
        .quiz-card-body { display: none; padding: 0 12px 10px; border-top: 1px solid #252525; }
        .quiz-card-body.open { display: block; }
        .quiz-q-text { font-size: 12px; color: #ccc; line-height: 1.5; margin: 8px 0 6px; }
        .quiz-opt { display: flex; align-items: flex-start; gap: 7px; padding: 6px 8px; border-radius: 6px; margin-bottom: 4px; cursor: pointer; transition: background .15s; border: 1px solid transparent; }
        .quiz-opt:hover { background: #2a2040; border-color: #3a2d52; }
        .quiz-opt.correct { background: #1a2d1a; border-color: #2d522d; }
        .quiz-opt.wrong { background: #2d1a1a; border-color: #52302d; }
        .quiz-opt-letter { font-size: 11px; font-weight: 700; color: var(--accent); flex-shrink: 0; width: 14px; }
        .quiz-opt-text { font-size: 12px; color: #ccc; line-height: 1.4; }
        .quiz-feedback { font-size: 11px; margin-top: 6px; padding: 5px 8px; border-radius: 5px; display: none; }
        .quiz-feedback.show { display: block; }
        .quiz-feedback.correct { background: #1a2d1a; color: #6dbf6d; }
        .quiz-feedback.wrong { background: #2d1a1a; color: #e07070; }
        .quiz-score { font-size: 10px; color: #555; text-align: right; margin-top: 4px; }

        #fileInput { display: none; }
        #quizModal.open { display: flex !important; }

        .btn-modal-open {
            background: none;
            border: 1px solid #3a3a3a;
            border-radius: 5px;
            color: var(--accent);
            font-size: 10px;
            padding: 2px 7px;
            cursor: pointer;
            font-family: inherit;
            transition: background .15s, border-color .15s;
            flex-shrink: 0;
            line-height: 1.6;
        }
        .btn-modal-open:hover { background: rgba(124,92,191,0.15); border-color: var(--accent); }
    
        .btn-mic {
        background: none; border: none; border-radius: 8px;
        width: 34px; height: 34px; display: flex; align-items: center;
        justify-content: center; cursor: pointer; flex-shrink: 0;
        color: var(--text-dim); transition: color 0.18s, background 0.18s;
        }
        .btn-mic:hover { background: #2e2e2e; color: var(--text-muted); }
        .btn-mic.recording { color: #e74c3c; animation: micPulse 1.2s ease-in-out infinite; }
        @@keyframes micPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        .voice-status-bar {
            display: none; align-items: center; justify-content: space-between;
            padding: 5px 14px 0; font-size: 11px; gap: 8px;
        }
        .voice-status-bar.visible { display: flex; }
        .voice-status-text { color: #e74c3c; display: flex; align-items: center; gap: 5px; font-weight: 500; }
        .voice-status-text .mic-dot {
            width: 7px; height: 7px; background: #e74c3c; border-radius: 50%;
            animation: micPulse 1.2s ease-in-out infinite; flex-shrink: 0;
        }
        .voice-countdown { color: var(--text-dim); font-size: 11px; flex-shrink: 0; transition: color 0.3s; }
        .voice-countdown.urgent { color: #e0a040; font-weight: 600; }
        .voice-cancel-btn {
            background: none; border: 1px solid #3a3a3a; border-radius: 5px;
            color: var(--text-dim); font-size: 10px; padding: 2px 8px;
            cursor: pointer; font-family: inherit; transition: all 0.15s; flex-shrink: 0;
        }
        .voice-cancel-btn:hover { border-color: #e74c3c; color: #e74c3c; }
     </style>
</head>
<body>

<input type="file" id="fileInput" accept=".pdf,.docx,.txt" multiple />

<div class="app-shell">

    <!-- ══ LEFT PANEL ══ -->
    <aside class="panel-left" id="panelLeft">

        <!-- Logo -->
        <div class="left-logo">
            <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                 alt="Logo" style="width:26px;height:26px;object-fit:contain;"
                 onerror="this.style.display='none'" />
            RavnLearn
        </div>

        <!-- Back + New Chat -->
        <div class="left-actions">
            <button class="btn-back" onclick="window.history.back()">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>
            <button class="btn-new-chat" id="btnNewChat">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Chat
            </button>
        </div>

        <!-- Chat List -->
        <div class="left-section-label">Chats</div>
        <div class="chat-list" id="chatList"></div>

        <!-- Divider -->
        <div class="left-divider" id="vertResizeLeft"></div>

        <!-- Documents Section -->
        <div class="docs-section">
            <div class="left-section-label">Documents</div>
            <button class="btn-add-doc" id="btnAddSource">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Add a Document
            </button>
            <div id="sourceList" class="doc-list"></div>
        </div>

        <!-- User Area -->
        <div class="user-area">
            <div class="user-avatar">@ViewBag.UserInitial</div>
            <span class="user-name">@ViewBag.Username</span>
            <button class="btn-logout" id="btnLogout" title="Logout">⏻</button>
        </div>
    </aside>

    <!-- LEFT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeLeft"></div>

    <!-- ══ CENTER ══ -->
    <main class="panel-center">
        <div class="welcome-screen" id="welcomeScreen">
            <h1>Ready to Learn?</h1>
            <p>Start a new chat or select one from the left.<br>Upload a document to get AI-powered insights.</p>
        </div>
        <div class="messages-area" id="messagesArea">
            <div class="typing-indicator" id="typingIndicator">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="input-bar">
        <div class="input-row">
            <textarea id="txtInput" rows="1" placeholder="Ask anything…" oninput="autoResize(this)"></textarea>
            <button class="btn-mic" id="btnMic" title="Voice input">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23h2v-2.06A9 9 0 0 0 21 12v-2h-2z"/>
                </svg>
            </button>
            <button class="btn-send" id="btnSend" title="Send">
                <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
            </button>
        </div>
        <div class="voice-status-bar" id="voiceStatusBar">
            <div class="voice-status-text">
                <span class="mic-dot"></span>
                <span id="voiceStatusText">Listening…</span>
            </div>
            <span class="voice-countdown" id="voiceCountdown"></span>
            <button class="voice-cancel-btn" id="voiceCancelBtn">Cancel</button>
        </div>
        <div class="input-hint" id="inputHint">Enter to send · Shift+Enter for new line</div>
        </div>
    </main>

    <!-- RIGHT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeRight"></div>

    <!-- ══ RIGHT PANEL — STUDY GUIDE ══ -->
    <aside class="panel-right" id="panelRight">
        <div class="right-header">
            <div class="right-header-title">Study Guide</div>
            <div class="right-header-sub">Generated from this chat</div>
        </div>
        <div class="quiz-list" id="quizList"></div>
    </aside>
</div>

<!-- ══ QUIZ MODAL ══ -->
<div id="quizModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.7);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
    <div style="background:#1e1e1e;border:1px solid #333;border-radius:14px;width:min(560px,90vw);max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,0.5);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #2a2a2a;flex-shrink:0;">
            <span id="modalQuizLabel" style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent)"></span>
            <button onclick="closeQuizModal()" style="background:none;border:none;color:#666;font-size:18px;cursor:pointer;padding:2px 6px;border-radius:4px;line-height:1;" title="Close">✕</button>
        </div>
        <div id="modalQuizBody" style="flex:1;overflow-y:auto;padding:20px;"></div>
    </div>
</div>

<script>
    let activeFolderId = @(ViewBag.FolderId ?? -1); 
    let activeChatId = @(ViewBag.ChatId ?? -1);
    let isSending = false;
    let speakingBtn = null;
    let quizCount = 0;

    function parseBold(text) {
        const escaped = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const bolded = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        const lines = bolded.split('\n');
        const result = lines.map(line => {
            const trimmed = line.trimStart();
            const indent = line.length - trimmed.length;
            if (trimmed.startsWith('* ')) {
                const content = trimmed.slice(2);
                const pad = indent > 0 ? `margin-left:${indent * 8}px` : '';
                return `<div style="display:flex;align-items:baseline;gap:6px;${pad}"><span style="color:var(--accent);flex-shrink:0;">•</span><span>${content}</span></div>`;
            }
            return line;
        });
        return result.join('\n');
    }

    function speakerSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>`;
    }
    function stopSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><rect x="6" y="6" width="12" height="12"/></svg>`;
    }
    function setSpeakActive(btn) { btn.innerHTML = stopSVG() + 'Stop'; btn.style.color = '#e74c3c'; }
    function setSpeakIdle(btn)   { btn.innerHTML = speakerSVG() + 'Speak'; btn.style.color = ''; if (speakingBtn === btn) speakingBtn = null; }

    document.addEventListener('DOMContentLoaded', async () => {
        await loadChatList();
        setupEventListeners();
        setupResizeHandles();
        if (activeChatId !== -1) {
            await loadChat(activeChatId);
        }
    });

    function setupEventListeners() {
        document.getElementById('btnNewChat').addEventListener('click', newChat);
        document.getElementById('btnLogout').addEventListener('click', logout);
        document.getElementById('btnSend').addEventListener('click', sendMessage);
        document.getElementById('btnAddSource').addEventListener('click', () => document.getElementById('fileInput').click());
        document.getElementById('fileInput').addEventListener('change', uploadDocument);
        document.getElementById('txtInput').addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    }

    // ══ HORIZONTAL DRAG RESIZE ════════════════════════════
    function setupResizeHandles() {
        const panelLeft   = document.getElementById('panelLeft');
        const panelRight  = document.getElementById('panelRight');
        const handleLeft  = document.getElementById('resizeLeft');
        const handleRight = document.getElementById('resizeRight');
        makeResizable(handleLeft,  (dx) => { const w = panelLeft.offsetWidth + dx;  panelLeft.style.width  = Math.min(Math.max(w, 160), 420) + 'px'; });
        makeResizable(handleRight, (dx) => { const w = panelRight.offsetWidth - dx; panelRight.style.width = Math.min(Math.max(w, 180), 420) + 'px'; });
        makeVerticalResizable(document.getElementById('vertResizeLeft'));
    }

    function makeResizable(handle, onDrag) {
        let startX = 0, dragging = false;
        handle.addEventListener('mousedown', (e) => { e.preventDefault(); dragging = true; startX = e.clientX; handle.classList.add('dragging');document.body.classList.add('resizing-vertical'); });
        document.addEventListener('mousemove', (e) => { if (!dragging) return; const dx = e.clientX - startX; startX = e.clientX; onDrag(dx); });
        document.addEventListener('mouseup', () => { if (!dragging) return; dragging = false; handle.classList.remove('dragging');document.body.classList.remove('resizing-vertical');});
        handle.addEventListener('touchstart', (e) => { dragging = true; startX = e.touches[0].clientX; handle.classList.add('dragging'); }, { passive: true });
        document.addEventListener('touchmove', (e) => { if (!dragging) return; const dx = e.touches[0].clientX - startX; startX = e.touches[0].clientX; onDrag(dx); }, { passive: true });
        document.addEventListener('touchend', () => { dragging = false; handle.classList.remove('dragging');document.body.classList.remove('resizing-vertical'); });
    }

    // ══ CHAT LIST ════════════════════════════════════════
    async function loadChatList() {
        if (activeFolderId === -1) return;
        try {
            const res = await fetch(`/Chat/GetChatsInProject?projectId=${activeFolderId}`);
            const chats = await res.json();
            const list = document.getElementById('chatList');
            list.innerHTML = '';
            chats.forEach(c => list.appendChild(makeChatItem(c.id, c.title)));
            if (activeChatId !== -1) setActiveChatItem(activeChatId);
        } catch (err) { console.error('loadChatList error:', err); }
    }

    function makeChatItem(id, title) {
        const el = document.createElement('div');
        el.className = 'chat-item';
        el.dataset.id = String(id);
        el.innerHTML = `
            <span class="chat-item-title">💬 ${escHtml(title)}</span>
            <button class="btn-del-chat" title="Delete" onclick="deleteChat(event,${id})">✕</button>
        `;
        el.addEventListener('click', () => loadChat(id));
        return el;
    }

    function addChatItemToTop(id, title) {
        const list = document.getElementById('chatList');
        document.querySelector(`.chat-item[data-id="${id}"]`)?.remove();
        list.prepend(makeChatItem(id, title));
    }

    function updateChatItemTitle(id, title) {
        const el = document.querySelector(`.chat-item[data-id="${id}"] .chat-item-title`);
        if (el) el.textContent = '💬 ' + title;
    }

    function setActiveChatItem(id) {
        document.querySelectorAll('.chat-item').forEach(el =>
            el.classList.toggle('active', el.dataset.id === String(id)));
    }

    async function newChat() {
        try {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            addChatItemToTop(data.id, data.title);
            await loadChat(data.id);
        } catch (err) { alert('Error: ' + err.message); }
    }

    async function deleteChat(e, id) {
        e.stopPropagation();
        if (!confirm('Delete this chat?')) return;
        await fetch(`/Chat/DeleteChat/${id}`, { method: 'DELETE' });
        document.querySelector(`.chat-item[data-id="${id}"]`)?.remove();
        if (activeChatId === id) resetUI();
    }

    // ══ LOAD CHAT ════════════════════════════════════════
    async function loadChat(chatId) {
        activeChatId = parseInt(chatId);
        setActiveChatItem(activeChatId);
        showChatUI();
        clearMessages();
        clearQuizList();
        clearSourceList();

        try {
            const res = await fetch(`/Chat/GetMessages?chatId=${activeChatId}`);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            const data = await res.json();
            if (data.docFilenames && Array.isArray(data.docFilenames) && data.docFilenames.length > 0) {
                data.docFilenames.forEach(name => addSourceItem(name, false));
            } else if (data.docFilename) {
                addSourceItem(data.docFilename, false);
            }
            if (!data.messages || data.messages.length === 0) {
                appendBubble('No messages yet. Start the conversation!', 'ai');
            } else {
                data.messages.forEach(m => appendBubble(m.content, m.role === 'user' ? 'user' : 'ai'));
            }
            scrollToBottom();
        } catch (err) {
            appendBubble('Could not load messages: ' + err.message, 'ai');
        }

        try {
            const qres = await fetch(`/Chat/GetQuizzesByChat?chatId=${activeChatId}`);
            const quizzes = await qres.json();
            if (quizzes.length > 0) {
                const sessionMap = new Map();
                quizzes.forEach(q => {
                    const sid = q.sessionId;
                    if (!sessionMap.has(sid)) sessionMap.set(sid, []);
                    const type = q.questionType || 'mcq';
                    let item;
                    if (type === 'fillblank') {
                        item = { question: q.question, type: 'fillblank', options: [], answerIndex: 0, answer: q.answerText || '' };
                    } else if (type === 'truefalse') {
                        item = { question: q.question, type: 'truefalse', options: ['True', 'False'], answerIndex: q.correctAnswer.toUpperCase() === 'A' ? 0 : 1, answer: '' };
                    } else {
                        item = { question: q.question, type: 'mcq', options: [q.choiceA, q.choiceB, q.choiceC, q.choiceD].filter(Boolean), answerIndex: ['A','B','C','D'].indexOf(q.correctAnswer.toUpperCase()), answer: '' };
                    }
                    sessionMap.get(sid).push(item);
                });
                sessionMap.forEach(questions => { addQuizToPanel_structured(questions); });
            }
        } catch (err) { console.error('Quiz load error:', err); }
    }

    // ══ SEND MESSAGE ══════════════════════════════════════
    async function sendMessage() {
        if (isSending) return;
        const input = document.getElementById('txtInput');
        const message = input.value.trim();
        if (!message) return;

        if (activeChatId === -1) {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            activeChatId = parseInt(data.id);
            addChatItemToTop(data.id, data.title);
            setActiveChatItem(activeChatId);
        }

        showChatUI();
        input.value = '';
        input.style.height = 'auto';
        appendBubble(message, 'user');
        showTyping();
        scrollToBottom();

        isSending = true;
        document.getElementById('btnSend').disabled = true;
        const sendingToChatId = activeChatId;

        try {
            const res = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ chatId: sendingToChatId, message })
            });
            const data = await res.json();
            hideTyping();
            if (data.error) {
                appendBubble('Error: ' + data.error, 'ai');
            } else {
                if (data.newTitle) updateChatItemTitle(sendingToChatId, data.newTitle);
                appendBubble(data.reply, 'ai');
                const quizBlocks = splitIntoQuizBlocks(data.reply);
                if (quizBlocks.length > 0) {
                    quizBlocks.forEach(block => addQuizToPanel(block));
                }
            }
        } catch (err) {
            hideTyping();
            appendBubble('Network error: ' + err.message, 'ai');
        }

        isSending = false;
        document.getElementById('btnSend').disabled = false;
        scrollToBottom();
    }

    function splitIntoQuizBlocks(text) {
        const quizHeaderRegex = /(?:^|\n)\s*\*{0,2}Quiz\s*\d+[:\-–]?[^\n]*/gi;
        const matches = [...text.matchAll(quizHeaderRegex)];
        if (matches.length >= 2) {
            const blocks = [];
            for (let i = 0; i < matches.length; i++) {
                const start = matches[i].index;
                const end   = matches[i + 1]?.index ?? text.length;
                const block = text.slice(start, end).trim();
                if (block.length > 30) blocks.push(block);
            }
            return blocks;
        }
        const looksLikeQuiz = /(\b1[).]\s|\bQ1[).:\s]|question\s*1[).:\s])/i.test(text)
            && text.includes('\n')
            && !/i (am sorry|cannot|couldn't|unable to)/i.test(text)
            && !/appears to be empty|no content/i.test(text);
        return looksLikeQuiz ? [text] : [];
    }

    // ══ MESSAGES ══════════════════════════════════════════
    function appendBubble(text, role) {
        const area = document.getElementById('messagesArea');
        const typing = document.getElementById('typingIndicator');
        const wrapper = document.createElement('div');
        wrapper.className = `msg-wrapper ${role}`;
        const bubble = document.createElement('div');
        bubble.className = 'bubble';
        bubble.innerHTML = (role === 'ai' ? '🤖  ' : '') + parseBold(text);
        const actions = document.createElement('div');
        actions.className = 'msg-actions';
        const btnCopy = document.createElement('button');
        btnCopy.className = 'btn-action';
        btnCopy.textContent = '⧉ Copy';
        btnCopy.onclick = () => {
            navigator.clipboard.writeText(text);
            btnCopy.textContent = '✓ Copied';
            btnCopy.style.color = '#6dbf6d';
            setTimeout(() => { btnCopy.textContent = '⧉ Copy'; btnCopy.style.color = ''; }, 2000);
        };
        const btnSpeak = document.createElement('button');
        btnSpeak.className = 'btn-action';
        setSpeakIdle(btnSpeak);
        btnSpeak.onclick = () => {
            if (speechSynthesis.speaking && speakingBtn === btnSpeak) {
                speechSynthesis.cancel(); setSpeakIdle(btnSpeak);
            } else {
                if (speechSynthesis.speaking) { speechSynthesis.cancel(); if (speakingBtn) setSpeakIdle(speakingBtn); }
                const utter = new SpeechSynthesisUtterance(text);
                utter.onend = () => setSpeakIdle(btnSpeak);
                utter.onerror = () => setSpeakIdle(btnSpeak);
                speakingBtn = btnSpeak;
                setSpeakActive(btnSpeak);
                speechSynthesis.speak(utter);
            }
        };
        actions.appendChild(btnCopy);
        actions.appendChild(btnSpeak);
        wrapper.appendChild(bubble);
        wrapper.appendChild(actions);
        area.insertBefore(wrapper, typing);
    }

    function clearMessages() {
        const area = document.getElementById('messagesArea');
        const typing = document.getElementById('typingIndicator');
        [...area.children].forEach(c => { if (c !== typing) c.remove(); });
    }

    function showTyping() { document.getElementById('typingIndicator').classList.add('visible'); }
    function hideTyping() { document.getElementById('typingIndicator').classList.remove('visible'); }
    function scrollToBottom() { const a = document.getElementById('messagesArea'); a.scrollTop = a.scrollHeight; }

    // ══ UPLOAD ════════════════════════════════════════════
    async function uploadDocument(e) {
        const files = Array.from(e.target.files);
        if (!files.length) return;
        if (activeChatId === -1) {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            activeChatId = parseInt(data.id);
            addChatItemToTop(data.id, data.title);
            setActiveChatItem(activeChatId);
        }
        showChatUI();
        for (const file of files) {
            const itemEl = addSourceItem(file.name, true);
            const fd = new FormData();
            fd.append('file', file);
            fd.append('chatId', activeChatId);
            try {
                const res = await fetch('/Chat/UploadDocument', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.error) { removeSourceItem(itemEl); alert('Upload failed: ' + data.error); }
                else { finalizeSourceItem(itemEl, data.fileName); appendBubble(data.welcome, 'ai'); scrollToBottom(); }
            } catch (err) { removeSourceItem(itemEl); alert('Upload error: ' + err.message); }
        }
        e.target.value = '';
    }

    // ── Source / Doc list helpers ─────────────────────────
    let dragSrcEl = null;

    function addSourceItem(name, uploading = false) {
        const list = document.getElementById('sourceList');
        const item = document.createElement('div');
        item.className = 'doc-item' + (uploading ? ' source-item-uploading' : '');

        const handle = document.createElement('span');
        handle.className = 'doc-drag-handle';
        handle.textContent = '⠿';
        handle.title = 'Drag to reorder';

        const icon = document.createElement('span');
        icon.className = 'doc-item-icon';
        icon.textContent = '📄';

        const nameEl = document.createElement('span');
        nameEl.className = 'doc-item-name';
        nameEl.title = name;
        nameEl.textContent = name;

        item.appendChild(handle);
        item.appendChild(icon);
        item.appendChild(nameEl);

        if (uploading) {
            const spinner = document.createElement('div');
            spinner.className = 'doc-item-spinner';
            item.appendChild(spinner);
        } else {
            const delBtn = document.createElement('button');
            delBtn.className = 'btn-del-doc';
            delBtn.title = 'Remove';
            delBtn.textContent = '✕';
            delBtn.onclick = () => item.remove();
            item.appendChild(delBtn);
            makeDraggable(item, handle);
        }
        list.appendChild(item);
        return item;
    }

    function makeDraggable(item, handle) {
        item.draggable = false;
        handle.addEventListener('mousedown', () => { item.draggable = true; });
        handle.addEventListener('mouseup',   () => { item.draggable = false; });
        item.addEventListener('dragstart', (e) => { dragSrcEl = item; item.classList.add('dragging-source'); e.dataTransfer.effectAllowed = 'move'; });
        item.addEventListener('dragend', () => { item.draggable = false; item.classList.remove('dragging-source'); document.querySelectorAll('.doc-item').forEach(el => el.classList.remove('drag-over-source')); dragSrcEl = null; });
        item.addEventListener('dragover', (e) => { e.preventDefault(); e.dataTransfer.dropEffect = 'move'; if (dragSrcEl && dragSrcEl !== item) { document.querySelectorAll('.doc-item').forEach(el => el.classList.remove('drag-over-source')); item.classList.add('drag-over-source'); } });
        item.addEventListener('dragleave', () => item.classList.remove('drag-over-source'));
        item.addEventListener('drop', (e) => { e.preventDefault(); item.classList.remove('drag-over-source'); if (!dragSrcEl || dragSrcEl === item) return; const list = document.getElementById('sourceList'); const items = [...list.children]; const srcIdx = items.indexOf(dragSrcEl); const dstIdx = items.indexOf(item); if (srcIdx < dstIdx) list.insertBefore(dragSrcEl, item.nextSibling); else list.insertBefore(dragSrcEl, item); });
    }

    function finalizeSourceItem(item, fileName) {
        item.classList.remove('source-item-uploading');
        const spinner = item.querySelector('.doc-item-spinner');
        if (spinner) spinner.remove();
        const nameEl = item.querySelector('.doc-item-name');
        if (nameEl && fileName) { nameEl.textContent = fileName; nameEl.title = fileName; }
        const delBtn = document.createElement('button');
        delBtn.className = 'btn-del-doc';
        delBtn.title = 'Remove';
        delBtn.textContent = '✕';
        delBtn.onclick = () => item.remove();
        item.appendChild(delBtn);
        const handle = item.querySelector('.doc-drag-handle');
        if (handle) makeDraggable(item, handle);
    }

    function removeSourceItem(item) { item?.remove(); }

    // ══ QUIZ PANEL ════════════════════════════════════════
    function addQuizToPanel(text, save = true) {
        quizCount++;
        const parsed = parseQuizFromText(text);
        const label = `Reviewer ${quizCount}`;
        const qCount = parsed.questions.length;
        const now = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

        _appendReviewerCard(label, qCount, now, 'quiz', parsed, save);
    }

    function addQuizToPanel_structured(questions) {
        quizCount++;
        const parsed = { title: '', questions };
        const label = `Reviewer ${quizCount}`;
        const qCount = questions.length;
        const now = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric' });

        _appendReviewerCard(label, qCount, now, 'quiz', parsed, false);
    }

    function _appendReviewerCard(label, qCount, dateStr, type, parsed, save) {
        const list = document.getElementById('quizList');
        const card = document.createElement('div');
        card.className = 'quiz-card';

        // ── Header ──
        const header = document.createElement('div');
        header.className = 'quiz-card-header';

        const icon = document.createElement('div');
        icon.className = 'reviewer-icon';
        icon.textContent = type === 'quiz' ? '📝' : '🃏';

        const meta = document.createElement('div');
        meta.className = 'reviewer-meta';
        meta.innerHTML = `
            <div class="reviewer-name">${escHtml(label)}</div>
            <div class="reviewer-info">${qCount} Question${qCount !== 1 ? 's' : ''} · ${dateStr}</div>
        `;

        const badge = document.createElement('span');
        badge.className = `reviewer-type-badge badge-${type}`;
        badge.textContent = type.toUpperCase();

        header.appendChild(icon);
        header.appendChild(meta);
        header.appendChild(badge);

        // ── Action Buttons ──
        const actions = document.createElement('div');
        actions.className = 'reviewer-actions';

        const btnStudy = document.createElement('button');
        btnStudy.className = 'btn-reviewer-action';
        btnStudy.innerHTML = `<svg viewBox="0 0 24 24"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg> Study Buddy`;
        btnStudy.addEventListener('click', (e) => { e.stopPropagation(); openQuizModal(label, parsed, card); });

        const btnSecondary = document.createElement('button');
        btnSecondary.className = 'btn-reviewer-action';

        if (type === 'quiz') {
            btnSecondary.innerHTML = `<svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg> Flashcard`;
            btnSecondary.addEventListener('click', (e) => { e.stopPropagation(); openFlashcardModal(label, parsed.questions); });
        } else {
            btnSecondary.innerHTML = `<svg viewBox="0 0 24 24"><path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"/></svg> Take Quiz`;
            btnSecondary.addEventListener('click', (e) => { e.stopPropagation(); openQuizModal(label, parsed, card); });
        }

        actions.appendChild(btnStudy);
        actions.appendChild(btnSecondary);

        // ── Expandable body (hidden by default) ──
        let body = buildQuizBody(parsed, card);

        header.addEventListener('click', () => {
            body.classList.toggle('open');
        });

        card.appendChild(header);
        card.appendChild(actions);
        card.appendChild(body);
        list.appendChild(card);

        // ── Save to DB ──
        if (save && activeChatId > 0) {
            const questions = parsed.questions.map(q => {
                if (q.type === 'fillblank') {
                    return { question: q.question, questionType: 'fillblank', choiceA: '', choiceB: '', choiceC: '', choiceD: '', correctAnswer: '', answerText: q.answer };
                } else if (q.type === 'truefalse') {
                    return { question: q.question, questionType: 'truefalse', choiceA: 'True', choiceB: 'False', choiceC: '', choiceD: '', correctAnswer: q.answerIndex === 0 ? 'A' : 'B', answerText: '' };
                } else {
                    return { question: q.question, questionType: 'mcq', choiceA: q.options[0] || '', choiceB: q.options[1] || '', choiceC: q.options[2] || '', choiceD: q.options[3] || '', correctAnswer: ['A','B','C','D'][q.answerIndex] || 'A', answerText: '' };
                }
            });
            if (questions.length > 0) {
                fetch('/Chat/SaveQuizQuestions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chatId: activeChatId, questions })
                }).catch(err => console.error('Quiz save error:', err));
            }
        }
    }

    function parseQuizFromText(text) {
        const result = { title: '', questions: [] };
        const keyMatch = text.search(/answer\s+key/i);
        const mainText  = keyMatch > -1 ? text.slice(0, keyMatch) : text;
        const keyText   = keyMatch > -1 ? text.slice(keyMatch)    : '';
        const answerMap = {};
        if (keyText) {
            keyText.split('\n').forEach(line => {
                const m = line.trim().match(/^(\d+)[).:\s]+(.+)/);
                if (m) { const raw = m[2].trim().replace(/^[a-e][).:\s]/i, '').trim(); answerMap[parseInt(m[1])] = raw; }
            });
        }
        const clean = mainText.replace(/\\_/g, '_').replace(/\*\*(.*?)\*\*/g, '$1').replace(/\*(.*?)\*/g, '$1').replace(/^---+$/gm, '').replace(/^#+\s*/gm, '');
        const lines = clean.split('\n').map(l => l.trim()).filter(Boolean);
        let startIdx = 0;
        for (let i = 0; i < Math.min(5, lines.length); i++) {
            if (lines[i].match(/^(instructions?|answer the|directions?|section)/i)) continue;
            if (!lines[i].match(/^(\d+[).:\s]|Q\d|question\s*\d)/i)) { result.title = lines[i].slice(0, 60); startIdx = i + 1; break; }
        }
        let currentQ = null, currentNum = 0;
        const pushQ = () => {
            if (!currentQ || !currentQ.question) return;
            if (answerMap[currentNum] !== undefined) {
                const keyAns = answerMap[currentNum];
                if (currentQ.options.length > 0) {
                    const letterM = keyAns.match(/^([a-e])[).:\s]/i);
                    if (letterM) { currentQ.answerIndex = letterM[1].toUpperCase().charCodeAt(0) - 65; }
                    else { const lc = keyAns.toLowerCase(); const found = currentQ.options.findIndex(o => lc.includes(o.toLowerCase().slice(0,10))); if (found > -1) currentQ.answerIndex = found; }
                } else { currentQ.answer = keyAns.replace(/\(.*?\)/g, '').split('/')[0].trim(); currentQ.type = 'fillblank'; }
            }
            if (currentQ.type !== 'fillblank') {
                if (currentQ.options.length === 2 && currentQ.options.map(o => o.toLowerCase()).some(o => o === 'true' || o === 'false')) { currentQ.type = 'truefalse'; }
                else if (currentQ.options.length > 0) { currentQ.type = 'mcq'; }
                else { currentQ = null; return; }
            }
            result.questions.push(currentQ);
            currentQ = null;
        };
        const fillRegex = /_{2,}|\.{3,}/;
        const optRegex = /^([A-Ea-e])[).:\s]\s*(.+)/;
        const qNumRegex = /^(\d+)[).:\s]\s*(.+)/;
        const qLabelRegex = /^Q(?:uestion)?\s*(\d+)[).:]\s*(.+)/i;
        const sectionRegex = /^section\s*\d/i;
        for (let i = startIdx; i < lines.length; i++) {
            const line = lines[i];
            if (sectionRegex.test(line)) continue;
            const qLabelMatch = line.match(qLabelRegex);
            if (qLabelMatch) { pushQ(); currentNum = parseInt(qLabelMatch[1]); currentQ = { question: qLabelMatch[2], options: [], answerIndex: 0, answer: '', type: 'mcq' }; if (fillRegex.test(currentQ.question)) currentQ.type = 'fillblank'; continue; }
            const qNumMatch = line.match(qNumRegex);
            if (qNumMatch && !optRegex.test(line) && line.length > 8) { pushQ(); currentNum = parseInt(qNumMatch[1]); currentQ = { question: qNumMatch[2], options: [], answerIndex: 0, answer: '', type: 'mcq' }; if (fillRegex.test(currentQ.question)) currentQ.type = 'fillblank'; continue; }
            const optMatch = line.match(optRegex);
            if (optMatch && currentQ) { currentQ.options.push(optMatch[2]); continue; }
            if (currentQ && currentQ.options.length === 0 && line.toLowerCase().match(/^(true or false|true\/false)/)) { currentQ.options = ['True', 'False']; continue; }
            if (currentQ && currentQ.options.length === 0 && line.length > 2) { currentQ.question += ' ' + line; if (fillRegex.test(line)) currentQ.type = 'fillblank'; }
        }
        pushQ();
        return result;
    }

