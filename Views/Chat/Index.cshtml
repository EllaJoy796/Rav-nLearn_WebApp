@{
    ViewData["Title"] = "Rev'nLearn";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RavnLearn</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:           #f5f1fb;
            --left-bg:      #ffffff;
            --center-bg:    #fbf8ff;
            --right-bg:     #ffffff;
            --panel-border: #ddd1ef;
            --input-bg:     #ffffff;
            --input-border: #d6c8ea;
            --bubble-user:  #8c63d2;
            --bubble-ai:    #ffffff;
            --text:         #111111;
            --text-muted:   #454545;
            --text-dim:     #757575;
            --accent:       #7c5cbf;
            --accent-hover: #6a4eaa;
            --btn-flat:     #f3edf9;
            --radius:       10px;
        }

        html, body { height: 100%; background: var(--bg); font-family: 'Poppins', sans-serif; color: var(--text); overflow: hidden; }

        .app-shell { display: flex; height: 100vh; width: 100vw; }

        /* ── LEFT ── */
        .panel-left {
            width: 240px;
            min-width: 160px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--left-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transition: none;
        }
        .panel-left.collapsed {
            width: 62px !important;
            min-width: 62px;
        }
        .left-logo {
            padding: 14px 16px;
            font-size: 17px;
            font-weight: 700;
            border-bottom: 1px solid var(--panel-border);
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }
        .left-logo-text { white-space: nowrap; }
        .panel-left.collapsed .left-logo { padding: 14px 12px; justify-content: center; }
        .panel-left.collapsed .left-logo-text { display: none; }

        /* ── BACK + NEW CHAT BUTTONS ── */
        .left-actions {
            padding: 10px 10px 4px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex-shrink: 0;
        }
        .btn-back {
            padding: 9px 14px;
            background: none;
            color: var(--text-muted);
            border: 1px solid #2e2e2e;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.15s, color 0.15s, border-color 0.15s;
        }
        .btn-back:hover { background: #f5effc; color: var(--text); border-color: #cdb8ea; }
        .btn-new-chat {
            padding: 9px 14px;
            background: var(--accent);
            color: #fff;
            border: none;
            border-radius: var(--radius);
            font-size: 12px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.18s;
        }
        .btn-new-chat:hover { background: var(--accent-hover); }
        .panel-left.collapsed .left-actions,
        .panel-left.collapsed .left-section-label,
        .panel-left.collapsed .chat-list,
        .panel-left.collapsed .left-divider,
        .panel-left.collapsed .docs-section,
        .panel-left.collapsed .user-area {
            display: none;
        }
        .panel-left.collapsed .left-rail {
            display: flex;
        }

        /* ── CHAT LIST SECTION ── */
        .left-section-label {
            padding: 10px 16px 4px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.2px;
            color: var(--text-dim);
            text-transform: uppercase;
            flex-shrink: 0;
        }
        .chat-list {
            overflow-y: auto;
            padding: 2px 8px 4px;
            flex: 1;
            min-height: 80px;
            max-height: 40vh;
        }
        .chat-list::-webkit-scrollbar { width: 4px; }
        .chat-list::-webkit-scrollbar-thumb { background: #d3c3eb; border-radius: 4px; }
        .chat-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px 10px;
            border-radius: 8px;
            cursor: pointer;
            color: var(--text-muted);
            font-size: 12.5px;
            transition: background 0.15s, color 0.15s;
            gap: 6px;
            position: relative;
        }
        .chat-item:hover { background: #f4eefc; color: var(--text); }
        .chat-item.active { background: rgba(124,92,191,0.18); color: var(--text); }
        .chat-item-main {
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
        }
        .chat-item-title { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .chat-item-icon,
        .doc-item-icon-svg,
        .reviewer-icon svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            flex-shrink: 0;
        }
        .btn-more-chat,
        .btn-more-reviewer,
        .btn-doc-speak {
            opacity: 0;
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 4px;
            transition: opacity 0.15s, color 0.15s, background 0.15s;
            flex-shrink: 0;
        }
        .btn-more-chat svg,
        .btn-more-reviewer svg,
        .btn-doc-speak svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }
        .chat-item:hover .btn-more-chat,
        .quiz-card:hover .btn-more-reviewer,
        .doc-item:hover .btn-doc-speak {
            opacity: 1;
        }
        .btn-more-chat:hover,
        .btn-more-reviewer:hover,
        .btn-doc-speak:hover {
            color: var(--text);
            background: var(--dots-hover-bg);
        }
        .context-menu {
            position: absolute;
            right: 10px;
            top: calc(100% - 2px);
            background: #ffffff;
            border: 1px solid #d7caeb;
            border-radius: 10px;
            min-width: 140px;
            padding: 6px;
            z-index: 50;
            box-shadow: 0 16px 32px rgba(0,0,0,0.35);
            white-space: nowrap;
        }
        .ctx-menu-item {
            width: 100%;
            border: none;
            background: transparent;
            color: var(--text-muted);
            padding: 9px 10px;
            border-radius: 8px;
            font-size: 12px;
            text-align: left;
            cursor: pointer;
            font-family: inherit;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .ctx-menu-item svg {
            width: 14px;
            height: 14px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }
        .ctx-menu-item:hover { background: #f4eefc; color: var(--text); }
        .ctx-menu-item.delete-item:hover { color: #f08080; }

        /* ── DIVIDER ── */
        .left-divider {
            height: 5px;
            background: var(--panel-border);
            margin: 0;
            flex-shrink: 0;
            cursor: row-resize;
            transition: background 0.15s;
        }
.left-divider:hover, .left-divider.dragging { background: var(--accent); }

        /* ── DOCUMENTS SECTION (in left panel) ── */
        .docs-section {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            flex: 1;
            min-height: 120px;
        }
        .btn-add-doc {
            margin: 4px 10px 6px;
            padding: 8px 12px;
            background: var(--btn-flat);
            border: 1px dashed #3a3a3a;
            border-radius: var(--radius);
            color: var(--text-muted);
            font-size: 12px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 7px;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
            flex-shrink: 0;
        }
        .btn-add-doc:hover { background: var(--btn-flat); border-color: var(--accent); color: var(--text); }
        .doc-list {
            flex: 1;
            overflow-y: auto;
            padding: 0 8px 8px;
        }
        .doc-list::-webkit-scrollbar { width: 3px; }
        .doc-list::-webkit-scrollbar-thumb { background: #d3c3eb; border-radius: 4px; }
        .doc-item {
            background: #ffffff;
            border: 1px solid #ddd1ef;
            border-radius: 8px;
            padding: 7px 10px;
            font-size: 12px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: 7px;
            min-width: 0;
            margin-bottom: 5px;
            transition: border-color 0.15s, background 0.15s;
        }
        .doc-item:hover { background: #f7f2fd; border-color: #cdb8ea; }
        .doc-item-icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: #f4eefc;
            border: 1px solid #d7caeb;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--icon-color);
        }
        .doc-item-name { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 11.5px; text-align: left; min-width: 0; }        .doc-item-spinner {
            width: 11px; height: 11px;
            border: 2px solid #d2c5e6;
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin 0.7s linear infinite;
            flex-shrink: 0;
        }
        @@keyframes spin { to { transform: rotate(360deg); } }
        .btn-del-doc {
            background: none; border: none; color: var(--text-dim);
            cursor: pointer; border-radius: 4px; flex-shrink: 0; opacity: 0;
            transition: opacity 0.15s, color 0.15s, background 0.15s; line-height: 1;
            width: 28px;
            height: 28px;
        }
        .doc-item:hover .btn-del-doc { opacity: 1; }
        .btn-del-doc:hover { color: #e74c3c; background: #2a2a2a; }
        .btn-del-doc svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
        .doc-drag-handle {
            color: var(--text-dim); font-size: 10px; cursor: grab;
            flex-shrink: 0; opacity: 0; transition: opacity 0.15s;
            padding: 0 2px; user-select: none; line-height: 1;
        }
        .doc-item:hover .doc-drag-handle { opacity: 1; }
        .doc-drag-handle:active { cursor: grabbing; }
        .doc-item.dragging-source { opacity: 0.4; border: 1px dashed var(--accent); }
        .doc-item.drag-over-source { border-color: var(--accent); background: #efe6fb; }

        /* ── USER AREA ── */
        .user-area {
            border-top: 1px solid var(--panel-border);
            padding: 11px 14px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            position: sticky;
            bottom: 0;
            background: var(--left-bg);
            z-index: 2;
        }
        .user-avatar {
            width: 30px; height: 30px;
            background: var(--accent);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 12px; font-weight: 700; color: #fff; flex-shrink: 0;
        }
        .user-name { font-size: 12.5px; font-weight: 600; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .left-rail,
        .right-rail {
            display: none;
            flex: 1;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            background: linear-gradient(180deg, #faf6ff, #f2eafb);
        }
        
        .rail-stack {
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: center;
            width: 100%;
        }
        .rail-icon-btn {
            width: 42px;
            height: 42px;
            border: 1px solid #d7caeb;
            border-radius: 12px;
            background: #ffffff;
            color: var(--text-muted);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s, background 0.15s;
        }
        .rail-icon-btn:hover {
            color: var(--text);
            border-color: #c7b3e7;
            background: #f5effc;
        }
        .rail-icon-btn svg {
            width: 18px;
            height: 18px;
            stroke: currentColor;
            fill: none;
        }

        /* ── HORIZONTAL RESIZE HANDLES ── */
        .resize-handle {
            width: 6px; min-width: 6px;
            cursor: col-resize;
            background: rgba(124,92,191,0.15);
            flex-shrink: 0; position: relative; z-index: 10;
            transition: background 0.15s;
        }
        .resize-handle:hover, .resize-handle.dragging { background: var(--accent); }
        .resize-handle::after {
            content: ''; position: absolute;
            top: 0; bottom: 0; left: -12px; right: -12px;
            cursor: col-resize;
        }
        body.resizing { user-select: none; cursor: col-resize; }
        body.resizing-vertical { user-select: none; cursor: row-resize; }

        /* ── CENTER ── */
        .panel-center { flex: 1; background: var(--center-bg); display: flex; flex-direction: column; overflow: hidden; min-width: 200px; }
        .welcome-screen { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; }
        .welcome-screen h1 { font-size: 34px; font-weight: 700; letter-spacing: -1px; margin-bottom: 10px; }
        .welcome-screen p { font-size: 14px; color: var(--text-muted); }
        .messages-area { flex: 1; overflow-y: auto; padding: 24px 32px; display: none; flex-direction: column; gap: 4px; }
        .messages-area.visible { display: flex; }
        .messages-area::-webkit-scrollbar { width: 5px; }
        .messages-area::-webkit-scrollbar-thumb { background: #2e2e2e; border-radius: 4px; }
        .msg-wrapper { display: flex; flex-direction: column; margin: 3px 0; max-width: 72%; }
        .msg-wrapper.user { align-self: flex-end; align-items: flex-end; }
        .msg-wrapper.ai { align-self: flex-start; align-items: flex-start; }
        .bubble { padding: 11px 15px; border-radius: 14px; font-size: 14px; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }
        .msg-wrapper.user .bubble { background: var(--bubble-user); color: #fff; border-bottom-right-radius: 4px; }
        .msg-wrapper.ai .bubble { background: var(--bubble-ai); color: #111111; border-bottom-left-radius: 4px; border: 1px solid #ddd1ef; }
        .msg-actions { display: flex; gap: 4px; margin-top: 4px; opacity: 0; transition: opacity 0.15s; }
        .msg-wrapper:hover .msg-actions { opacity: 1; }
        .btn-action { background: none; border: none; color: var(--text-dim); font-size: 11px; cursor: pointer; padding: 3px 7px; border-radius: 4px; font-family: inherit; transition: background 0.15s, color 0.15s; }
        .btn-action:hover { background: #f5effc; color: var(--text-muted); }
            body.dark-mode .btn-action { color: #6a5890; }
            body.dark-mode .btn-action:hover { background: #241d38; color: #a090c0; }
        .typing-indicator { display: none; align-self: flex-start; background: var(--bubble-ai); padding: 12px 16px; border-radius: 14px; border-bottom-left-radius: 4px; gap: 5px; border: 1px solid #ddd1ef; }
        .typing-indicator.visible { display: flex; }
        .typing-indicator span { width: 7px; height: 7px; background: #8c63d2; border-radius: 50%; animation: bounce 1.2s infinite; }
        .typing-indicator span:nth-child(2) { animation-delay: 0.2s; }
        .typing-indicator span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes bounce { 0%, 60%, 100% { transform: translateY(0); } 30% { transform: translateY(-6px); } }
        .input-bar { padding: 14px 24px 18px; border-top: 1px solid var(--panel-border); background: var(--center-bg); }
        .input-row { display: flex; align-items: center; gap: 10px; background: var(--input-bg); border: 1px solid var(--input-border); border-radius: 12px; padding: 10px 14px; transition: border-color 0.2s; }
        .input-row:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124,92,191,0.12); }
        #txtInput { flex: 1; background: none; border: none; outline: none; color: var(--text); font-size: 14px; font-family: inherit; resize: none; max-height: 120px; line-height: 1.5; }
        #txtInput::placeholder { color: var(--text-dim); }
        .btn-send { background: var(--accent); border: none; border-radius: 8px; width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.18s; }
        .btn-send:hover { background: var(--accent-hover); }
        .btn-send:disabled { background: #333; cursor: not-allowed; }
        .btn-send svg { width: 16px; height: 16px; fill: #fff; }
        .input-hint { text-align: center; font-size: 11px; color: var(--text-dim); margin-top: 8px; }

        /* ── RIGHT PANEL — STUDY GUIDE ── */
        .panel-right {
            width: 260px;
            min-width: 180px;
            max-width: 420px;
            flex-shrink: 0;
            background: var(--right-bg);
            display: flex;
            flex-direction: column;
            overflow: hidden;
            position: relative;
            transition: none;
        }
        .panel-right.collapsed {
            width: 62px !important;
            min-width: 62px;
        }
        .panel-right.collapsed .right-header,
        .panel-right.collapsed .quiz-list {
            display: none;
        }
        .panel-right.collapsed .right-rail {
            display: flex;
        }
        .right-header {
            padding: 14px 16px 10px;
            border-bottom: 1px solid var(--panel-border);
            flex-shrink: 0;
        }
        .right-header-title {
            font-size: 15px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 2px;
        }
        .right-header-sub {
            font-size: 11px;
            color: var(--text-dim);
        }

        /* ── QUIZ CARDS (Study Guide style) ── */
        .quiz-list {
            flex: 1;
            overflow-y: auto;
            padding: 10px 10px 16px;
        }
        .quiz-list::-webkit-scrollbar { width: 3px; }
        .quiz-list::-webkit-scrollbar-thumb { background: #d3c3eb; border-radius: 4px; }

        .quiz-card {
            background: #ffffff;
            border: 1px solid #ddd1ef;
            border-radius: 10px;
            margin-bottom: 8px;
            overflow: visible;
            transition: border-color 0.15s;
        }
        .quiz-card:hover { border-color: #cdb8ea; }

        /* ── REVIEWER CARD HEADER ── */
        .quiz-card-header {
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 10px;
            user-select: none;
            transition: background .15s;
            position: relative;
        }
        .quiz-card-header:hover { background: #f5effc; }

        .reviewer-icon {
            width: 34px; height: 34px;
            background: #f4eefc;
            border: 1px solid #d7caeb;
            border-radius: 8px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
            color: var(--text);
        }

        .reviewer-meta { flex: 1; min-width: 0; }
        .reviewer-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .reviewer-info {
            font-size: 10px;
            color: var(--text-dim);
            margin-top: 1px;
        }

        .reviewer-type-badge {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 0.8px;
            text-transform: uppercase;
            padding: 2px 6px;
            border-radius: 4px;
            flex-shrink: 0;
        }
        .badge-quiz { background: rgba(124,92,191,0.18); color: var(--accent); border: 1px solid rgba(124,92,191,0.3); }
        .badge-flashcard { background: rgba(109,191,109,0.12); color: #6dbf6d; border: 1px solid rgba(109,191,109,0.25); }

        /* ── REVIEWER ACTION BUTTONS ── */
        .reviewer-actions {
            display: flex;
            gap: 6px;
            padding: 0 12px 10px;
        }
        .btn-reviewer-action {
            flex: 1;
            padding: 7px 4px;
            background: #ffffff;
            border: 1px solid #ddd1ef;
            border-radius: 7px;
            color: var(--text-muted);
            font-size: 11px;
            font-family: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            transition: background 0.15s, border-color 0.15s, color 0.15s;
            font-weight: 500;
        }
        .btn-reviewer-action:hover {
            background: rgba(124,92,191,0.08);
            border-color: var(--accent);
            color: var(--text);
        }
        .btn-reviewer-action svg { width: 11px; height: 11px; fill: currentColor; }

        /* ── EXPANDABLE QUIZ BODY ── */
        .quiz-card-body { display: none; padding: 0 12px 10px; border-top: 1px solid #e7dcf5; }
        .quiz-card-body.open { display: block; }
        .quiz-q-text { font-size: 12px; color: #222; line-height: 1.5; margin: 8px 0 6px; }
        .quiz-opt { display: flex; align-items: flex-start; gap: 7px; padding: 6px 8px; border-radius: 6px; margin-bottom: 4px; cursor: pointer; transition: background .15s; border: 1px solid transparent; }
        .quiz-opt:hover { background: #f5effc; border-color: #ceb9ea; }
        .quiz-opt.correct { background: #edf8ee; border-color: #8cc68d; }
        .quiz-opt.wrong { background: #fdeeee; border-color: #e0a0a0; }
        .quiz-opt-letter { font-size: 11px; font-weight: 700; color: var(--accent); flex-shrink: 0; width: 14px; }
        .quiz-opt-text { font-size: 12px; color: #222; line-height: 1.4; }
        .quiz-feedback { font-size: 11px; margin-top: 6px; padding: 5px 8px; border-radius: 5px; display: none; }
        .quiz-feedback.show { display: block; }
        .quiz-feedback.correct { background: #edf8ee; color: #317d34; }
        .quiz-feedback.wrong { background: #fdeeee; color: #b54c4c; }
        .quiz-score { font-size: 10px; color: #555; text-align: right; margin-top: 4px; }

        #fileInput { display: none; }
        #quizModal.open { display: flex !important; }

        .btn-modal-open {
            background: none;
            border: 1px solid #3a3a3a;
            border-radius: 5px;
            color: var(--accent);
            font-size: 10px;
            padding: 2px 7px;
            cursor: pointer;
            font-family: inherit;
            transition: background .15s, border-color .15s;
            flex-shrink: 0;
            line-height: 1.6;
        }
        .btn-modal-open:hover { background: rgba(124,92,191,0.15); border-color: var(--accent); }
    
        .btn-mic {
        background: none; border: none; border-radius: 8px;
        width: 34px; height: 34px; display: flex; align-items: center;
        justify-content: center; cursor: pointer; flex-shrink: 0;
        color: var(--text-dim); transition: color 0.18s, background 0.18s;
        }
        .btn-mic:hover { background: #2e2e2e; color: var(--text-muted); }
        .btn-mic.recording { color: #e74c3c; animation: micPulse 1.2s ease-in-out infinite; }
        @@keyframes micPulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        .voice-status-bar {
            display: none; align-items: center; justify-content: space-between;
            padding: 5px 14px 0; font-size: 11px; gap: 8px;
        }
        .voice-status-bar.visible { display: flex; }
        .voice-status-text { color: #e74c3c; display: flex; align-items: center; gap: 5px; font-weight: 500; }
        .voice-status-text .mic-dot {
            width: 7px; height: 7px; background: #e74c3c; border-radius: 50%;
            animation: micPulse 1.2s ease-in-out infinite; flex-shrink: 0;
        }
        .voice-countdown { color: var(--text-dim); font-size: 11px; flex-shrink: 0; transition: color 0.3s; }
        .voice-countdown.urgent { color: #e0a040; font-weight: 600; }
        .voice-cancel-btn {
            background: none; border: 1px solid #3a3a3a; border-radius: 5px;
            color: var(--text-dim); font-size: 10px; padding: 2px 8px;
            cursor: pointer; font-family: inherit; transition: all 0.15s; flex-shrink: 0;
        }
        .voice-cancel-btn:hover { border-color: #e74c3c; color: #e74c3c; }
        .side-toggle {
            position: fixed;
            top: 50%;
            width: 34px;
            height: 54px;
            border-radius: 14px;
            border: 1px solid #ccb7e8;
            background: #ffffff;
            color: #222;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 12px 22px rgba(87,57,138,0.14);
            cursor: pointer;
            z-index: 40;
            transform: translateY(-50%);
            transition: background 0.15s ease, top 0.15s ease, left 0.22s ease, right 0.22s ease;
        }
        .side-toggle:hover { background: #f5effc; }
        .side-toggle svg {
            width: 15px;
            height: 15px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2.4;
        }
        .modal-shell {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1100;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(4px);
            align-items: center;
            justify-content: center;
        }
        .modal-shell.open { display: flex; }
        .modal-card {
            width: min(440px, 92vw);
            background: #ffffff;
            border: 1px solid #ddd1ef;
            border-radius: 16px;
            box-shadow: 0 24px 60px rgba(87,57,138,0.16);
            overflow: hidden;
        }
        .modal-head {
            padding: 16px 18px;
            border-bottom: 1px solid #ece2f7;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-title {
            font-size: 14px;
            font-weight: 700;
            color: var(--text);
        }
        .modal-close {
            border: none;
            background: transparent;
            color: var(--text-dim);
            cursor: pointer;
            width: 28px;
            height: 28px;
            border-radius: 8px;
        }
        .modal-close:hover { color: var(--text); background: #f5effc; }
        .modal-body { padding: 18px; }
        .modal-copy {
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.5;
            margin-bottom: 14px;
        }
        .modal-input {
            width: 100%;
            background: #ffffff;
            border: 1px solid #d7caeb;
            border-radius: 12px;
            color: var(--text);
            font-size: 13px;
            padding: 12px 14px;
            outline: none;
            font-family: inherit;
        }
        .modal-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(124,92,191,0.14);
        }
        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            padding: 0 18px 18px;
        }
        .modal-btn {
            border: 1px solid #d7caeb;
            background: #ffffff;
            color: var(--text);
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 12px;
            font-family: inherit;
            cursor: pointer;
        }
        .modal-btn.primary {
            background: var(--accent);
            border-color: var(--accent);
            color: #fff;
        }
        .modal-btn.danger {
            background: #8f2d2d;
            border-color: #8f2d2d;
            color: #fff;
        }
     </style>
</head>
<body>

<input type="file" id="fileInput" accept=".pdf,.docx,.txt" multiple />

<div class="app-shell">

    <!-- ══ LEFT PANEL ══ -->
    <aside class="panel-left" id="panelLeft">

        <!-- Logo -->
        <div class="left-logo">
            <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                 alt="Logo" style="width:26px;height:26px;object-fit:contain;"
                 onerror="this.style.display='none'" />
            Rev'nLearn
        </div>

        <!-- Back + New Chat -->
        <div class="left-actions">
            <button class="btn-back" onclick="window.history.back()">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="15 18 9 12 15 6"/>
                </svg>
                Back
            </button>
            <button class="btn-new-chat" id="btnNewChat">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                New Chat
            </button>
        </div>

        <!-- Chat List -->
        <div class="left-section-label">Chats</div>
        <div class="chat-list" id="chatList"></div>

        <!-- Divider -->
        <div class="left-divider" id="vertResizeLeft"></div>

        <!-- Documents Section -->
        <div class="docs-section">
            <div class="left-section-label">Documents</div>
            <button class="btn-add-doc" id="btnAddSource">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Add a Document
            </button>
            <div id="sourceList" class="doc-list"></div>
        </div>

        <!-- User Area -->
        <div class="user-area">
            <div class="user-avatar">@ViewBag.UserInitial</div>
            <span class="user-name">@ViewBag.Username</span>
        </div>
        <div class="left-rail">
            <div class="rail-stack" style="flex:1;overflow-y:auto;overflow-x:hidden;width:100%;align-items:center;">
                <button class="rail-icon-btn" id="btnRailBack" title="Back">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6"></path>
                    </svg>
                </button>
                <button class="rail-icon-btn" id="btnRailNewChat" title="New Chat">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>
                </button>
                <div class="rail-stack" id="collapsedChatRail"></div>
                <div style="width:36px;height:1px;background:var(--panel-border);margin:4px 0;flex-shrink:0;"></div>
                <button class="rail-icon-btn" id="btnRailAddDoc" title="Add Document" style="position:relative;">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 3h7l5 5v13H7z"></path>
                        <path d="M14 3v5h5"></path>
                    </svg>
                    <span style="position:absolute;top:-4px;right:-4px;width:14px;height:14px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:#fff;line-height:1;">+</span>
                </button>
                <div class="rail-stack" id="collapsedDocRail"></div>
            </div>
            <div class="rail-stack">
                <div class="user-avatar">@ViewBag.UserInitial</div>
            </div>
        </div>
    </aside>

    <!-- LEFT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeLeft"></div>
    <button class="side-toggle" id="leftPanelToggle" title="Collapse left panel">
        <svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>
    </button>

    <!-- ══ CENTER ══ -->
    <main class="panel-center">
        <div class="welcome-screen" id="welcomeScreen">
            <h1>Ready to Learn?</h1>
            <p>Start a new chat or select one from the left.<br>Upload a document to get AI-powered insights.</p>
        </div>
        <div class="messages-area" id="messagesArea">
            <div class="typing-indicator" id="typingIndicator">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="input-bar">
        <div class="input-row">
            <textarea id="txtInput" rows="1" placeholder="Ask anything…" oninput="autoResize(this)"></textarea>
            <button class="btn-mic" id="btnMic" title="Voice input">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2H3v2a9 9 0 0 0 8 8.94V23h2v-2.06A9 9 0 0 0 21 12v-2h-2z"/>
                </svg>
            </button>
            <button class="btn-send" id="btnSend" title="Send">
                <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2z"/></svg>
            </button>
        </div>
        <div class="voice-status-bar" id="voiceStatusBar">
            <div class="voice-status-text">
                <span class="mic-dot"></span>
                <span id="voiceStatusText">Listening…</span>
            </div>
            <span class="voice-countdown" id="voiceCountdown"></span>
            <button class="voice-cancel-btn" id="voiceCancelBtn">Cancel</button>
        </div>
        <div class="input-hint" id="inputHint">Enter to send · Shift+Enter for new line</div>
        </div>
    </main>

    <!-- RIGHT RESIZE HANDLE -->
    <div class="resize-handle" id="resizeRight"></div>

    <!-- ══ RIGHT PANEL — STUDY GUIDE ══ -->
    <aside class="panel-right" id="panelRight">
        <div class="right-header">
            <div class="right-header-title">Study Guide</div>
            <div class="right-header-sub">Generated from this chat</div>
        </div>
        <div class="quiz-list" id="quizList"></div>
        <div class="right-rail">
            <div class="rail-stack">
                <button class="rail-icon-btn" id="btnRailStudyGuide" title="Study Guide">
                    <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 4h12a2 2 0 0 1 2 2v14l-4-2-4 2-4-2-4 2V6a2 2 0 0 1 2-2z"></path>
                    </svg>
                </button>
            </div>
        </div>
    </aside>
    <button class="side-toggle" id="rightPanelToggle" title="Collapse right panel">
        <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg>
    </button>
</div>

<!-- ══ QUIZ MODAL ══ -->
<div id="quizModal" style="display:none;position:fixed;inset:0;z-index:1000;background:rgba(106,78,170,0.18);backdrop-filter:blur(4px);align-items:center;justify-content:center;">
    <div style="background:#ffffff;border:1px solid #ddd1ef;border-radius:14px;width:min(560px,90vw);max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 24px 60px rgba(87,57,138,0.16);">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #ece2f7;flex-shrink:0;">
            <span id="modalQuizLabel" style="font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--accent)"></span>
            <button onclick="closeQuizModal()" style="background:none;border:none;color:#666;font-size:18px;cursor:pointer;padding:2px 6px;border-radius:4px;line-height:1;" title="Close">✕</button>
        </div>
        <div id="modalQuizBody" style="flex:1;overflow-y:auto;padding:20px;"></div>
    </div>
</div>
<div class="modal-shell" id="actionModal">
    <div class="modal-card">
        <div class="modal-head">
            <div class="modal-title" id="actionModalTitle">Rename</div>
            <button class="modal-close" type="button" onclick="closeActionModal()">X</button>
        </div>
        <div class="modal-body">
            <div class="modal-copy" id="actionModalCopy"></div>
            <input class="modal-input" id="actionModalInput" type="text" />
        </div>
        <div class="modal-actions">
            <button class="modal-btn" type="button" onclick="closeActionModal()">Cancel</button>
            <button class="modal-btn primary" type="button" id="actionModalConfirm">Save</button>
        </div>
    </div>
</div>

<script>
    let activeFolderId = @(ViewBag.FolderId ?? -1); 
    let activeChatId = @(ViewBag.ChatId ?? -1);
    let isSending = false;
    let speakingBtn = null;
    let quizCount = 0;
    let actionModalHandler = null;
    let lastReviewerPayload = null;

    let _voicesLoaded = false;
        function ensureVoicesReady(callback) {
            if (_voicesLoaded || speechSynthesis.getVoices().length > 0) {
                _voicesLoaded = true;
                callback();
                return;
            }
            speechSynthesis.addEventListener('voiceschanged', function onReady() {
                _voicesLoaded = true;
                speechSynthesis.removeEventListener('voiceschanged', onReady);
                callback();
            });
            // Trigger load
            speechSynthesis.getVoices();
        }

    function parseBold(text) {
        const escaped = text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
        const bolded = escaped.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        const lines = bolded.split('\n');
        const result = lines.map(line => {
            const trimmed = line.trimStart();
            const indent = line.length - trimmed.length;
            if (trimmed.startsWith('* ')) {
                const content = trimmed.slice(2);
                const pad = indent > 0 ? `margin-left:${indent * 8}px` : '';
                return `<div style="display:flex;align-items:baseline;gap:6px;${pad}"><span style="color:var(--accent);flex-shrink:0;">•</span><span>${content}</span></div>`;
            }
            return line;
        });
        return result.join('\n');
    }

    function speakerSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>`;
    }
    function stopSVG() {
        return `<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle;margin-right:4px"><rect x="6" y="6" width="12" height="12"/></svg>`;
    }
    function setSpeakActive(btn) { btn.innerHTML = stopSVG() + 'Stop'; btn.style.color = '#e74c3c'; }
    function setSpeakIdle(btn)   { btn.innerHTML = speakerSVG() + 'Speak'; btn.style.color = ''; if (speakingBtn === btn) speakingBtn = null; }
    function applyPreferredFemaleVoice(utter) {
    const voices = speechSynthesis.getVoices();
    const preferred =
        voices.find(v => /google uk english female|zira|aria|samantha|victoria|jenny|ana/i.test(`${v.name} ${v.voiceURI}`))
        || voices.find(v => /female/i.test(v.name) && /en/i.test(v.lang))
        || voices.find(v => /en(-|_)?(US|GB)/i.test(v.lang))
        || voices[0];
    if (preferred) utter.voice = preferred;
    utter.lang = preferred?.lang || 'en-US';
    utter.pitch = 1.15;
    utter.rate = 0.96;
}
    function dotsSVG() { return `<svg viewBox="0 0 24 24"><circle cx="12" cy="5" r="2"></circle><circle cx="12" cy="12" r="2"></circle><circle cx="12" cy="19" r="2"></circle></svg>`; }
    function chatIconSVG() { return `<svg class="chat-item-icon" viewBox="0 0 24 24" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7A2.5 2.5 0 0 1 17.5 16H9l-5 4v-3.5A2.5 2.5 0 0 1 4 14z"></path></svg>`; }
    function fileIconSVG() { return `<svg class="doc-item-icon-svg" viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"></path><path d="M14 3v5h5"></path><path d="M9 13h6"></path><path d="M9 17h6"></path></svg>`; }
    function reviewerIconSVG() { return `<svg viewBox="0 0 24 24" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h12v16l-3-2-3 2-3-2-3 2z"></path><path d="M9 9h6"></path><path d="M9 13h6"></path></svg>`; }
    function trashSVG() { return `<svg viewBox="0 0 24 24"><path d="M7 9h10"></path><path d="M10 11.5v5"></path><path d="M14 11.5v5"></path><path d="M9 5h6"></path><path d="M6 7h12"></path><path d="M8 7l1 12h6l1-12"></path></svg>`; }
    function pencilSVG() { return `<svg viewBox="0 0 24 24"><path d="M4 20h4l10-10-4-4L4 16v4z"></path><path d="M13 7l4 4"></path></svg>`; }

    document.addEventListener('click', (e) => {
        if (!e.target.closest('.menu-anchor')) closeAllMenus();
    });

    document.addEventListener('DOMContentLoaded', async () => {
        // Load light mode preference
        // NEW — two-way sync with profile setting
const _lm = localStorage.getItem('lightMode');
if (_lm === 'true') {
    document.body.classList.add('light-mode');
    document.body.classList.remove('dark-mode');
} else if (_lm === 'false') {
    document.body.classList.add('dark-mode');
    document.body.classList.remove('light-mode');
}
        setupEventListeners();
        setupResizeHandles();
        syncPanelToggles();
        window.addEventListener('resize', syncPanelToggles);
        await loadChatList();
        if (activeChatId !== -1) {
            await loadChat(activeChatId);
        }
    });

    function setupEventListeners() {
        document.getElementById('btnNewChat').addEventListener('click', newChat);
        document.getElementById('btnRailBack').addEventListener('click', () => window.history.back());
        document.getElementById('btnRailNewChat').addEventListener('click', newChat);
        document.getElementById('btnSend').addEventListener('click', sendMessage);
        document.getElementById('btnAddSource').addEventListener('click', () => document.getElementById('fileInput').click());
        document.getElementById('btnRailAddDoc').addEventListener('click', () => document.getElementById('fileInput').click());
        document.getElementById('btnRailStudyGuide').addEventListener('click', () => togglePanel('right', false));
        document.getElementById('fileInput').addEventListener('change', uploadDocument);
        document.getElementById('leftPanelToggle').addEventListener('click', () => togglePanel('left'));
        document.getElementById('rightPanelToggle').addEventListener('click', () => togglePanel('right'));
        document.getElementById('txtInput').addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
        });
    }

    // ══ HORIZONTAL DRAG RESIZE ════════════════════════════
    function setupResizeHandles() {
        const panelLeft   = document.getElementById('panelLeft');
        const panelRight  = document.getElementById('panelRight');
        const handleLeft  = document.getElementById('resizeLeft');
        const handleRight = document.getElementById('resizeRight');
        makeResizable(handleLeft,  (dx) => {
            if (panelLeft.classList.contains('collapsed')) return;
            const w = panelLeft.offsetWidth + dx;
            panelLeft.style.width = Math.min(Math.max(w, 160), 420) + 'px';
            syncPanelToggles();
        });
        makeResizable(handleRight, (dx) => {
            if (panelRight.classList.contains('collapsed')) return;
            const w = panelRight.offsetWidth - dx;
            panelRight.style.width = Math.min(Math.max(w, 180), 420) + 'px';
            syncPanelToggles();
        });
        makeVerticalResizable(document.getElementById('vertResizeLeft'));
    }

    function makeResizable(handle, onDrag) {
        let startX = 0, dragging = false;
        handle.addEventListener('mousedown', (e) => { e.preventDefault(); dragging = true; startX = e.clientX; handle.classList.add('dragging'); document.body.classList.add('resizing'); });
        document.addEventListener('mousemove', (e) => { if (!dragging) return; const dx = e.clientX - startX; startX = e.clientX; onDrag(dx); syncPanelToggles(); });
        document.addEventListener('mouseup', () => { if (!dragging) return; dragging = false; handle.classList.remove('dragging'); document.body.classList.remove('resizing'); syncPanelToggles(); });
        handle.addEventListener('touchstart', (e) => { dragging = true; startX = e.touches[0].clientX; handle.classList.add('dragging'); }, { passive: true });
        document.addEventListener('touchmove', (e) => { if (!dragging) return; const dx = e.touches[0].clientX - startX; startX = e.touches[0].clientX; onDrag(dx); syncPanelToggles(); }, { passive: true });
        document.addEventListener('touchend', () => { dragging = false; handle.classList.remove('dragging'); syncPanelToggles(); });
    }

    function syncPanelToggles() {
        const panelLeft = document.getElementById('panelLeft');
        const panelRight = document.getElementById('panelRight');
        const leftBtn = document.getElementById('leftPanelToggle');
        const rightBtn = document.getElementById('rightPanelToggle');
        const leftRect = panelLeft.getBoundingClientRect();
        const rightRect = panelRight.getBoundingClientRect();
        const viewportCenter = Math.round(window.innerHeight / 2);
        const btnWidth = 34;

       leftBtn.style.top = `${viewportCenter}px`;
        rightBtn.style.top = `${viewportCenter}px`;
        leftBtn.style.left = `${Math.round(leftRect.right - btnWidth / 2)}px`;
        leftBtn.style.right = 'auto';
        rightBtn.style.left = `${Math.round(rightRect.left - btnWidth / 2)}px`;
        rightBtn.style.right = 'auto';
        leftBtn.innerHTML = panelLeft.classList.contains('collapsed')
            ? `<svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg>`
            : `<svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>`;
        rightBtn.innerHTML = panelRight.classList.contains('collapsed')
            ? `<svg viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"></path></svg>`
            : `<svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"></path></svg>`;
    }

    function togglePanel(side, forceState = null) {
        const panel = document.getElementById(side === 'left' ? 'panelLeft' : 'panelRight');
        const collapsed = forceState === null ? !panel.classList.contains('collapsed') : forceState;
        panel.classList.toggle('collapsed', collapsed);
        syncPanelToggles();
    }

    // ══ CHAT LIST ════════════════════════════════════════
    async function loadChatList() {
        if (activeFolderId === -1) return;
        try {
            const res = await fetch(`/Chat/GetChatsInProject?projectId=${activeFolderId}`);
            const chats = await res.json();
            const list = document.getElementById('chatList');
            list.innerHTML = '';
            chats.forEach(c => list.appendChild(makeChatItem(c.id, c.title)));
            renderCollapsedChatRail(chats);
            if (activeChatId !== -1) setActiveChatItem(activeChatId);
        } catch (err) { console.error('loadChatList error:', err); }
    }

    function makeChatItem(id, title) {
        const el = document.createElement('div');
        el.className = 'chat-item';
        el.dataset.id = String(id);
        el.innerHTML = `
            <div class="chat-item-main">
                ${chatIconSVG()}
                <span class="chat-item-title">${escHtml(title)}</span>
            </div>
            <div class="menu-anchor" style="position:relative;">
                <button class="btn-more-chat" type="button" title="More options">${dotsSVG()}</button>
            </div>
        `;
        el.addEventListener('click', () => loadChat(id));
        el.querySelector('.btn-more-chat').addEventListener('click', (e) => {
            e.stopPropagation();
            toggleContextMenu(el.querySelector('.menu-anchor'), [
                { label: 'Rename', icon: pencilSVG(), onClick: () => openRenameChatModal(id, el.querySelector('.chat-item-title')?.textContent || title) },
                { label: 'Delete', icon: trashSVG(), danger: true, onClick: () => confirmDeleteChat(id, el.querySelector('.chat-item-title')?.textContent || title) }
            ]);
        });
        return el;
    }

    function addChatItemToTop(id, title) {
        const list = document.getElementById('chatList');
        document.querySelector(`.chat-item[data-id="${id}"]`)?.remove();
        list.prepend(makeChatItem(id, title));
        renderCollapsedChatRail([...document.querySelectorAll('.chat-item')].map(item => ({
            id: parseInt(item.dataset.id),
            title: item.querySelector('.chat-item-title')?.textContent || 'Chat'
        })));
    }

    function updateChatItemTitle(id, title) {
        const el = document.querySelector(`.chat-item[data-id="${id}"] .chat-item-title`);
        if (el) el.textContent = title;
        renderCollapsedChatRail([...document.querySelectorAll('.chat-item')].map(item => ({
            id: parseInt(item.dataset.id),
            title: item.querySelector('.chat-item-title')?.textContent || 'Chat'
        })));
    }

    function setActiveChatItem(id) {
        document.querySelectorAll('.chat-item').forEach(el =>
            el.classList.toggle('active', el.dataset.id === String(id)));
        document.querySelectorAll('#collapsedChatRail .rail-icon-btn[data-chat-id]').forEach(el =>
            el.style.borderColor = el.dataset.chatId === String(id) ? 'var(--accent)' : '#d7caeb');
    }

    function renderCollapsedChatRail(chats) {
        const rail = document.getElementById('collapsedChatRail');
        if (!rail) return;
        rail.innerHTML = '';
        chats.slice(0, 8).forEach(chat => {
            const btn = document.createElement('button');
            btn.className = 'rail-icon-btn';
            btn.dataset.chatId = String(chat.id);
            btn.title = chat.title;
            btn.innerHTML = chatIconSVG();
            btn.onclick = () => loadChat(chat.id);
            rail.appendChild(btn);
        });
        if (activeChatId !== -1) setActiveChatItem(activeChatId);
    }

    async function newChat() {
        try {
            const res = await fetch('/Chat/NewChatInProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ folderId: activeFolderId })
            });
            const data = await res.json();
            addChatItemToTop(data.id, data.title);
            await loadChat(data.id);
        } catch (err) { alert('Error: ' + err.message); }
