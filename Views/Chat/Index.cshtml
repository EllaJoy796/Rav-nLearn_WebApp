        // ── Score row ──
        const scoreRow = document.createElement('div');
        scoreRow.style.cssText = 'display:flex;justify-content:space-between;font-size:10px;color:#555;margin-top:2px;';
        const knownEl   = document.createElement('span');
        const unknownEl = document.createElement('span');
        knownEl.style.color   = '#6dbf6d';
        unknownEl.style.color = '#e07070';
        scoreRow.appendChild(knownEl);
        scoreRow.appendChild(unknownEl);

        // ── Render card ──
        function renderCard() {
            const c = cards[current];
            // Reset flip
            flipped = false;
            cardInner.style.transform = '';
            frontText.textContent = c.front;
            backText.textContent  = c.back;
            counter.textContent   = `${current + 1} / ${cards.length}`;
            progressBar.style.width = `${((current + 1) / cards.length) * 100}%`;
            btnPrev.disabled = current === 0;
            btnPrev.style.opacity = current === 0 ? '0.3' : '1';
            btnNext.disabled = current === cards.length - 1;
            btnNext.style.opacity = current === cards.length - 1 ? '0.3' : '1';
            knownEl.textContent   = known   ? `✓ ${known} known`   : '';
            unknownEl.textContent = unknown ? `✗ ${unknown} learning` : '';
        }

        btnFlip.addEventListener('click', () => {
            flipped = !flipped;
            cardInner.style.transform = flipped ? 'rotateY(180deg)' : '';
        });
        btnPrev.addEventListener('click', () => { if (current > 0) { current--; renderCard(); } });
        btnNext.addEventListener('click', () => { if (current < cards.length - 1) { current++; renderCard(); } });

        btnKnow.addEventListener('click', () => {
            known++;
            if (current < cards.length - 1) { current++; renderCard(); }
            else renderCard();
        });
        btnDontKnow.addEventListener('click', () => {
            unknown++;
            if (current < cards.length - 1) { current++; renderCard(); }
            else renderCard();
        });

        // ── Keyboard nav ──
        const keyHandler = (e) => {
            if (!body.closest('body')) { document.removeEventListener('keydown', keyHandler); return; }
            if (e.key === 'ArrowRight' && current < cards.length - 1) { current++; renderCard(); }
            if (e.key === 'ArrowLeft'  && current > 0)                { current--; renderCard(); }
            if (e.key === ' ') { e.preventDefault(); btnFlip.click(); }
        };
        document.addEventListener('keydown', keyHandler);

        navRow.appendChild(btnPrev);
        navRow.appendChild(btnFlip);
        navRow.appendChild(btnNext);
        knowRow.appendChild(btnKnow);
        knowRow.appendChild(btnDontKnow);

        body.appendChild(counter);
        body.appendChild(progressWrap);
        body.appendChild(cardWrap);
        body.appendChild(navRow);
        body.appendChild(knowRow);
        body.appendChild(scoreRow);

        renderCard();
        return body;
    }

</script>

</body>
</html>