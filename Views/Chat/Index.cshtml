    function autoResize(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 120) + 'px'; }
    function escHtml(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    // ══ MODAL ════════════════════════════════════════════
    function openReviewerModal(label, parsed, card) {
        lastReviewerPayload = { label, parsed, card };
        openQuizModal(label, parsed, card);
    }

    function openRenameReviewerModal(sessionId, card) {
        openActionModal({
            title: 'Rename Reviewer',
            copy: 'Enter a new reviewer name.',
            value: card.dataset.label || 'Reviewer',
            confirmLabel: 'Save',
            confirmClass: 'primary',
            onConfirm: async (newName) => {
                if (!newName) return false;
                const res = await fetch('/Chat/RenameQuizSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, name: newName })
                });
                if (!res.ok) return false;
                card.dataset.label = newName;
                const nameEl = card.querySelector('.reviewer-name');
                if (nameEl) nameEl.textContent = newName;
                return true;
            }
        });
    }

    function confirmDeleteReviewer(sessionId, card) {
        openActionModal({
            title: 'Delete Reviewer',
            copy: `Delete "${card.dataset.label || 'Reviewer'}" permanently?`,
            confirmLabel: 'Delete',
            confirmClass: 'danger',
            hideInput: true,
            onConfirm: async () => {
                const res = await fetch(`/Chat/DeleteQuizSession/${sessionId}`, { method: 'DELETE' });
                if (!res.ok) return false;
                // Remove all cards with this sessionId (quiz, flashcard, etc.)
                document.querySelectorAll(`.quiz-card[data-session-id="${sessionId}"]`).forEach(c => c.remove());
                return true;
            }
        });
