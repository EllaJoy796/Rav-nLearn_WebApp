@{
    ViewData["Title"] = "My Chats";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn - My Chats</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:            #0d0d12;
            --sidebar-bg:    #111118;
            --sidebar-width: 72px;
            --sidebar-expanded: 220px;
            --card-bg:       #1e1a2e;
            --card-hover:    #251f3a;
            --card-new-bg:   #16132a;
            --accent:        #7c5cbf;
            --accent-soft:   rgba(124, 92, 191, 0.18);
            --accent-chip:   #5a3f9e;
            --text-white:    #f0eeff;
            --text-muted:    #7a7490;
            --text-dim:      #4e4868;
            --border:        rgba(124, 92, 191, 0.12);
            --icon-bg:       rgba(124, 92, 191, 0.22);
            --topbar-h:      64px;
        }

        /* ── LIGHT MODE ── */
        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --card-new-bg: #e8e4f8;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
            --icon-bg:     rgba(124,92,191,.15);
        }
        body.light-mode .search-bar input { background: #edeaf8; border-color: rgba(124,92,191,.3); color: var(--text-white); }
        body.light-mode .search-bar .search-icon svg { stroke: var(--text-muted); }
        body.light-mode .modal,
        body.light-mode .delete-modal { background: #f4f3ff; }
        body.light-mode .field-input  { background: #edeaf8; color: var(--text-white); }
        body.light-mode .ctx-menu     { background: #f4f3ff; }
        body.light-mode .nav-item     { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }
        body.light-mode .filter-select { background: #edeaf8; border-color: rgba(124,92,191,.3); color: var(--text-white); }
        body.light-mode .filter-select:hover { border-color: var(--accent); }

        html, body { height: 100%; background-color: var(--bg); font-family: 'DM Sans', sans-serif; color: var(--text-white); overflow: hidden; }
        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ── SIDEBAR ── */
        .sidebar { width: var(--sidebar-width); background: var(--sidebar-bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: flex-start; padding: 16px 0; flex-shrink: 0; z-index: 100; overflow: hidden; transition: width 0.25s ease; position: relative; }
        .sidebar:hover { width: var(--sidebar-expanded); }
        .sidebar-logo { width: 100%; display: flex; align-items: center; gap: 10px; padding: 0 15px; margin-bottom: 28px; flex-shrink: 0; overflow: hidden; }
        .logo-icon { width: 42px; height: 42px; min-width: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 800; color: var(--text-white); white-space: nowrap; opacity: 0; transition: opacity 0.2s ease 0.05s; }
        .sidebar:hover .logo-text { opacity: 1; }
        .nav-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }
        .nav-group + .nav-group { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border); }
        .nav-group-label { font-size: 10px; font-weight: 700; color: var(--text-dim); letter-spacing: 0.8px; text-transform: uppercase; padding: 0 4px; margin-bottom: 6px; white-space: nowrap; opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.2s ease, max-height 0.2s ease; }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }
        .nav-item { width: 100%; height: 44px; border-radius: 10px; display: flex; align-items: center; gap: 12px; padding: 0 11px; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; color: white; text-decoration: none; overflow: hidden; white-space: nowrap; }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg { width: 20px; height: 20px; min-width: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .nav-label { font-size: 13px; font-weight: 600; opacity: 0; transition: opacity 0.2s ease 0.05s; overflow: hidden; }
        .sidebar:hover .nav-label { opacity: 1; }
        .nav-item::after { content: attr(data-tip); position: absolute; left: 82px; background: #1e1e2e; color: var(--text-white); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.15s ease; border: 1px solid var(--border); z-index: 200; }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }
        .sidebar-bottom { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }

        /* ── MAIN ── */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
        .topbar { height: var(--topbar-h); display: flex; align-items: center; gap: 16px; padding: 0 28px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
        .page-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 900; color: var(--text-white); letter-spacing: -0.3px; white-space: nowrap; }
        
       .filters-group { display: flex; align-items: center; gap: 12px; min-width: 600px; }
        .search-bar { width: 360px; position: relative; }
        .search-bar input { width: 100%; height: 40px; background: #1a1726; border: 1px solid white; border-radius: 10px; padding: 0 16px 0 40px; color: var(--text-white); font-size: 13px; font-family: inherit; outline: none; transition: border-color 0.2s ease; }
        .search-bar input:focus { border-color: var(--accent); }
        .search-bar input::placeholder { color: var(--text-dim); }
        .search-bar .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); }
        .search-bar .search-icon svg { width: 16px; height: 16px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        .filter-select { height: 40px; background: #1a1726; border: 1px solid rgba(124,92,191,0.25); border-radius: 10px; padding: 0 36px 0 14px; color: var(--text-white); font-size: 13px; font-family: inherit; outline: none; cursor: pointer; transition: border-color 0.2s ease; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%237a7490' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 12px center; min-width: 110px; }
        .filter-select:hover { border-color: var(--accent); }
        .filter-select:focus { border-color: var(--accent); }

        /* ── CONTENT ── */
        .content { flex: 1; overflow-y: auto; padding: 32px 28px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        .section-label { font-size: 13px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 20px; }

        /* ── GRID ── */
        .chats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

        /* ── NEW CHAT CARD ── */
        .card-new { background: var(--card-new-bg); border: 1.5px dashed rgba(124,92,191,0.3); border-radius: 16px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; cursor: pointer; min-height: 170px; transition: border-color 0.2s ease, background 0.2s ease; text-decoration: none; animation: fadeUp 0.4s ease both; }
        .card-new:hover { border-color: var(--accent); background: rgba(124,92,191,0.07); }
        .card-new .plus-icon { width: 44px; height: 44px; border: 1.5px solid rgba(124,92,191,0.4); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 24px; font-weight: 300; line-height: 1; transition: background 0.2s ease, border-color 0.2s ease; }
        .card-new:hover .plus-icon { background: var(--accent-soft); border-color: var(--accent); }
        .card-new span { font-size: 13px; font-weight: 600; color: var(--text-muted); }

        /* ── CHAT CARD ── */
        .card-chat { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; padding: 18px 18px 14px; display: flex; flex-direction: column; gap: 10px; cursor: pointer; position: relative; min-height: 170px; transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease; animation: fadeUp 0.4s ease both; }
        .card-chat:hover { background: var(--card-hover); border-color: rgba(124,92,191,0.3); transform: translateY(-2px); }
        .card-top-row { display: flex; align-items: flex-start; justify-content: space-between; }
        .chat-icon { width: 42px; height: 42px; background: var(--icon-bg); border-radius: 12px; display: flex; align-items: center; justify-content: center; color: var(--accent); flex-shrink: 0; }
        .chat-icon svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .btn-more { background: none; border: none; cursor: pointer; color: var(--text-dim); border-radius: 6px; display: flex; flex-direction: column; gap: 3px; align-items: center; transition: color 0.2s ease, background 0.2s ease; padding: 16px; }
        .btn-more:hover { color: var(--text-muted); background: var(--accent-soft); }
        .btn-more span { width: 3px; height: 3px; background: currentColor; border-radius: 50%; display: block; }
        .card-body { flex: 1; }
        .chat-name { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text-white); letter-spacing: 0.3px; margin-bottom: 8px; }
        .chip { display: inline-block; padding: 3px 10px; background: var(--accent-chip); border-radius: 20px; font-size: 10px; font-weight: 700; color: #c8b8f0; letter-spacing: 0.5px; text-transform: uppercase; }
        .chip.empty { display: none; }
        .card-meta { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 10px; margin-top: auto; }
        .meta-item { display: flex; align-items: center; gap: 5px; color: var(--text-dim); font-size: 11px; }
        .meta-item svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

        /* ── CONTEXT MENU ── */
        .ctx-menu { position: fixed; background: #1e1a2e; border: 1px solid rgba(124,92,191,0.25); border-radius: 10px; padding: 6px; min-width: 150px; z-index: 999; box-shadow: 0 8px 24px rgba(0,0,0,0.4); display: none; }
        .ctx-menu.visible { display: block; }
        .ctx-item { padding: 8px 12px; border-radius: 6px; font-size: 13px; cursor: pointer; color: var(--text-muted); transition: background 0.15s, color 0.15s; display: flex; align-items: center; gap: 8px; }
        .ctx-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .ctx-item.danger { color: #e07070; }
        .ctx-item.danger:hover { background: rgba(224,112,112,0.12); }

        /* ── EMPTY STATE ── */
        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--text-dim); text-align: center; }
        .empty-state svg { width: 48px; height: 48px; stroke: var(--text-dim); fill: none; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; opacity: 0.5; }
        .empty-state p { font-size: 14px; }

        /* ── MODAL OVERLAY ── */
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 500; display: none; align-items: center; justify-content: center; }
        .modal-overlay.open { display: flex; }
        .modal { background: #1a1626; border: 1px solid rgba(124,92,191,0.25); border-radius: 20px; padding: 32px; width: min(420px, 90vw); box-shadow: 0 24px 60px rgba(0,0,0,0.5); animation: modalIn 0.2s ease; }
        @@keyframes modalIn { from { opacity: 0; transform: scale(0.95) translateY(10px); } to { opacity: 1; transform: none; } }
        .modal-title { font-family: 'Syne', sans-serif; font-size: 18px; font-weight: 800; color: var(--text-white); margin-bottom: 6px; }
        .modal-sub { font-size: 13px; color: var(--text-muted); margin-bottom: 24px; }
        .field-label { font-size: 11px; font-weight: 700; color: var(--text-muted); letter-spacing: 0.6px; text-transform: uppercase; margin-bottom: 7px; display: block; }
        .field-input { width: 100%; height: 44px; background: #0f0d1a; border: 1px solid rgba(124,92,191,0.2); border-radius: 10px; padding: 0 14px; color: var(--text-white); font-size: 14px; font-family: inherit; outline: none; transition: border-color 0.2s; margin-bottom: 16px; }
        .field-input:focus { border-color: var(--accent); }
        .field-input::placeholder { color: var(--text-dim); }
        .modal-actions { display: flex; gap: 10px; margin-top: 8px; }
        .btn-cancel { flex: 1; height: 44px; background: none; border: 1px solid rgba(124,92,191,0.2); border-radius: 10px; color: var(--text-muted); font-size: 14px; font-weight: 600; font-family: inherit; cursor: pointer; transition: border-color 0.2s, color 0.2s; }
        .btn-cancel:hover { border-color: var(--accent); color: var(--text-white); }
        .btn-create { flex: 2; height: 44px; background: var(--accent); border: none; border-radius: 10px; color: #fff; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; transition: background 0.2s; }
        .btn-create:hover { background: #6b4daa; }
        .btn-create:disabled { background: #3a3050; color: var(--text-dim); cursor: not-allowed; }
        .error-msg { font-size: 12px; color: #e07070; margin-top: -10px; margin-bottom: 12px; display: none; }
        .error-msg.visible { display: block; }

        /* ── DELETE CONFIRM MODAL ── */
        .delete-modal { background: #1a1626; border: 1px solid rgba(224,112,112,0.2); border-radius: 20px; padding: 32px; width: min(380px, 90vw); box-shadow: 0 24px 60px rgba(0,0,0,0.5); animation: modalIn 0.2s ease; }
        .delete-modal .modal-title { color: #e07070; }
        .btn-delete-confirm { flex: 2; height: 44px; background: #c0392b; border: none; border-radius: 10px; color: #fff; font-size: 14px; font-weight: 700; font-family: inherit; cursor: pointer; transition: background 0.2s; }
        .btn-delete-confirm:hover { background: #a93226; }
        .btn-delete-confirm:disabled { background: #5a2a2a; color: #888; cursor: not-allowed; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar { width: 100% !important; flex-direction: row; height: 56px; padding: 0 16px; border-right: none; border-bottom: 1px solid var(--border); }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .chats-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
            .filters-group { flex-wrap: wrap; }
            .search-bar { max-width: 100%; flex: 1 1 100%; }
            .filter-select { flex: 1; min-width: 120px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png" alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item active" href="/Chat/MyChats" data-tip="My Chats">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">My Chats</span>
            </a>
            <a class="nav-item" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Support/HowToUse" data-tip="How to use"> 
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>
        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="Profile"
               style="height:auto; padding:8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main">
        <header class="topbar">
            <span class="page-title">My Chats</span>
            <div style="flex:1;"></div>
            <div class="filters-group" style="flex:0; justify-content:flex-end;">
                <div class="search-bar">
                    <span class="search-icon">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </span>
                    <input type="text" placeholder="Search chats..." id="searchInput" oninput="applyFilters()" />
                </div>
                <select class="filter-select" id="filterDate" onchange="applyFilters()">
                    <option value="">All Dates</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                    <option value="older">Older</option>
                </select>
                <select class="filter-select" id="filterTag" onchange="applyFilters()">
                    <option value="">All Tags</option>
                </select>
            </div>
        </header>

        <div class="content">
            <div class="section-label">Recent chats</div>
            <div class="chats-grid" id="chatsGrid">
                <div class="card-new" id="cardNew" onclick="openModal()">
                    <div class="plus-icon">+</div>
                    <span>New chat</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── CREATE CHAT MODAL ── -->
<div class="modal-overlay" id="modalOverlay" onclick="handleOverlayClick(event)">
    <div class="modal">
        <div class="modal-title">New Chat</div>
        <div class="modal-sub">Give your chat folder a name and subject tag.</div>

        <label class="field-label" for="inputName">Chat name</label>
        <input class="field-input" id="inputName" type="text"
               placeholder="e.g. Linux Reviewer" maxlength="100"
               oninput="validateForm()" onkeydown="handleModalKey(event)" />
        <div class="error-msg" id="errorName">Please enter a name.</div>

        <label class="field-label" for="inputSubject">Subject tag</label>
        <input class="field-input" id="inputSubject" type="text"
               placeholder="e.g. OS102" maxlength="50"
               onkeydown="handleModalKey(event)" />

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeModal()">Cancel</button>
            <button class="btn-create" id="btnCreate" onclick="createChat()" disabled>Create</button>
        </div>
    </div>
</div>

<!-- ── RENAME MODAL ── -->
<div class="modal-overlay" id="renameOverlay" onclick="handleRenameOverlayClick(event)">
    <div class="modal">
        <div class="modal-title">Rename Chat</div>
        <div class="modal-sub">Enter a new name for this chat folder.</div>

        <label class="field-label" for="renameInput">New name</label>
        <input class="field-input" id="renameInput" type="text"
               placeholder="e.g. Linux Reviewer" maxlength="100"
               oninput="validateRenameForm()" onkeydown="handleRenameKey(event)" />
        <div class="error-msg" id="renameError">Please enter a name.</div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeRenameModal()">Cancel</button>
            <button class="btn-create" id="btnRename" onclick="submitRename()" disabled>Save</button>
        </div>
    </div>
</div>

<!-- ── DELETE CONFIRM MODAL ── -->
<div class="modal-overlay" id="deleteOverlay" onclick="handleDeleteOverlayClick(event)">
    <div class="delete-modal">
        <div class="modal-title">Delete Chat?</div>
        <div class="modal-sub" id="deleteModalSub">This will permanently delete this chat and all its messages, files, and quizzes. This cannot be undone.</div>

        <div class="modal-actions">
            <button class="btn-cancel" onclick="closeDeleteModal()">Cancel</button>
            <button class="btn-delete-confirm" id="btnDeleteConfirm" onclick="submitDelete()">Delete</button>
        </div>
    </div>
</div>

<!-- ── CONTEXT MENU ── -->
<div class="ctx-menu" id="ctxMenu">
    <div class="ctx-item" onclick="ctxRename()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Rename
    </div>
    <div class="ctx-item danger" onclick="ctxDelete()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v6M14 11v6"/>
        </svg>
        Delete
    </div>
</div>

<!-- ── LOGOUT MODAL ── -->
<div id="logoutModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:16px; padding:28px 28px 24px;
        width:340px; text-align:center; font-family:'DM Sans',sans-serif;">
        <div style="width:48px; height:48px; border-radius:14px;
            background:rgba(220,60,60,.12); display:flex; align-items:center;
            justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Syne',sans-serif; font-size:16px; font-weight:800;
                    color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            Are you sure you want to log out of Rev'nLearn?
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border);
                       background:transparent; color:var(--text-white);
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">
                Cancel
            </button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none;
                       background:#c0392b; color:#fff; text-decoration:none;
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer; display:flex; align-items:center; justify-content:center;">
                Yes, Log Out
            </a>
        </div>
    </div>
</div>

<script>
    /* ── THEME INIT: apply before paint to avoid flash ── */
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();

    let ctxChatId   = null;
    let ctxChatName = '';
    let allChats    = [];

    // ── LOAD CHATS ────────────────────────────────────────
    document.addEventListener('DOMContentLoaded', loadChats);

    async function loadChats() {
        try {
            const res   = await fetch('/Chat/GetMyProjects');
            const chats = await res.json();
            allChats    = chats;
            const grid  = document.getElementById('chatsGrid');

            grid.querySelectorAll('.card-chat, .empty-state').forEach(c => c.remove());

            if (chats.length === 0) {
                showEmptyState();
                return;
            }

            // Populate tag filter dropdown
            populateTagFilter(chats);

            chats.forEach((chat, i) => grid.appendChild(makeCard(chat, i)));
        } catch (err) { console.error('Failed to load chats:', err); }
    }

    function populateTagFilter(chats) {
        const tagSet = new Set();
        chats.forEach(chat => {
            if (chat.subject && chat.subject.trim()) {
                tagSet.add(chat.subject.trim());
            }
        });

        const filterTag = document.getElementById('filterTag');
        // Clear existing options except "All Tags"
        filterTag.innerHTML = '<option value="">All Tags</option>';
        
        // Add sorted tags
        Array.from(tagSet).sort().forEach(tag => {
            const option = document.createElement('option');
            option.value = tag.toLowerCase();
            option.textContent = tag;
            filterTag.appendChild(option);
        });
    }

    function makeCard(chat, index) {
        const card = document.createElement('div');
        card.className   = 'card-chat';
        card.dataset.id      = chat.id;
        card.dataset.name    = chat.name.toLowerCase();
        card.dataset.subject = (chat.subject || '').toLowerCase();
        card.dataset.date    = chat.date; // Store original date string
        card.dataset.timestamp = parseDateToTimestamp(chat.date); // Store as comparable timestamp
        card.style.animationDelay = `${index * 0.05}s`;
        card.onclick = () => openChat(chat.id);

        card.innerHTML = `
            <div class="card-top-row">
                <div class="chat-icon">
                    <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                </div>
                <button class="btn-more" title="Options">
                    <span></span><span></span><span></span>
                </button>
            </div>
            <div class="card-body">
                <div class="chat-name">${escHtml(chat.name.toUpperCase())}</div>
                <span class="chip ${!chat.subject ? 'empty' : ''}">${escHtml(chat.subject || '')}</span>
            </div>
            <div class="card-meta">
                <div class="meta-item">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    ${escHtml(chat.date)}
                </div>
                <div class="meta-item">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    ${chat.fileCount} ${chat.fileCount === 1 ? 'File' : 'Files'}
                </div>
            </div>`;

        card.querySelector('.btn-more').addEventListener('click', (e) => {
            e.stopPropagation();
            showContextMenu(e, chat.id, chat.name);
        });

        return card;
    }

    function parseDateToTimestamp(dateStr) {
        // Parse date strings like "Jan 15, 2024" to timestamp
        const date = new Date(dateStr);
        return date.getTime();
    }

    function getDateCategory(timestamp) {
        const now = new Date();
        const chatDate = new Date(timestamp);
        
        // Reset time to compare only dates
        now.setHours(0, 0, 0, 0);
        chatDate.setHours(0, 0, 0, 0);
        
        const diffTime = now - chatDate;
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        
        if (diffDays === 0) return 'today';
        if (diffDays <= 7) return 'week';
        if (diffDays <= 30) return 'month';
        return 'older';
    }

    function openChat(id) { window.location.href = `/Chat/Open/${id}`; }

    // ── FILTERS ───────────────────────────────────────────
    function applyFilters() {
        const searchQuery = document.getElementById('searchInput').value.toLowerCase();
        const dateFilter = document.getElementById('filterDate').value;
        const tagFilter = document.getElementById('filterTag').value;

        let visibleCount = 0;

        document.querySelectorAll('.card-chat').forEach(card => {
            const name = card.dataset.name;
            const subject = card.dataset.subject;
            const timestamp = parseInt(card.dataset.timestamp);
            const dateCategory = getDateCategory(timestamp);

            // Check search match
            const searchMatch = !searchQuery || name.includes(searchQuery) || subject.includes(searchQuery);

            // Check date filter match
            const dateMatch = !dateFilter || dateCategory === dateFilter;

            // Check tag filter match
            const tagMatch = !tagFilter || subject === tagFilter;

            // Show card if all filters match
            if (searchMatch && dateMatch && tagMatch) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Show/hide empty state
        const emptyState = document.getElementById('emptyState');
        if (visibleCount === 0 && !emptyState) {
            showEmptyState('No chats match your filters.');
        } else if (visibleCount > 0 && emptyState) {
            emptyState.remove();
        }
    }

    function showEmptyState(message) {
        const grid = document.getElementById('chatsGrid');
        const existing = document.getElementById('emptyState');
        if (existing) existing.remove();

        const empty = document.createElement('div');
        empty.className = 'empty-state';
        empty.id = 'emptyState';
        empty.innerHTML = `
            <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <p>${message || 'No chats yet.<br>Click <strong>New chat</strong> to get started.'}</p>`;
        grid.appendChild(empty);
    }

    // ── CREATE MODAL ──────────────────────────────────────
    function openModal() {
        document.getElementById('inputName').value    = '';
        document.getElementById('inputSubject').value = '';
        document.getElementById('errorName').classList.remove('visible');
        document.getElementById('btnCreate').disabled = true;
        document.getElementById('modalOverlay').classList.add('open');
        setTimeout(() => document.getElementById('inputName').focus(), 100);
    }
    function closeModal() { document.getElementById('modalOverlay').classList.remove('open'); }
    function handleOverlayClick(e) { if (e.target === document.getElementById('modalOverlay')) closeModal(); }
    function handleModalKey(e) {
        if (e.key === 'Escape') closeModal();
        if (e.key === 'Enter' && !document.getElementById('btnCreate').disabled) createChat();
    }
    function validateForm() {
        const name = document.getElementById('inputName').value.trim();
        document.getElementById('btnCreate').disabled = name.length === 0;
        document.getElementById('errorName').classList.remove('visible');
    }

    async function createChat() {
        const name    = document.getElementById('inputName').value.trim();
        const subject = document.getElementById('inputSubject').value.trim();
        if (!name) { document.getElementById('errorName').classList.add('visible'); return; }

        const btn = document.getElementById('btnCreate');
        btn.disabled = true; btn.textContent = 'Creating…';
        try {
            const res  = await fetch('/Chat/CreateProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name, subject })
            });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }
            closeModal();
            await loadChats();
        } catch (err) { alert('Network error: ' + err.message); }
        finally { btn.disabled = false; btn.textContent = 'Create'; }
    }

    // ── RENAME MODAL ──────────────────────────────────────
    function openRenameModal(id, currentName) {
        ctxChatId = id;
        const input = document.getElementById('renameInput');
        input.value = currentName;
        document.getElementById('renameError').classList.remove('visible');
        document.getElementById('btnRename').disabled = false;
        document.getElementById('renameOverlay').classList.add('open');
        setTimeout(() => { input.focus(); input.select(); }, 100);
    }
    function closeRenameModal() { document.getElementById('renameOverlay').classList.remove('open'); }
    function handleRenameOverlayClick(e) { if (e.target === document.getElementById('renameOverlay')) closeRenameModal(); }
    function handleRenameKey(e) {
        if (e.key === 'Escape') closeRenameModal();
        if (e.key === 'Enter' && !document.getElementById('btnRename').disabled) submitRename();
    }
    function validateRenameForm() {
        const val = document.getElementById('renameInput').value.trim();
        document.getElementById('btnRename').disabled = val.length === 0;
        document.getElementById('renameError').classList.remove('visible');
    }

    async function submitRename() {
        const newName = document.getElementById('renameInput').value.trim();
        if (!newName) { document.getElementById('renameError').classList.add('visible'); return; }

        const btn = document.getElementById('btnRename');
        btn.disabled = true; btn.textContent = 'Saving…';
        try {
            const res  = await fetch('/Chat/RenameProject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: ctxChatId, name: newName })
            });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }

            // Update card in-place without full reload
            const card = document.querySelector(`.card-chat[data-id="${ctxChatId}"]`);
            if (card) {
                card.dataset.name = newName.toLowerCase();
                const nameEl = card.querySelector('.chat-name');
                if (nameEl) nameEl.textContent = newName.toUpperCase();
            }
            closeRenameModal();
        } catch (err) { alert('Network error: ' + err.message); }
        finally { btn.disabled = false; btn.textContent = 'Save'; }
    }

    // ── DELETE CONFIRM MODAL ──────────────────────────────
    function openDeleteModal(id, name) {
        ctxChatId = id;
        document.getElementById('deleteModalSub').textContent =
            `"${name}" and all its messages, files, and quizzes will be permanently deleted. This cannot be undone.`;
        document.getElementById('deleteOverlay').classList.add('open');
    }
    function closeDeleteModal() { document.getElementById('deleteOverlay').classList.remove('open'); }
    function handleDeleteOverlayClick(e) { if (e.target === document.getElementById('deleteOverlay')) closeDeleteModal(); }

    async function submitDelete() {
        if (!ctxChatId) return;
        const btn = document.getElementById('btnDeleteConfirm');
        btn.disabled = true; btn.textContent = 'Deleting…';
        try {
            const res  = await fetch(`/Chat/DeleteProject/${ctxChatId}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }

            // Remove card from grid
            document.querySelector(`.card-chat[data-id="${ctxChatId}"]`)?.remove();
            ctxChatId = null;
            closeDeleteModal();

            // Reapply filters
            applyFilters();

            // Show empty state if no cards left
            const remaining = document.querySelectorAll('.card-chat');
            if (remaining.length === 0) {
                showEmptyState();
            }
        } catch (err) { alert('Network error: ' + err.message); }
        finally { btn.disabled = false; btn.textContent = 'Delete'; }
    }

    // ── CONTEXT MENU ──────────────────────────────────────
    function showContextMenu(e, chatId, chatName) {
        ctxChatId   = chatId;
        ctxChatName = chatName;
        const menu  = document.getElementById('ctxMenu');
        menu.classList.add('visible');
        const x = Math.min(e.clientX, window.innerWidth - 170);
        const y = Math.min(e.clientY + 4, window.innerHeight - 100);
        menu.style.left = x + 'px';
        menu.style.top  = y + 'px';
    }

    function hideContextMenu() { document.getElementById('ctxMenu').classList.remove('visible'); }

    document.addEventListener('click', hideContextMenu);
    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') { hideContextMenu(); closeModal(); closeRenameModal(); closeDeleteModal(); }
    });

    function ctxRename() {
        hideContextMenu();
        openRenameModal(ctxChatId, ctxChatName);
    }

    function ctxDelete() {
        hideContextMenu();
        openDeleteModal(ctxChatId, ctxChatName);
    }

    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
</script>
</body>
</html>
