@{
    ViewData["Title"] = "My Quizzes";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn - My Quizzes</title>
    <link rel="icon" type="image/png" href="/images/logo sa taas.png?v=999&t=@DateTime.Now.Ticks" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:            #0d0d12;
            --sidebar-bg:    #111118;
            --sidebar-width: 72px;
            --sidebar-expanded: 220px;
            --card-bg:       #1e1a2e;
            --card-hover:    #251f3a;
            --accent:        #7c5cbf;
            --accent-soft:   rgba(124, 92, 191, 0.18);
            --accent-chip:   #5a3f9e;
            --text-white:    #f0eeff;
            --text-muted:    #7a7490;
            --text-dim:      #4e4868;
            --border:        rgba(124, 92, 191, 0.12);
            --icon-bg:       rgba(124, 92, 191, 0.22);
            --topbar-h:      64px;
        }

        /* ── LIGHT MODE ── */
        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
            --icon-bg:     rgba(124,92,191,.15);
        }
        body.light-mode .search-bar input { background: #edeaf8; border-color: rgba(124,92,191,.3); color: var(--text-white); }
        body.light-mode .search-bar .search-icon svg { stroke: var(--text-muted); }
        body.light-mode .nav-item { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }
        body.light-mode .ctx-menu { background: #f4f3ff; }
        body.light-mode .filter-select { background: #edeaf8; border-color: rgba(124,92,191,.3); color: var(--text-white); }
        body.light-mode .filter-select:hover { border-color: var(--accent); }

        html, body { height: 100%; background-color: var(--bg); font-family: 'Poppins', sans-serif; color: var(--text-white); overflow: hidden; }
        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ── SIDEBAR ── */
        .sidebar { width: var(--sidebar-width); background: var(--sidebar-bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: flex-start; padding: 16px 0; flex-shrink: 0; z-index: 100; overflow: hidden; transition: width 0.25s ease; position: relative; }
        .sidebar:hover { width: var(--sidebar-expanded); }
        .sidebar-logo { width: 100%; display: flex; align-items: center; gap: 10px; padding: 0 15px; margin-bottom: 28px; flex-shrink: 0; overflow: hidden; }
        .logo-icon { width: 42px; height: 42px; min-width: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text { font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 800; color: var(--text-white); white-space: nowrap; opacity: 0; transition: opacity 0.2s ease 0.05s; }
        .sidebar:hover .logo-text { opacity: 1; }
        .nav-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }
        .nav-group + .nav-group { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border); }
        .nav-group-label { font-size: 10px; font-weight: 700; color: var(--text-dim); letter-spacing: 0.8px; text-transform: uppercase; padding: 0 4px; margin-bottom: 6px; white-space: nowrap; opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.2s ease, max-height 0.2s ease; }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }
        .nav-item { width: 100%; height: 44px; border-radius: 10px; display: flex; align-items: center; gap: 12px; padding: 0 11px; cursor: pointer; transition: background 0.2s ease, color 0.2s ease; color: white; text-decoration: none; overflow: hidden; white-space: nowrap; }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg { width: 20px; height: 20px; min-width: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .nav-label { font-size: 13px; font-weight: 600; opacity: 0; transition: opacity 0.2s ease 0.05s; }
        .sidebar:hover .nav-label { opacity: 1; }
        .nav-item::after { content: attr(data-tip); position: absolute; left: 82px; background: #1e1e2e; color: var(--text-white); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity 0.15s ease; border: 1px solid var(--border); z-index: 200; }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }
        .sidebar-bottom { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }

        /* ── MAIN ── */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
        .topbar { height: var(--topbar-h); display: flex; align-items: center; gap: 16px; padding: 0 28px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
        .page-title { font-family: 'Poppins', sans-serif; font-size: 25px; font-weight: 900; color: var(--text-white); letter-spacing: -0.3px; white-space: nowrap; }

        .filters-group { display: flex; align-items: center; gap: 12px; min-width: 600px; }
        .search-bar { width: 360px; position: relative; }
        .search-bar input { width: 100%; height: 40px; background: #1a1726; border: 1px solid white; border-radius: 10px; padding: 0 16px 0 40px; color: var(--text-white); font-size: 13px; font-family: inherit; outline: none; transition: border-color 0.2s ease; }
        .search-bar input:focus { border-color: var(--accent); }
        .search-bar input::placeholder { color: var(--text-dim); }
        .search-bar .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); }
        .search-bar .search-icon svg { width: 16px; height: 16px; stroke: white; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

        .filter-select { height: 40px; background: #1a1726; border: 1px solid rgba(124,92,191,0.25); border-radius: 10px; padding: 0 36px 0 14px; color: var(--text-white); font-size: 13px; font-family: inherit; outline: none; cursor: pointer; transition: border-color 0.2s ease; appearance: none; background-image: url("data:image/svg+xml,%3Csvg width='12' height='12' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6 9l6 6 6-6' stroke='%237a7490' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"); background-repeat: no-repeat; background-position: right 12px center; min-width: 110px; }
        .filter-select:hover { border-color: var(--accent); }
        .filter-select:focus { border-color: var(--accent); }

        /* ── CONTENT ── */
        .content { flex: 1; overflow-y: auto; padding: 32px 28px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        .section-label { font-size: 13px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; margin-bottom: 20px; }

        /* ── GRID ── */
        .cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

        /* ── PROJECT CARD ── */
        .card-project {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 20px 20px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            cursor: pointer;
            position: relative;
            min-height: 180px;
            transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
            animation: fadeUp 0.4s ease both;
        }
        .card-project:hover { background: var(--card-hover); border-color: rgba(124,92,191,0.3); transform: translateY(-2px); }

        .card-top-row { display: flex; align-items: flex-start; justify-content: space-between; }

        .project-icon {
            width: 42px; height: 42px;
            background: var(--icon-bg);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            color: var(--accent); flex-shrink: 0;
        }
        .project-icon svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

        .card-body { flex: 1; }
        .project-name { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 700; color: var(--text-white); letter-spacing: 0.3px; margin-bottom: 8px; }
        .chip { display: inline-block; padding: 3px 10px; background: var(--accent-chip); border-radius: 20px; font-size: 10px; font-weight: 700; color: #c8b8f0; letter-spacing: 0.5px; text-transform: uppercase; }
        .chip.empty { display: none; }

        .card-footer { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--border); padding-top: 10px; margin-top: auto; }
        .meta-item { display: flex; align-items: center; gap: 5px; color: var(--text-dim); font-size: 11px; }
        .meta-item svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

        /* ── EMPTY STATE ── */
        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--text-dim); text-align: center; }
        .empty-state svg { width: 48px; height: 48px; stroke: var(--text-dim); fill: none; stroke-width: 1.2; opacity: 0.5; }
        .empty-state p { font-size: 14px; }

        /* ── CONTEXT MENU ── */
        .ctx-menu { position: fixed; background: #1e1a2e; border: 1px solid rgba(124,92,191,0.25); border-radius: 10px; padding: 6px; min-width: 150px; z-index: 999; box-shadow: 0 8px 24px rgba(0,0,0,0.4); display: none; }
        .ctx-menu.visible { display: block; }
        .ctx-item { padding: 8px 12px; border-radius: 6px; font-size: 13px; cursor: pointer; color: var(--text-muted); transition: background 0.15s, color 0.15s; display: flex; align-items: center; gap: 8px; }
        .ctx-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .ctx-item.danger { color: #e07070; }
        .ctx-item.danger:hover { background: rgba(224,112,112,0.12); }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar { width: 100% !important; flex-direction: row; height: 56px; padding: 0 16px; border-right: none; border-bottom: 1px solid var(--border); }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
            .filters-group { flex-wrap: wrap; }
            .search-bar { max-width: 100%; flex: 1 1 100%; }
            .filter-select { flex: 1; min-width: 120px; }
        }

        .btn-dots-proj {
    background: none; border: 1px solid var(--border); border-radius: 7px;
    cursor: pointer; color: var(--text-dim);
    width: 28px; height: 28px;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 2.5px;
    transition: color .2s ease, background .2s ease; flex-shrink: 0;
}
.chip-user-made { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; background: rgba(92,191,124,.15); border: 1px solid rgba(92,191,124,.3); border-radius: 20px; font-size: 10px; font-weight: 700; color: #7debb0; letter-spacing: .5px; text-transform: uppercase; }
.chip-user-made svg { width: 10px; height: 10px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    </style>
</head>
<body>
<div class="shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png" alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="My Chats">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home/Chat</span>
            </a>
            <a class="nav-item" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item active" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Support/HowToUse" data-tip="How to use"> 
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>
        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="Profile"
               style="height:auto; padding:8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <!-- MAIN -->
    <div class="main">
        <header class="topbar">
            <span class="page-title">My Quizzes</span>
            <div style="flex:1;"></div>
            <div class="filters-group" style="flex:0; justify-content:flex-end;">
                <div class="search-bar">
                    <span class="search-icon">
                        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    </span>
                    <input type="text" placeholder="Search projects..." id="searchInput" oninput="applyFilters()" />
                </div>
                <select class="filter-select" id="filterDate" onchange="applyFilters()">
                    <option value="">All Dates</option>
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                    <option value="older">Older</option>
                </select>
                <select class="filter-select" id="filterTag" onchange="applyFilters()">
                    <option value="">All Tags</option>
                </select>
            </div>
        </header>

        <div class="content">
            <div class="section-label">Select a project to view its quizzes</div>
            <div class="cards-grid" id="cardsGrid"></div>
        </div>
    </div>
</div>

<!-- ── LOGOUT MODAL ── -->
<div id="logoutModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:16px; padding:28px 28px 24px;
        width:340px; text-align:center; font-family:'Poppins',sans-serif;">
        <div style="width:48px; height:48px; border-radius:14px;
            background:rgba(220,60,60,.12); display:flex; align-items:center;
            justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Poppins',sans-serif; font-size:16px; font-weight:800;
                    color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            Are you sure you want to log out of Rev'nLearn?
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border);
                       background:transparent; color:var(--text-white);
                       font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">
                Cancel
            </button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none;
                       background:#c0392b; color:#fff; text-decoration:none;
                       font-family:'Poppins',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer; display:flex; align-items:center; justify-content:center;">
                Yes, Log Out
            </a>
        </div>
    </div>
</div>

<!-- ── CREATE PROJECT MODAL ── -->
<div id="createProjectModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:20px; padding:28px;
        width:min(460px,92vw); font-family:'DM Sans',sans-serif;
        box-shadow: 0 24px 60px rgba(0,0,0,0.5);">

        <!-- Header -->
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
            <div>
                <div style="font-family:'Syne',sans-serif; font-size:16px; font-weight:800; color:var(--text-white);">
                    New Quiz Project
                </div>
                <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                    Create a project to hold your custom quizzes
                </div>
            </div>
            <button onclick="closeCreateModal()" style="
                background:none; border:1px solid var(--border);
                border-radius:8px; color:var(--text-dim);
                width:30px; height:30px; cursor:pointer;
                display:flex; align-items:center; justify-content:center;
                font-size:16px;">✕</button>
        </div>

        <!-- Fields -->
        <div style="display:flex; flex-direction:column; gap:14px;">
            <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted);
                              text-transform:uppercase; letter-spacing:.5px; display:block; margin-bottom:6px;">
                    Project Name *
                </label>
                <input id="cpName" type="text" placeholder="e.g. Science Quiz, Math Review..."
                    style="width:100%; height:42px; background:var(--bg);
                           border:1px solid var(--border); border-radius:10px;
                           padding:0 14px; color:var(--text-white);
                           font-size:13px; font-family:inherit; outline:none;
                           transition:border-color .2s;"
                    onfocus="this.style.borderColor='var(--accent)'"
                    onblur="this.style.borderColor='var(--border)'" />
            </div>
            <div>
                <label style="font-size:11px; font-weight:700; color:var(--text-muted);
                              text-transform:uppercase; letter-spacing:.5px; display:block; margin-bottom:6px;">
                    Subject / Tag
                </label>
                <input id="cpSubject" type="text" placeholder="e.g. Biology, History..."
                    style="width:100%; height:42px; background:var(--bg);
                           border:1px solid var(--border); border-radius:10px;
                           padding:0 14px; color:var(--text-white);
                           font-size:13px; font-family:inherit; outline:none;
                           transition:border-color .2s;"
                    onfocus="this.style.borderColor='var(--accent)'"
                    onblur="this.style.borderColor='var(--border)'" />
            </div>
        </div>

        <!-- Error -->
        <div id="cpError" style="display:none; margin-top:12px;
            background:rgba(224,112,112,.1); border:1px solid rgba(224,112,112,.25);
            border-radius:8px; padding:10px 14px;
            font-size:12px; color:#e07070;"></div>

        <!-- Actions -->
        <div style="display:flex; gap:10px; margin-top:20px;">
            <button onclick="closeCreateModal()" style="
                flex:1; height:42px; background:none;
                border:1px solid var(--border); border-radius:10px;
                color:var(--text-muted); font-size:13px; font-weight:600;
                font-family:inherit; cursor:pointer;
                transition:border-color .2s, color .2s;"
                onmouseover="this.style.borderColor='var(--accent)'; this.style.color='var(--text-white)'"
                onmouseout="this.style.borderColor='var(--border)'; this.style.color='var(--text-muted)'">
                Cancel
            </button>
            <button onclick="submitCreateProject()" id="cpSubmitBtn" style="
                flex:2; height:42px; background:var(--accent);
                border:none; border-radius:10px; color:#fff;
                font-size:13px; font-weight:700; font-family:inherit;
                cursor:pointer; transition:background .2s;">
                Create Project
            </button>
        </div>
    </div>
</div>

<!-- PROJECT CONTEXT MENU -->
<div class="ctx-menu" id="projCtxMenu">
    <div class="ctx-item" onclick="projCtxRename()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
        </svg>
        Rename
    </div>
    <div class="ctx-item danger" onclick="projCtxDelete()">
        <svg width="14" height="14" viewBox="0 0 24 24" stroke="currentColor" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"/>
            <path d="M19 6l-1 14H6L5 6"/>
            <path d="M10 11v6M14 11v6"/>
        </svg>
        Delete
    </div>
</div>

<!-- PROJECT RENAME MODAL -->
<div class="modal-overlay" id="projRenameOverlay" onclick="if(event.target===this) closeProjRenameModal()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(4px); z-index:500; align-items:center; justify-content:center;">
    <div style="background:var(--card-bg); border:1px solid var(--border); border-radius:20px; padding:28px; width:min(420px,90vw); box-shadow:0 24px 60px rgba(0,0,0,.5);">
        <div style="font-family:'Syne',sans-serif; font-size:18px; font-weight:800; color:var(--text-white); margin-bottom:6px;">Rename Project</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">Enter a new name for this project.</div>
        <label style="font-size:11px; font-weight:700; color:var(--text-muted); letter-spacing:.6px; text-transform:uppercase; margin-bottom:7px; display:block;">New name</label>
        <input id="projRenameInput" type="text" maxlength="100"
            style="width:100%; height:44px; background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:0 14px; color:var(--text-white); font-size:14px; font-family:inherit; outline:none; transition:border-color .2s; margin-bottom:16px;"
            onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"
            oninput="document.getElementById('projRenameSaveBtn').disabled = !this.value.trim()"
            onkeydown="if(event.key==='Enter') submitProjRename(); if(event.key==='Escape') closeProjRenameModal();" />
        <div style="display:flex; gap:10px;">
            <button onclick="closeProjRenameModal()" style="flex:1; height:44px; background:none; border:1px solid var(--border); border-radius:10px; color:var(--text-muted); font-size:14px; font-weight:600; font-family:inherit; cursor:pointer;">Cancel</button>
            <button id="projRenameSaveBtn" onclick="submitProjRename()" style="flex:2; height:44px; background:var(--accent); border:none; border-radius:10px; color:#fff; font-size:14px; font-weight:700; font-family:inherit; cursor:pointer;">Save</button>
        </div>
    </div>
</div>

<!-- PROJECT DELETE MODAL -->
<div id="projDeleteOverlay" onclick="if(event.target===this) closeProjDeleteModal()" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.6); backdrop-filter:blur(4px); z-index:500; align-items:center; justify-content:center;">
    <div style="background:var(--card-bg); border:1px solid rgba(224,112,112,.2); border-radius:20px; padding:28px; width:min(380px,90vw); box-shadow:0 24px 60px rgba(0,0,0,.5);">
        <div style="font-family:'Syne',sans-serif; font-size:18px; font-weight:800; color:#e07070; margin-bottom:6px;">Delete Project?</div>
        <div id="projDeleteSub" style="font-size:13px; color:var(--text-muted); margin-bottom:24px;"></div>
        <div style="display:flex; gap:10px;">
            <button onclick="closeProjDeleteModal()" style="flex:1; height:44px; background:none; border:1px solid var(--border); border-radius:10px; color:var(--text-muted); font-size:14px; font-weight:600; font-family:inherit; cursor:pointer;">Cancel</button>
            <button id="projDeleteConfirmBtn" onclick="submitProjDelete()" style="flex:2; height:44px; background:#c0392b; border:none; border-radius:10px; color:#fff; font-size:14px; font-weight:700; font-family:inherit; cursor:pointer;">Delete</button>
        </div>
    </div>
</div>
<script>
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();

    document.addEventListener('DOMContentLoaded', loadProjects);

    async function loadProjects() {
        try {
            const res      = await fetch('/Chat/GetMyProjects');
            const projects = await res.json();
            const grid     = document.getElementById('cardsGrid');
            grid.innerHTML = '';

            if (projects.length === 0) {
                grid.innerHTML = `
                    <div class="empty-state" style="grid-column:1/-1">
                        <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                        <p>No projects yet.<br>Go to <strong>My Chats</strong> to create one.</p>
                    </div>`;
                return;
            }

            // Fetch quiz counts for ALL projects in parallel first
            const counts = await Promise.all(
                projects.map(async (p) => {
                    try {
                        const r       = await fetch(`/Chat/GetQuizzesByProject?projectId=${p.id}`);
                        const quizzes = await r.json();
                        const sessions = new Set(quizzes.map(q => q.sessionId || q.quizId));
                        return { project: p, count: sessions.size };
                    } catch {
                        return { project: p, count: 0 };
                    }
                })
            );

            // Keep only projects that have at least one quiz session
            const withQuizzes = counts.filter(c => c.count > 0);

            if (withQuizzes.length === 0) {
            // New Quiz Project card
               const newCard = document.createElement('div');
               newCard.className = 'card-project';
               newCard.style.cssText = 'border-style:dashed; border-color:rgba(124,92,191,.4); background:transparent; cursor:pointer; min-height:180px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:20px; text-align:center; transition:border-color .2s ease, background .2s ease;';
               newCard.onclick = openCreateModal;
               newCard.onmouseenter = () => { newCard.style.borderColor='rgba(124,92,191,.9)'; newCard.style.background='rgba(124,92,191,.07)'; };
               newCard.onmouseleave = () => { newCard.style.borderColor='rgba(124,92,191,.4)'; newCard.style.background='transparent'; };
               newCard.innerHTML = `
                   <div style="width:44px; height:44px; border-radius:50%;
                               background:rgba(124,92,191,.18); border:1.5px dashed #7c5cbf;
                               display:flex; align-items:center; justify-content:center;
                               color:#7c5cbf; font-size:24px; font-weight:300; line-height:1;">+</div>
                   <span style="font-family:'Poppins',sans-serif; font-size:13px; font-weight:600;
                                color:var(--text-muted);">New Quiz Project</span>`;
               grid.appendChild(newCard);

    const emptyMsg = document.createElement('div');
    emptyMsg.className = 'empty-state';
    emptyMsg.style.gridColumn = '1/-1';
    emptyMsg.innerHTML = `
        <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
        <p>No quizzes yet.<br>Open a chat and generate a quiz first.</p>`;
    grid.appendChild(emptyMsg);
    return;
}

            // Populate tag filter and render only qualifying cards
// Populate tag filter and render only qualifying cards
                populateTagFilter(withQuizzes.map(c => c.project));

                // ── New Quiz Project card (always first) ──
                const newCard = document.createElement('div');
                newCard.className = 'card-project';
                newCard.style.cssText = 'border-style:dashed; border-color:rgba(124,92,191,.4); background:transparent; cursor:pointer; min-height:180px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; padding:20px; text-align:center; transition:border-color .2s ease, background .2s ease;';
                newCard.onclick = openCreateModal;
                newCard.onmouseenter = () => { newCard.style.borderColor='rgba(124,92,191,.9)'; newCard.style.background='rgba(124,92,191,.07)'; };
                newCard.onmouseleave = () => { newCard.style.borderColor='rgba(124,92,191,.4)'; newCard.style.background='transparent'; };
                newCard.innerHTML = `
                    <div style="width:44px; height:44px; border-radius:50%;
                                background:rgba(124,92,191,.18); border:1.5px dashed #7c5cbf;
                                display:flex; align-items:center; justify-content:center;
                                color:#7c5cbf; font-size:24px; font-weight:300; line-height:1;">+</div>
                    <span style="font-family:'Poppins',sans-serif; font-size:13px; font-weight:600;
                                color:var(--text-muted);">New Quiz Project</span>`;
                grid.appendChild(newCard);

                withQuizzes.forEach(({ project, count }, i) => {
                const card = makeCard(project, i);
                grid.appendChild(card);

                // Fill in the quiz count badge immediately (no second fetch needed)
                const el = document.getElementById(`quiz-count-${project.id}`);
                if (el) {
                    const span = el.querySelector('span');
                    if (span) span.textContent = `${count} Quiz${count !== 1 ? 'zes' : ''}`;
                }
            });

        } catch (err) { console.error('Failed to load projects:', err); }
    }
        
    
    function populateTagFilter(projects) {
        const tagSet = new Set();
        projects.forEach(p => {
            if (p.subject && p.subject.trim()) tagSet.add(p.subject.trim());
        });

        const filterTag = document.getElementById('filterTag');
        filterTag.innerHTML = '<option value="">All Tags</option>';
        Array.from(tagSet).sort().forEach(tag => {
            const option = document.createElement('option');
            option.value = tag.toLowerCase();
            option.textContent = tag;
            filterTag.appendChild(option);
        });
    }

    function populateTagFilter(projects) {
        const tagSet = new Set();
        projects.forEach(p => {
            if (p.subject && p.subject.trim()) tagSet.add(p.subject.trim());
        });

        const filterTag = document.getElementById('filterTag');
        filterTag.innerHTML = '<option value="">All Tags</option>';
        Array.from(tagSet).sort().forEach(tag => {
            const option = document.createElement('option');
            option.value = tag.toLowerCase();
            option.textContent = tag;
            filterTag.appendChild(option);
        });
    }

 function makeCard(project, index) {
    const card = document.createElement('div');
    card.className = 'card-project';
    card.dataset.id        = project.id;
    card.dataset.name      = project.name.toLowerCase();
    card.dataset.subject   = (project.subject || '').toLowerCase();
    card.dataset.timestamp = parseDateToTimestamp(project.date);
    card.style.animationDelay = `${index * 0.05}s`;
    card.onclick = () => openProject(project.id);

    card.innerHTML = `
        <div class="card-top-row">
            <div class="project-icon">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            </div>
            ${project.isManual ? `
            <button class="btn-dots-proj" title="Options"
                data-pid="${project.id}"
                data-pname="${escHtml(project.name).replace(/"/g,'&quot;')}"
                onclick="event.stopPropagation(); showProjectCtxMenu(event, this)">
                <span></span><span></span><span></span>
            </button>` : ''}
        </div>
        <div class="card-body">
            ${project.isManual ? `
            <div class="chip-user-made">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                User Made
            </div>` : ''}
            <div class="project-name">${escHtml(project.name.toUpperCase())}</div>
            ${project.subject ? `<span class="chip">${escHtml(project.subject)}</span>` : ''}
        </div>
        <div class="card-footer">
            <div class="meta-item">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                ${escHtml(project.date)}
            </div>
            <div class="meta-item" id="quiz-count-${project.id}">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span>—</span>
            </div>
        </div>`;

    return card;
}

    function parseDateToTimestamp(dateStr) {
        return new Date(dateStr).getTime();
    }

    function getDateCategory(timestamp) {
        const now = new Date();
        const chatDate = new Date(timestamp);
        now.setHours(0, 0, 0, 0);
        chatDate.setHours(0, 0, 0, 0);
        const diffDays = Math.floor((now - chatDate) / (1000 * 60 * 60 * 24));
        if (diffDays === 0) return 'today';
        if (diffDays <= 7) return 'week';
        if (diffDays <= 30) return 'month';
        return 'older';
    }

    function applyFilters() {
        const searchQuery = document.getElementById('searchInput').value.toLowerCase();
        const dateFilter  = document.getElementById('filterDate').value;
        const tagFilter   = document.getElementById('filterTag').value;

        let visibleCount = 0;

        document.querySelectorAll('.card-project').forEach(card => {
            // Always keep the "New Quiz Project" dashed card visible
            if (!card.dataset.id) {
                card.style.display = '';
                return;
            }

            const name         = card.dataset.name || '';
            const subject      = card.dataset.subject || '';
            const timestamp    = parseInt(card.dataset.timestamp);
            const dateCategory = getDateCategory(timestamp);

            const searchMatch = !searchQuery || name.includes(searchQuery) || subject.includes(searchQuery);
            const dateMatch   = !dateFilter  || dateCategory === dateFilter;
            const tagMatch    = !tagFilter   || subject === tagFilter;

            if (searchMatch && dateMatch && tagMatch) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        // Show/hide no-results message (placed inline beside New Quiz Project card)
        const existing = document.getElementById('noResults');
        if (visibleCount === 0) {
            if (!existing) {
                const msg = document.createElement('div');
                msg.id = 'noResults';
                msg.style.cssText = 'display:flex; flex-direction:column; align-items:center; justify-content:center; gap:12px; padding:60px 20px; color:var(--text-dim); text-align:center;';
                msg.innerHTML = `
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity:.5;"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                    <p style="font-size:14px;">No projects match your filters.</p>`;
                document.getElementById('cardsGrid').appendChild(msg);
            }
        } else if (existing) {
            existing.remove();
        }
    }

    function openProject(id) {
        window.location.href = `/Chat/QuizzesView?id=${id}`;
    }

    document.addEventListener('keydown', e => { if (e.key === 'Escape') {} });

    function escHtml(str) {
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function openCreateModal() {
    document.getElementById('cpName').value = '';
    document.getElementById('cpSubject').value = '';
    document.getElementById('cpError').style.display = 'none';
    document.getElementById('createProjectModal').style.display = 'flex';
    setTimeout(() => document.getElementById('cpName').focus(), 100);
}

function closeCreateModal() {
    document.getElementById('createProjectModal').style.display = 'none';
}

async function submitCreateProject() {
    const name    = document.getElementById('cpName').value.trim();
    const subject = document.getElementById('cpSubject').value.trim();
    const errEl   = document.getElementById('cpError');
    const btn     = document.getElementById('cpSubmitBtn');

    if (!name) {
        errEl.textContent = 'Project name is required.';
        errEl.style.display = 'block';
        return;
    }

    btn.textContent = 'Creating…';
    btn.disabled = true;
    errEl.style.display = 'none';

    try {
        const res  = await fetch('/Chat/CreateManualProject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, subject })
        });
        const data = await res.json();

        if (data.id) {
            closeCreateModal();
            // Redirect straight into the new project
            window.location.href = `/Chat/QuizzesView?id=${data.id}`;
        } else {
            errEl.textContent = data.error || 'Something went wrong.';
            errEl.style.display = 'block';
        }
    } catch {
        errEl.textContent = 'Network error. Please try again.';
        errEl.style.display = 'block';
    } finally {
        btn.textContent = 'Create Project';
        btn.disabled = false;
    }
}

    // Close modal on backdrop click
    document.getElementById('createProjectModal').addEventListener('click', function(e) {
        if (e.target === this) closeCreateModal();
    });


    let _ctxProjectId   = null;
let _ctxProjectName = null;
let _ctxCard        = null;

function showProjectCtxMenu(e, btn) {
    e.preventDefault();
    _ctxProjectId   = btn.dataset.pid;
    _ctxProjectName = btn.dataset.pname;
    _ctxCard        = btn.closest('.card-project');

    const menu = document.getElementById('projCtxMenu');
    menu.style.left = e.clientX + 'px';
    menu.style.top  = e.clientY + 'px';
    menu.classList.add('visible');
}

document.addEventListener('click', () => {
    document.getElementById('projCtxMenu').classList.remove('visible');
});

// ── RENAME ──
function projCtxRename() {
    document.getElementById('projCtxMenu').classList.remove('visible');
    const input = document.getElementById('projRenameInput');
    input.value = _ctxProjectName;
    document.getElementById('projRenameSaveBtn').disabled = false;
    const overlay = document.getElementById('projRenameOverlay');
    overlay.style.display = 'flex';
    setTimeout(() => input.focus(), 100);
}

function closeProjRenameModal() {
    document.getElementById('projRenameOverlay').style.display = 'none';
}

async function submitProjRename() {
    const newName = document.getElementById('projRenameInput').value.trim();
    if (!newName) return;

    const btn = document.getElementById('projRenameSaveBtn');
    btn.textContent = 'Saving…';
    btn.disabled = true;

    try {
        const res  = await fetch('/Chat/RenameProject', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
           body: JSON.stringify({ id: _ctxProjectId, name: newName })
        });

        // ← idagdag: i-log ang raw response kung may error
        if (!res.ok) {
            const text = await res.text();
            console.error('RenameProject HTTP error:', res.status, text);
            alert(`Server error ${res.status}. Check console.`);
            return;
        }

        const data = await res.json();

        if (data.success) {
            closeProjRenameModal();
            if (_ctxCard) {
                const nameEl = _ctxCard.querySelector('.project-name');
                if (nameEl) nameEl.textContent = newName.toUpperCase();
                _ctxCard.dataset.name = newName.toLowerCase();

                // i-update rin ang data-pname ng button para consistent
                const dotBtn = _ctxCard.querySelector('.btn-dots-proj');
                if (dotBtn) dotBtn.dataset.pname = newName;
            }
            _ctxProjectName = newName;
        } else {
            alert(data.error || 'Failed to rename.');
        }
    } catch (err) {
        console.error('Rename network error:', err);
        alert('Network error. Please try again.');
    } finally {
        btn.textContent = 'Save';
        btn.disabled = false;
    }
}
// ── DELETE ──
function projCtxDelete() {
    document.getElementById('projCtxMenu').classList.remove('visible');
    document.getElementById('projDeleteSub').textContent =
        `Are you sure you want to delete "${_ctxProjectName}"? This cannot be undone.`;
    document.getElementById('projDeleteOverlay').style.display = 'flex';
}

function closeProjDeleteModal() {
    document.getElementById('projDeleteOverlay').style.display = 'none';
}

async function submitProjDelete() {
    const btn = document.getElementById('projDeleteConfirmBtn');
    btn.textContent = 'Deleting…';
    btn.disabled = true;

    try {
        const res  = await fetch(`/Chat/DeleteProject?id=${_ctxProjectId}`, {
            method: 'DELETE'
        });
        const data = await res.json();

        if (data.success) {
            closeProjDeleteModal();
            // Remove card from grid
            if (_ctxCard) _ctxCard.remove();
        } else {
            alert(data.error || 'Failed to delete.');
        }
    } catch {
        alert('Network error. Please try again.');
    } finally {
        btn.textContent = 'Delete';
        btn.disabled = false;
    }
}
</script>
