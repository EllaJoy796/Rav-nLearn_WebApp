@{
    ViewData["Title"] = "Flashcard Set";
    Layout = null;

    var setName      = (string)(ViewBag.SetName  ?? "FLASHCARD SET");
    var setDate      = (string)(ViewBag.SetDate  ?? "");
    var sessionCount = (int)(ViewBag.SessionCount ?? 0);
    var sessions     = ViewBag.Sessions as IEnumerable<dynamic>;
    var projectId    = (int)(ViewBag.ProjectId ?? 0);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn – @setName</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:               #0d0d12;
            --sidebar-bg:       #111118;
            --sidebar-width:    72px;
            --sidebar-expanded: 220px;
            --card-bg:          #1e1a2e;
            --card-hover:       #251f3a;
            --accent:           #7c5cbf;
            --accent-soft:      rgba(124,92,191,.18);
            --accent-chip:      #5a3f9e;
            --text-white:       #f0eeff;
            --text-muted:       #7a7490;
            --text-dim:         #4e4868;
            --border:           rgba(124,92,191,.12);
            --topbar-h:         64px;
        }

        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
        }
        body.light-mode .nav-item { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }
        body.light-mode .card-fc-banner { background: linear-gradient(135deg, #ded8f5 0%, #e8e3f8 100%); }
        body.light-mode .fc-card-img { filter: brightness(0) invert(0) !important; opacity: 0.4 !important; }

        html, body { height: 100%; background: var(--bg); font-family: 'Poppins', sans-serif; color: var(--text-white); overflow: hidden; }
        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ══ SIDEBAR ══ */
        .sidebar { width: var(--sidebar-width); background: var(--sidebar-bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: flex-start; padding: 16px 0; flex-shrink: 0; z-index: 100; overflow: hidden; transition: width .25s ease; }
        .sidebar:hover { width: var(--sidebar-expanded); }
        .sidebar-logo { width: 100%; display: flex; align-items: center; gap: 10px; padding: 0 15px; margin-bottom: 28px; overflow: hidden; }
        .logo-icon { width: 42px; height: 42px; min-width: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text { font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 800; color: var(--text-white); white-space: nowrap; opacity: 0; transition: opacity .2s ease .05s; }
        .sidebar:hover .logo-text { opacity: 1; }
        .nav-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }
        .nav-group + .nav-group { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border); }
        .nav-group-label { font-size: 10px; font-weight: 700; color: var(--text-dim); letter-spacing: .8px; text-transform: uppercase; padding: 0 4px; margin-bottom: 6px; white-space: nowrap; opacity: 0; max-height: 0; overflow: hidden; transition: opacity .2s ease, max-height .2s ease; }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }
        .nav-item { width: 100%; height: 44px; border-radius: 10px; display: flex; align-items: center; gap: 12px; padding: 0 11px; cursor: pointer; transition: background .2s ease, color .2s ease; color: white; text-decoration: none; overflow: hidden; white-space: nowrap; position: relative; }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg { width: 20px; height: 20px; min-width: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .nav-label { font-size: 13px; font-weight: 600; opacity: 0; transition: opacity .2s ease .05s; overflow: hidden; }
        .sidebar:hover .nav-label { opacity: 1; }
        .nav-item::after { content: attr(data-tip); position: absolute; left: 82px; background: #1e1e2e; color: var(--text-white); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity .15s ease; border: 1px solid var(--border); z-index: 200; }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }
        .sidebar-bottom { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }

        /* ══ MAIN ══ */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
        .topbar { height: var(--topbar-h); display: flex; align-items: center; gap: 16px; padding: 0 28px; border-bottom: 1px solid var(--border); flex-shrink: 0; }

        .btn-back { display: flex; align-items: center; gap: 8px; background: transparent; border: 1px solid var(--border); border-radius: 10px; color: var(--text-white); font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600; padding: 0 14px; height: 36px; cursor: pointer; text-decoration: none; flex-shrink: 0; transition: background .2s ease, border-color .2s ease; }
        .btn-back:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

        .set-header { display: flex; flex-direction: column; gap: 2px; flex: 1; }
        .set-title { font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 900; color: var(--text-white); letter-spacing: -.3px; }
        .set-meta { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; }
        .set-meta .dot { width: 3px; height: 3px; background: var(--text-dim); border-radius: 50%; }

        /* ── CONTENT ── */
        .content { flex: 1; overflow-y: auto; padding: 32px 28px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
        .section-label { font-size: 13px; font-weight: 600; color: var(--text-muted); letter-spacing: .5px; margin-bottom: 20px; }

        /* ── GRID ── */
        .cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

        /* ── CARD ── */
        .card-fc { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; cursor: pointer; position: relative; transition: background .2s ease, border-color .2s ease, transform .15s ease; animation: fadeUp .4s ease both; overflow: hidden; }
        .card-fc:hover { background: var(--card-hover); border-color: rgba(124,92,191,.3); transform: translateY(-2px); }

        .card-fc-banner { width: 100%; height: 110px; background: linear-gradient(135deg, #251f3a 0%, #1a1530 100%); display: flex; align-items: center; justify-content: center; position: relative; flex-shrink: 0; }
        .fc-stack { position: relative; width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; }
        .fc-card-img { width: 52px; height: 52px; object-fit: contain; filter: brightness(0) invert(1); opacity: 0.85; }

        .banner-chip { position: absolute; top: 12px; left: 14px; padding: 3px 10px; background: var(--accent-chip); border-radius: 20px; font-size: 10px; font-weight: 700; color: #c8b8f0; letter-spacing: .5px; text-transform: uppercase; }

        /* chips row */
        .card-fc-top { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px 0; gap: 8px; }
        .chips-row { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        .chip { display: flex; align-items: center; gap: 5px; border-radius: 20px; padding: 4px 10px 4px 8px; font-size: 11px; font-weight: 700; letter-spacing: .3px; }
        .chip svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .chip-buddy { background: var(--accent-soft); border: 1px solid rgba(124,92,191,.25); color: #c8b8f0; }

        /* three-dot menu */
        .btn-dots { background: none; border: 1px solid var(--border); border-radius: 7px; cursor: pointer; color: var(--text-dim); width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; gap: 2.5px; flex-direction: column; transition: color .2s, background .2s; flex-shrink: 0; position: relative; }
        .btn-dots:hover { color: var(--text-muted); background: var(--accent-soft); }
        .btn-dots span { width: 3px; height: 3px; background: currentColor; border-radius: 50%; display: block; }

        .dots-menu { position: absolute; top: calc(100% + 6px); right: 0; background: var(--card-bg); border: 1px solid var(--border); border-radius: 10px; padding: 6px; z-index: 50; min-width: 130px; box-shadow: 0 8px 24px rgba(0,0,0,.4); display: none; flex-direction: column; gap: 2px; }
        .dots-menu.open { display: flex; }
        .menu-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 7px; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-muted); transition: background .15s, color .15s; white-space: nowrap; }
        .menu-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .menu-item.danger:hover { background: rgba(220,60,60,.12); color: #e07070; }
        .menu-item svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

        .card-fc-body { padding: 10px 14px 14px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .fc-name { font-family: 'Poppins', sans-serif; font-size: 14px; font-weight: 700; color: var(--text-white); letter-spacing: .3px; }

        /* progress */
        .fc-prog-row { display: flex; align-items: center; justify-content: space-between; font-size: 11px; color: var(--text-muted); }
        .fc-prog-bar { height: 4px; background: rgba(124,92,191,.15); border-radius: 2px; overflow: hidden; margin-top: 5px; }
        .fc-prog-fill { height: 100%; background: var(--accent); border-radius: 2px; }

        .card-fc-meta { display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 11px; margin-top: 6px; }
        .card-fc-meta svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

        .chip-user-made { display: inline-flex; align-items: center; gap: 4px; padding: 3px 8px; background: rgba(92,191,124,.15); border: 1px solid rgba(92,191,124,.3); border-radius: 20px; font-size: 10px; font-weight: 700; color: #7debb0; letter-spacing: .5px; text-transform: uppercase; }
        .chip-user-made svg { width: 10px; height: 10px; stroke: currentColor; fill: none; stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }

        /* Manual Flashcard Builder Modal */
        .mfb-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.7); backdrop-filter: blur(6px); z-index: 600; display: none; align-items: flex-start; justify-content: center; padding: 24px 16px; overflow-y: auto; }
        .mfb-overlay.open { display: flex; }
        .mfb-modal { background: #16121f; border: 1px solid rgba(124,92,191,.25); border-radius: 24px; width: min(640px, 96vw); margin: auto; box-shadow: 0 32px 80px rgba(0,0,0,.6); overflow: hidden; display: flex; flex-direction: column; }
        .mfb-header { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--border); }
        .mfb-title { font-family: 'Syne', sans-serif; font-size: 17px; font-weight: 800; color: var(--text-white); }
        .mfb-subtitle { font-size: 12px; color: var(--text-muted); margin-top: 2px; }
        .mfb-close { background: none; border: 1px solid var(--border); border-radius: 8px; color: var(--text-dim); width: 30px; height: 30px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; transition: color .2s, background .2s; }
        .mfb-close:hover { background: var(--accent-soft); color: var(--text-white); }
        .mfb-name-row { padding: 16px 24px; border-bottom: 1px solid var(--border); }
        .mfb-name-input { width: 100%; height: 42px; background: var(--bg); border: 1px solid rgba(124,92,191,.2); border-radius: 10px; padding: 0 14px; color: var(--text-white); font-size: 14px; font-family: inherit; outline: none; transition: border-color .2s; }
        .mfb-name-input:focus { border-color: var(--accent); }
        .mfb-name-input::placeholder { color: var(--text-dim); }
        .mfb-cards-area { padding: 16px 24px; flex: 1; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border) transparent; display: flex; flex-direction: column; gap: 12px; max-height: 50vh; }
        .mfb-card { background: rgba(124,92,191,.06); border: 1px solid rgba(124,92,191,.15); border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
        .mfb-card-top { display: flex; align-items: center; justify-content: space-between; }
        .mfb-card-num { font-size: 11px; font-weight: 700; color: var(--accent); text-transform: uppercase; letter-spacing: .5px; }
        .mfb-card-delete { background: none; border: none; color: var(--text-dim); cursor: pointer; font-size: 16px; padding: 2px 6px; border-radius: 6px; transition: color .2s, background .2s; }
        .mfb-card-delete:hover { color: #e07070; background: rgba(224,112,112,.1); }
        .mfb-input { width: 100%; background: var(--bg); border: 1px solid rgba(124,92,191,.2); border-radius: 8px; padding: 10px 12px; color: var(--text-white); font-size: 13px; font-family: inherit; outline: none; transition: border-color .2s; resize: vertical; min-height: 56px; }
        .mfb-input:focus { border-color: var(--accent); }
        .mfb-input::placeholder { color: var(--text-dim); }
        .mfb-input-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; display: block; }
        .mfb-add-btn { display: flex; align-items: center; justify-content: center; gap: 8px; border: 1.5px dashed rgba(124,92,191,.35); border-radius: 12px; padding: 12px; cursor: pointer; color: var(--accent); font-size: 13px; font-weight: 600; font-family: inherit; background: none; width: 100%; transition: border-color .2s, background .2s; }
        .mfb-add-btn:hover { border-color: var(--accent); background: var(--accent-soft); }
        .mfb-footer { padding: 16px 24px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 12px; }
        .mfb-save-btn { height: 40px; padding: 0 24px; background: var(--accent); border: none; border-radius: 10px; color: #fff; font-size: 13px; font-weight: 700; font-family: inherit; cursor: pointer; transition: background .2s; }
        .mfb-save-btn:hover { background: #6b4daa; }
        .mfb-save-btn:disabled { background: #3a3050; color: var(--text-dim); cursor: not-allowed; }
        .mfb-cancel-btn { height: 40px; padding: 0 18px; background: none; border: 1px solid rgba(124,92,191,.2); border-radius: 10px; color: var(--text-muted); font-size: 13px; font-weight: 600; font-family: inherit; cursor: pointer; transition: all .2s; }
        .mfb-cancel-btn:hover { border-color: var(--accent); color: var(--text-white); }

        /* ── EMPTY ── */
        .empty-state { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--text-dim); text-align: center; }
        .empty-state svg { width: 48px; height: 48px; stroke: var(--text-dim); fill: none; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; opacity: .5; }
        .empty-state p { font-size: 14px; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar { width: 100% !important; flex-direction: row; height: 56px; padding: 0 16px; gap: 8px; border-right: none; border-bottom: 1px solid var(--border); }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-icon { width: 34px; height: 34px; min-width: 34px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png" alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item active" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Support/HowToUse" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>
        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="Profile"
               style="height:auto; padding:8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <a class="btn-back" href="/Chat/Flashcards">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Back
            </a>
            <div class="set-header">
                <div class="set-title">@setName</div>
                <div class="set-meta">
                    @sessionCount @(sessionCount == 1 ? "Set" : "Sets")
                    <span class="dot"></span>
                    @setDate
                </div>
            </div>
        </header>

        <div class="content">
            <div class="section-label">Flashcard Sets</div>
            <div class="cards-grid">
                @if (sessions == null || !sessions.Any())
                {
                    <!-- New Flashcard Set card always shown -->
                    <div class="card-fc" onclick="openMfbModal()"
                         style="border-style:dashed; border-color:rgba(124,92,191,.4); background:transparent; cursor:pointer; min-height:200px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; animation-delay:0s;">
                        <div style="width:44px; height:44px; border-radius:50%; background:var(--accent-soft); border:1.5px dashed var(--accent); display:flex; align-items:center; justify-content:center; color:var(--accent);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </div>
                        <span style="font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; color:var(--text-muted);">New Flashcard Set</span>
                    </div>
                }
                else
                {
                    <!-- New Flashcard Set card -->
                        <div class="card-fc" onclick="openMfbModal()"
                         style="border-style:dashed; border-color:rgba(124,92,191,.4); background:transparent; cursor:pointer; min-height:200px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px; animation-delay:0s;">
                        <div style="width:44px; height:44px; border-radius:50%; background:var(--accent-soft); border:1.5px dashed var(--accent); display:flex; align-items:center; justify-content:center; color:var(--accent);">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                        </div>
                        <span style="font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600; color:var(--text-muted);">New Flashcard Set</span>
                    </div>
                    int i = 0;
                    foreach (var s in sessions)
                    {
                        long cardCount = (long)s.CardCount;
                        long gotCount  = (long)s.GotCount;
                        int  pct       = cardCount > 0 ? (int)Math.Round((double)gotCount / cardCount * 100) : 0;
                        <div class="card-fc"
                             onclick="window.location.href='/Chat/FlashcardStudy?sessionId=@(s.SessionId)'"
                             data-sid="@(s.SessionId)"
                             style="animation-delay: @(i * 0.05)s">

                            <!-- Banner with card.png icon -->
                            <div class="card-fc-banner">
                                <span class="banner-chip">@s.CardCount Flashcards</span>
                                <div class="fc-stack">
                                    <img class="fc-card-img" src="~/images/card.png" alt="flashcard icon" />
                                </div>
                            </div>

                            <!-- Chips + three-dot -->
                            <div class="card-fc-top" onclick="event.stopPropagation()">
                                <div class="chips-row">
                                    <div class="chip chip-buddy" onclick="event.stopPropagation(); openStudyBuddy(@(s.SessionId), '@Html.Raw(s.Title.Replace("'", "\\'"))')">
                                        <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                        Study Buddy
                                    </div>
                                </div>
                                <div style="display:flex; align-items:center; gap:6px;">
                                    @if ((bool)(s.IsManual ?? false))
                                    {
                                        <div class="chip-user-made" style="margin-bottom:0;">
                                            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                            User Made
                                        </div>
                                    }
                                    <div style="position:relative;">
                                        <button class="btn-dots" onclick="toggleMenu(@(s.SessionId))">
                                            <span></span><span></span><span></span>
                                        </button>
                                        <div class="dots-menu" id="menu-@(s.SessionId)">
                                            <div class="menu-item" onclick="openRename(@(s.SessionId), '@Html.Raw(s.Title.Replace("'", "\\'"))')">
                                                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                                Rename
                                            </div>
                                            <div class="menu-item danger" onclick="openDelete(@(s.SessionId), '@Html.Raw(s.Title.Replace("'", "\\'"))')">
                                                <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                                                Delete
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Body -->
                            <div class="card-fc-body">
                                <div class="fc-name" id="title-@(s.SessionId)">@s.Title</div>
                                <div>
                                    <div class="fc-prog-row">
                                        <span>Progress</span>
                                        <span>@gotCount/@cardCount</span>
                                    </div>
                                    <div class="fc-prog-bar">
                                        <div class="fc-prog-fill" style="width:@(pct)%"></div>
                                    </div>
                                </div>
                                <div class="card-fc-meta">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @s.Date
                                </div>
                            </div>
                        </div>
                        i++;
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- ── MANUAL FLASHCARD BUILDER MODAL ── -->
<div class="mfb-overlay" id="mfbOverlay" onclick="handleMfbOverlayClick(event)">
    <div class="mfb-modal">
        <div class="mfb-header">
            <div>
                <div class="mfb-title">Create Flashcard Set</div>
                <div class="mfb-subtitle">Add front/back pairs, then save.</div>
            </div>
            <button class="mfb-close" onclick="closeMfbModal()">✕</button>
        </div>
        <div class="mfb-name-row">
            <span style="font-size:11px; font-weight:700; color:var(--text-muted); text-transform:uppercase; letter-spacing:.6px; margin-bottom:6px; display:block;">Set Title *</span>
            <input class="mfb-name-input" id="mfbSetTitle" type="text"
                   placeholder="e.g. Chapter 1 Vocab, Week 3 Terms…"
                   oninput="mfbUpdateFooter()" />
        </div>
        <div class="mfb-cards-area" id="mfbCardsArea"></div>
        <div style="padding: 0 24px 12px;">
            <button class="mfb-add-btn" onclick="mfbAddCard()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add Card
            </button>
        </div>
        <div class="mfb-footer">
            <span style="font-size:12px; color:var(--text-muted);" id="mfbCardCount">0 cards</span>
            <div style="display:flex; gap:10px;">
                <button class="mfb-cancel-btn" onclick="closeMfbModal()">Cancel</button>
                <button class="mfb-save-btn" id="mfbSaveBtn" onclick="mfbSaveSet()" disabled>Save Set</button>
            </div>
        </div>
    </div>
</div>

<!-- ── RENAME MODAL ── -->
<div id="renameModal" style="display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.55); backdrop-filter:blur(4px); align-items:center; justify-content:center;">
    <div style="background:var(--card-bg); border:1px solid var(--border); border-radius:16px; padding:28px; width:360px; font-family:'Poppins',sans-serif;">
        <div style="font-family:'Poppins',sans-serif; font-size:16px; font-weight:800; color:var(--text-white); margin-bottom:6px;">Rename Set</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:20px;">Enter a new name for this flashcard set.</div>
        <input id="renameInput" type="text" placeholder="Set name…"
            style="width:100%; height:42px; background:#13101f; border:1px solid var(--border); border-radius:10px; padding:0 14px; color:var(--text-white); font-size:13px; font-family:inherit; outline:none; margin-bottom:20px; transition:border-color .2s;"
            onfocus="this.style.borderColor='var(--accent)'" onblur="this.style.borderColor='var(--border)'"
        />
        <div style="display:flex; gap:10px;">
            <button onclick="closeRename()" style="flex:1; height:40px; border-radius:9px; border:1px solid var(--border); background:transparent; color:var(--text-white); font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">Cancel</button>
            <button onclick="submitRename()" style="flex:2; height:40px; border-radius:9px; border:none; background:var(--accent); color:#fff; font-family:'Poppins',sans-serif; font-size:13px; font-weight:700; cursor:pointer;">Save</button>
        </div>
    </div>
</div>

<!-- ── DELETE MODAL ── -->
<div id="deleteModal" style="display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.55); backdrop-filter:blur(4px); align-items:center; justify-content:center;">
    <div style="background:var(--card-bg); border:1px solid rgba(220,60,60,.2); border-radius:16px; padding:28px; width:360px; font-family:'Poppins',sans-serif; text-align:center;">
        <div style="width:48px; height:48px; border-radius:14px; background:rgba(220,60,60,.12); display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                <path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/>
            </svg>
        </div>
        <div style="font-family:'Poppins',sans-serif; font-size:16px; font-weight:800; color:var(--text-white); margin-bottom:8px;">Delete Set?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            "<span id="deleteSetName"></span>" will be permanently deleted along with all its flashcards and quizzes.
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="closeDelete()" style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border); background:transparent; color:var(--text-white); font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">Cancel</button>
            <button onclick="submitDelete()" style="flex:1; height:38px; border-radius:9px; border:none; background:#c0392b; color:#fff; font-family:'Poppins',sans-serif; font-size:13px; font-weight:700; cursor:pointer;">Yes, Delete</button>
        </div>
    </div>
</div>

<!-- ── LOGOUT MODAL ── -->
<div id="logoutModal" style="display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.55); backdrop-filter:blur(4px); align-items:center; justify-content:center;">
    <div style="background:var(--card-bg); border:1px solid var(--border); border-radius:16px; padding:28px 28px 24px; width:340px; text-align:center; font-family:'Poppins',sans-serif;">
        <div style="width:48px; height:48px; border-radius:14px; background:rgba(220,60,60,.12); display:flex; align-items:center; justify-content:center; margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Poppins',sans-serif; font-size:16px; font-weight:800; color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">Are you sure you want to log out of Rev'nLearn?</div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border); background:transparent; color:var(--text-white); font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; cursor:pointer;">Cancel</button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none; background:#c0392b; color:#fff; text-decoration:none; font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; cursor:pointer; display:flex; align-items:center; justify-content:center;">Yes, Log Out</a>
        </div>
    </div>
</div>

<script>
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();

    // ── THREE-DOT MENU ──
    let openMenuId = null;
    function toggleMenu(sid) {
        const menu = document.getElementById('menu-' + sid);
        if (openMenuId && openMenuId !== sid) {
            const prev = document.getElementById('menu-' + openMenuId);
            if (prev) prev.classList.remove('open');
        }
        menu.classList.toggle('open');
        openMenuId = menu.classList.contains('open') ? sid : null;
    }
    document.addEventListener('click', function (e) {
        if (!e.target.closest('.btn-dots') && !e.target.closest('.dots-menu')) {
            document.querySelectorAll('.dots-menu.open').forEach(m => m.classList.remove('open'));
            openMenuId = null;
        }
    });

    // ── RENAME ──
    let renameSessionId = null;
    function openRename(sid, currentTitle) {
        renameSessionId = sid;
        document.getElementById('renameInput').value = currentTitle;
        document.getElementById('renameModal').style.display = 'flex';
        document.querySelectorAll('.dots-menu.open').forEach(m => m.classList.remove('open'));
        setTimeout(() => document.getElementById('renameInput').focus(), 50);
    }
    function closeRename() {
        document.getElementById('renameModal').style.display = 'none';
        renameSessionId = null;
    }
    async function submitRename() {
        const title = document.getElementById('renameInput').value.trim();
        if (!title) return;
        try {
            const res = await fetch('/Chat/RenameSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: renameSessionId, title })
            });
            if (res.ok) {
                const el = document.getElementById('title-' + renameSessionId);
                if (el) el.textContent = title;
                closeRename();
            }
        } catch (e) { console.error(e); }
    }

    // ── MANUAL FLASHCARD BUILDER ──
    let mfbCards = [];
    const mfbProjectId = @projectId;

    function openMfbModal() {
        mfbCards = [];
        document.getElementById('mfbSetTitle').value = '';
        document.getElementById('mfbCardsArea').innerHTML = '';
        mfbUpdateFooter();
        document.getElementById('mfbOverlay').classList.add('open');
        setTimeout(() => document.getElementById('mfbSetTitle').focus(), 100);
    }
    function closeMfbModal() { document.getElementById('mfbOverlay').classList.remove('open'); }
    function handleMfbOverlayClick(e) { if (e.target === document.getElementById('mfbOverlay')) closeMfbModal(); }

    function mfbUpdateFooter() {
        const count = mfbCards.length;
        document.getElementById('mfbCardCount').textContent = `${count} card${count !== 1 ? 's' : ''}`;
        const title = document.getElementById('mfbSetTitle').value.trim();
        document.getElementById('mfbSaveBtn').disabled = count === 0 || !title;
    }

    function mfbAddCard() {
        const idx = mfbCards.length;
        mfbCards.push({ front: '', back: '' });
        renderMfbCard(idx);
        mfbUpdateFooter();
        setTimeout(() => {
            const area = document.getElementById('mfbCardsArea');
            area.scrollTop = area.scrollHeight;
        }, 50);
    }

    function mfbDeleteCard(idx) {
        mfbCards.splice(idx, 1);
        rebuildMfbCards();
        mfbUpdateFooter();
    }

    function rebuildMfbCards() {
        document.getElementById('mfbCardsArea').innerHTML = '';
        mfbCards.forEach((_, i) => renderMfbCard(i));
    }

    function renderMfbCard(idx) {
        const area = document.getElementById('mfbCardsArea');
        const card = document.createElement('div');
        card.className = 'mfb-card';
        card.id = `mfbCard_${idx}`;
        card.innerHTML = `
            <div class="mfb-card-top">
                <span class="mfb-card-num">Card ${idx + 1}</span>
                <button class="mfb-card-delete" onclick="mfbDeleteCard(${idx})">✕</button>
            </div>
            <div>
                <span class="mfb-input-label">Front (Question)</span>
                <textarea class="mfb-input" id="mfbFront_${idx}" placeholder="Enter the front of the card…"
                    oninput="mfbCards[${idx}].front = this.value">${mfbCards[idx].front}</textarea>
            </div>
            <div>
                <span class="mfb-input-label">Back (Answer)</span>
                <textarea class="mfb-input" id="mfbBack_${idx}" placeholder="Enter the back of the card…"
                    oninput="mfbCards[${idx}].back = this.value">${mfbCards[idx].back}</textarea>
            </div>`;
        area.appendChild(card);
    }

    async function mfbSaveSet() {
        const title = document.getElementById('mfbSetTitle').value.trim();
        if (!title) { alert('Please enter a set title.'); return; }
        if (mfbCards.length === 0) { alert('Please add at least one card.'); return; }
        for (let i = 0; i < mfbCards.length; i++) {
            if (!mfbCards[i].front.trim()) { alert(`Card ${i + 1} is missing its front (question).`); return; }
            if (!mfbCards[i].back.trim())  { alert(`Card ${i + 1} is missing its back (answer).`); return; }
        }
        const btn = document.getElementById('mfbSaveBtn');
        btn.disabled = true; btn.textContent = 'Saving…';
        try {
            const res = await fetch('/Chat/CreateManualFlashcardSession', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    projectId: mfbProjectId,
                    title,
                    cards: mfbCards.map(c => ({ front: c.front.trim(), back: c.back.trim() }))
                })
            });
            if (!res.ok) { const t = await res.text(); alert(`Server error ${res.status}: ${t.substring(0,300)}`); return; }
            const data = await res.json();
            if (data.error) { alert('Error: ' + data.error); return; }
            closeMfbModal();
            location.reload();
        } catch (err) {
            alert('Network error: ' + err.message);
        } finally {
            btn.disabled = false; btn.textContent = 'Save Set';
        }
    }
    
    document.getElementById('renameInput').addEventListener('keydown', e => {
        if (e.key === 'Enter') submitRename();
        if (e.key === 'Escape') closeRename();
    });

    // ── STUDY BUDDY ──
    async function openStudyBuddy(sessionId, title) {
        try {
            const res = await fetch(`/Chat/GetFlashcardsForStudyBuddy?sessionId=${sessionId}`);
            const cards = await res.json();
            if (!cards || !cards.length) { alert('No flashcards found in this set.'); return; }
            // Convert flashcards into the question format Study Buddy expects
            const questions = cards.map(c => ({
                question:     c.front,
                questionType: 'fillblank',
                answerText:   c.back,
                correctAnswer: '',
                choiceA: '', choiceB: '', choiceC: '', choiceD: ''
            }));
            SB.open(title, questions);
        } catch (e) {
            console.error('Study Buddy error:', e);
        }
    }

    // ── DELETE ──
    let deleteSessionId = null;
    function openDelete(sid, title) {
        deleteSessionId = sid;
        document.getElementById('deleteSetName').textContent = title;
        document.getElementById('deleteModal').style.display = 'flex';
        document.querySelectorAll('.dots-menu.open').forEach(m => m.classList.remove('open'));
    }
    function closeDelete() {
        document.getElementById('deleteModal').style.display = 'none';
        deleteSessionId = null;
    }
    async function submitDelete() {
        try {
            const res = await fetch('/Chat/DeleteSession?id=' + deleteSessionId, { method: 'DELETE' });
            if (res.ok) {
                // Remove the card from the DOM
                const card = document.querySelector(`[data-sid="${deleteSessionId}"]`);
                if (card) card.remove();
                closeDelete();
                // Reload to refresh count in topbar
                location.reload();
            }
        } catch (e) { console.error(e); }
    }
</script>
<script src="~/js/StudyBuddy.js"></script>
</body>
</html>