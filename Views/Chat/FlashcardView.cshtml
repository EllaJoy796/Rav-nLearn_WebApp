@{
    ViewData["Title"] = "Flashcard Set";
    Layout = null;

    // Sample data fallback
    var setName  = ViewBag.SetName  ?? "LINUX REVIEWER";
    var setDate  = ViewBag.SetDate  ?? "May 13, 2026";
    var cards    = ViewBag.Cards    as IEnumerable<dynamic>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn – @setName</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:               #0d0d12;
            --sidebar-bg:       #111118;
            --sidebar-width:    72px;
            --sidebar-expanded: 220px;
            --card-bg:          #1e1a2e;
            --card-hover:       #251f3a;
            --accent:           #7c5cbf;
            --accent-soft:      rgba(124,92,191,.18);
            --accent-chip:      #5a3f9e;
            --text-white:       #f0eeff;
            --text-muted:       #7a7490;
            --text-dim:         #4e4868;
            --border:           rgba(124,92,191,.12);
            --topbar-h:         64px;
        }

        html, body {
            height: 100%;
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            color: var(--text-white);
            overflow: hidden;
        }

        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding: 16px 0;
            flex-shrink: 0;
            z-index: 100;
            overflow: hidden;
            transition: width .25s ease;
        }
        .sidebar:hover { width: var(--sidebar-expanded); }

        .sidebar-logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 15px;
            margin-bottom: 28px;
            overflow: hidden;
        }
        .logo-icon {
            width: 42px; height: 42px; min-width: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 15px; font-weight: 800;
            color: var(--text-white); white-space: nowrap;
            opacity: 0; transition: opacity .2s ease .05s;
        }
        .sidebar:hover .logo-text { opacity: 1; }

        .nav-group {
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }
        .nav-group + .nav-group {
            margin-top: 8px; padding-top: 16px;
            border-top: 1px solid var(--border);
        }
        .nav-group-label {
            font-size: 10px; font-weight: 700;
            color: var(--text-dim); letter-spacing: .8px;
            text-transform: uppercase;
            padding: 0 4px; margin-bottom: 6px;
            white-space: nowrap; opacity: 0;
            max-height: 0; overflow: hidden;
            transition: opacity .2s ease, max-height .2s ease;
        }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }

        .nav-item {
            width: 100%; height: 44px; border-radius: 10px;
            display: flex; align-items: center; gap: 12px;
            padding: 0 11px; cursor: pointer;
            transition: background .2s ease, color .2s ease;
            color: white; text-decoration: none;
            overflow: hidden; white-space: nowrap;
            position: relative;
        }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg {
            width: 20px; height: 20px; min-width: 20px;
            stroke: currentColor; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .nav-label {
            font-size: 13px; font-weight: 600;
            opacity: 0; transition: opacity .2s ease .05s; overflow: hidden;
        }
        .sidebar:hover .nav-label { opacity: 1; }

        .nav-item::after {
            content: attr(data-tip);
            position: absolute; left: 82px;
            background: #1e1e2e; color: var(--text-white);
            font-size: 12px; font-weight: 600;
            padding: 5px 10px; border-radius: 6px;
            white-space: nowrap; pointer-events: none;
            opacity: 0; transition: opacity .15s ease;
            border: 1px solid var(--border); z-index: 200;
        }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }

        .sidebar-bottom {
            margin-top: auto;
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }

        /* ══════════ MAIN ══════════ */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

        /* ── TOP BAR ── */
        .topbar {
            height: var(--topbar-h);
            display: flex; align-items: center; gap: 16px;
            padding: 0 28px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .btn-back {
            display: flex; align-items: center; gap: 8px;
            background: transparent;
            border: 1px solid var(--border);
            border-radius: 10px;
            color: var(--text-white);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            padding: 0 14px; height: 36px;
            cursor: pointer; text-decoration: none;
            flex-shrink: 0;
            transition: background .2s ease, border-color .2s ease;
        }
        .btn-back:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-back svg {
            width: 14px; height: 14px;
            stroke: currentColor; fill: none;
            stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round;
        }

        .set-header { display: flex; flex-direction: column; gap: 2px; flex: 1; }

        .set-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px; font-weight: 900;
            color: var(--text-white); letter-spacing: -.3px;
        }

        .set-meta {
            font-size: 12px; color: var(--text-muted);
            display: flex; align-items: center; gap: 6px;
        }
        .set-meta .dot { width: 3px; height: 3px; background: var(--text-dim); border-radius: 50%; }

        /* ── CONTENT ── */
        .content {
            flex: 1; overflow-y: auto;
            padding: 32px 28px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        .section-label {
            font-size: 13px; font-weight: 600;
            color: var(--text-muted); letter-spacing: .5px;
            margin-bottom: 20px;
        }

        /* ── GRID ── */
        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }

        /* ── INDIVIDUAL FLASHCARD ITEM ── */
        .fc-item {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            display: flex; flex-direction: column;
            padding: 16px;
            gap: 12px;
            cursor: pointer;
            transition: background .2s ease, border-color .2s ease, transform .15s ease;
            animation: fadeUp .4s ease both;
            position: relative;
        }
        .fc-item:hover {
            background: var(--card-hover);
            border-color: rgba(124,92,191,.35);
            transform: translateY(-2px);
        }
        .fc-item:nth-child(2) { animation-delay: .05s; }
        .fc-item:nth-child(3) { animation-delay: .10s; }
        .fc-item:nth-child(4) { animation-delay: .15s; }
        .fc-item:nth-child(5) { animation-delay: .20s; }
        .fc-item:nth-child(6) { animation-delay: .25s; }

        /* top row: Study Buddy chip + three-dot */
        .fc-item-toprow {
            display: flex; align-items: center; justify-content: space-between;
        }

        .chip-buddy {
            display: flex; align-items: center; gap: 6px;
            background: var(--accent-soft);
            border: 1px solid rgba(124,92,191,.25);
            border-radius: 20px;
            padding: 4px 10px 4px 8px;
            font-size: 11px; font-weight: 700;
            color: #c8b8f0; letter-spacing: .3px;
        }
        .chip-buddy svg {
            width: 13px; height: 13px;
            stroke: #c8b8f0; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }

        .btn-dots {
            background: none; border: 1px solid var(--border);
            border-radius: 7px; cursor: pointer;
            color: var(--text-dim);
            width: 28px; height: 28px;
            display: flex; align-items: center; justify-content: center;
            gap: 2.5px; flex-direction: column;
            transition: color .2s ease, background .2s ease;
        }
        .btn-dots:hover { color: var(--text-muted); background: var(--accent-soft); }
        .btn-dots span { width: 3px; height: 3px; background: currentColor; border-radius: 50%; display: block; }

        /* card name + sub */
        .fc-item-name {
            font-family: 'Syne', sans-serif;
            font-size: 15px; font-weight: 800;
            color: var(--text-white); letter-spacing: .3px;
        }
        .fc-item-sub {
            font-size: 12px; color: var(--text-muted);
            margin-top: 2px;
        }

        /* progress */
        .fc-prog-row {
            display: flex; align-items: center;
            justify-content: space-between;
            font-size: 11px; color: var(--text-muted);
        }
        .fc-prog-bar {
            height: 4px; background: rgba(124,92,191,.15);
            border-radius: 2px; overflow: hidden;
            margin-top: 6px;
        }
        .fc-prog-fill {
            height: 100%; background: var(--accent);
            border-radius: 2px; transition: width .4s ease;
        }

        /* study button */
        .btn-study {
            width: 100%; height: 38px;
            background: transparent;
            border: 1px solid rgba(124,92,191,.35);
            border-radius: 10px;
            color: var(--text-white);
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            display: flex; align-items: center; justify-content: center;
            gap: 8px; cursor: pointer;
            transition: background .2s ease, border-color .2s ease;
            margin-top: auto;
        }
        .btn-study:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-study svg {
            width: 14px; height: 14px;
            stroke: none; fill: currentColor;
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar {
                width: 100% !important; flex-direction: row;
                height: 56px; padding: 0 16px; gap: 8px;
                border-right: none; border-bottom: 1px solid var(--border);
            }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-icon { width: 34px; height: 34px; min-width: 34px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: 1fr 1fr; }
            .content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <!-- ══════════════ SIDEBAR ══════════════ -->
    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                     alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item active" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Help/Index" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>

        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="User">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="nav-label">Profile</span>
            </a>
            <a class="nav-item" href="/Account/Logout" data-tip="Log Out">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <!-- ══════════════ MAIN ══════════════ -->
    <div class="main">

        <!-- TOP BAR -->
        <header class="topbar">
            <a class="btn-back" href="/Chat/Flashcards">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Back
            </a>

            <div class="set-header">
                <div class="set-title">@setName</div>
                <div class="set-meta">
                    @(ViewBag.CardCount ?? 6) Flashcards
                    <span class="dot"></span>
                    @setDate
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <div class="content">
            <div class="section-label">Flashcard Sets</div>

            <div class="cards-grid" id="cardsGrid">

                @if (cards != null)
                {
                    int idx = 1;
                    foreach (var card in cards)
                    {
                        int progress = (int)Math.Round((double)(card.Studied ?? 0) / (double)(card.Total > 0 ? card.Total : 1) * 100);
                        <div class="fc-item" onclick="window.location.href='/Flashcards/Study/@card.Id'">
                            <div class="fc-item-toprow">
                            <div class="chip-buddy">
                                <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                Study Buddy
                            </div>
                                <button class="btn-dots" onclick="event.stopPropagation(); showCardMenu(@card.Id)">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                            <div>
                                <div class="fc-item-name">@card.Name?.ToUpper()</div>
                                <div class="fc-item-sub">@card.Total Cards</div>
                            </div>
                            <div>
                                <div class="fc-prog-row">
                                    <span>Progress</span>
                                    <span>@(card.Studied ?? 0)/@(card.Total ?? 0)</span>
                                </div>
                                <div class="fc-prog-bar">
                                    <div class="fc-prog-fill" style="width: @progress%"></div>
                                </div>
                            </div>
                            <button class="btn-study" onclick="event.stopPropagation(); window.location.href='/Flashcards/Study/@card.Id'">
                                <!-- play icon -->
                                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="none"/></svg>
                                Study the Flashcard
                            </button>
                        </div>
                        idx++;
                    }
                }
                else
                {
                    <!-- Demo cards (no real data) -->
                    @for (int i = 1; i <= 6; i++)
                    {
                        <div class="fc-item">
                            <div class="fc-item-toprow">
                                <div class="chip-buddy">
                                    <svg viewBox="0 0 24 24"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
                                    Study Buddy
                                </div>
                                <button class="btn-dots" onclick="event.stopPropagation()">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                            <div>
                                <div class="fc-item-name">FLASHCARD 0@i</div>
                                <div class="fc-item-sub">10 Cards</div>
                            </div>
                            <div>
                                <div class="fc-prog-row">
                                    <span>Progress</span>
                                    <span>5/8</span>
                                </div>
                                <div class="fc-prog-bar">
                                    <div class="fc-prog-fill" style="width: 62%"></div>
                                </div>
                            </div>
                            <button class="btn-study">
                                <svg viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3" fill="currentColor" stroke="none"/></svg>
                                Study the Flashcard
                            </button>
                        </div>
                    }
                }

            </div>
        </div>

    </div>
</div>

<script>
    function showCardMenu(cardId) {
        alert('Options for card ' + cardId);
    }
</script>
</body>
</html>
