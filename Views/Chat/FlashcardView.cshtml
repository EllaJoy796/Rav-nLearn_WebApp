@{
    ViewData["Title"] = "Flashcard Set";
    Layout = null;

    var setName      = (string)(ViewBag.SetName  ?? "FLASHCARD SET");
    var setDate      = (string)(ViewBag.SetDate  ?? "");
    var sessionCount = (int)(ViewBag.SessionCount ?? 0);
    var sessions     = ViewBag.Sessions as IEnumerable<dynamic>;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn – @setName</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:               #0d0d12;
            --sidebar-bg:       #111118;
            --sidebar-width:    72px;
            --sidebar-expanded: 220px;
            --card-bg:          #1e1a2e;
            --card-hover:       #251f3a;
            --accent:           #7c5cbf;
            --accent-soft:      rgba(124,92,191,.18);
            --accent-chip:      #5a3f9e;
            --text-white:       #f0eeff;
            --text-muted:       #7a7490;
            --text-dim:         #4e4868;
            --border:           rgba(124,92,191,.12);
            --topbar-h:         64px;
        }

        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --card-hover:  #ede9fa;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
        }
        body.light-mode .nav-item { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }
        body.light-mode .card-fc-banner { background: linear-gradient(135deg, #ded8f5 0%, #e8e3f8 100%); }

        html, body { height: 100%; background: var(--bg); font-family: 'DM Sans', sans-serif; color: var(--text-white); overflow: hidden; }
        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ══ SIDEBAR ══ */
        .sidebar { width: var(--sidebar-width); background: var(--sidebar-bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; align-items: flex-start; padding: 16px 0; flex-shrink: 0; z-index: 100; overflow: hidden; transition: width .25s ease; }
        .sidebar:hover { width: var(--sidebar-expanded); }
        .sidebar-logo { width: 100%; display: flex; align-items: center; gap: 10px; padding: 0 15px; margin-bottom: 28px; overflow: hidden; }
        .logo-icon { width: 42px; height: 42px; min-width: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text { font-family: 'Syne', sans-serif; font-size: 15px; font-weight: 800; color: var(--text-white); white-space: nowrap; opacity: 0; transition: opacity .2s ease .05s; }
        .sidebar:hover .logo-text { opacity: 1; }
        .nav-group { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }
        .nav-group + .nav-group { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border); }
        .nav-group-label { font-size: 10px; font-weight: 700; color: var(--text-dim); letter-spacing: .8px; text-transform: uppercase; padding: 0 4px; margin-bottom: 6px; white-space: nowrap; opacity: 0; max-height: 0; overflow: hidden; transition: opacity .2s ease, max-height .2s ease; }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }
        .nav-item { width: 100%; height: 44px; border-radius: 10px; display: flex; align-items: center; gap: 12px; padding: 0 11px; cursor: pointer; transition: background .2s ease, color .2s ease; color: white; text-decoration: none; overflow: hidden; white-space: nowrap; position: relative; }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg { width: 20px; height: 20px; min-width: 20px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
        .nav-label { font-size: 13px; font-weight: 600; opacity: 0; transition: opacity .2s ease .05s; overflow: hidden; }
        .sidebar:hover .nav-label { opacity: 1; }
        .nav-item::after { content: attr(data-tip); position: absolute; left: 82px; background: #1e1e2e; color: var(--text-white); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 6px; white-space: nowrap; pointer-events: none; opacity: 0; transition: opacity .15s ease; border: 1px solid var(--border); z-index: 200; }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }
        .sidebar-bottom { margin-top: auto; display: flex; flex-direction: column; align-items: flex-start; gap: 2px; width: 100%; padding: 0 12px; }

        /* ══ MAIN ══ */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }
        .topbar { height: var(--topbar-h); display: flex; align-items: center; gap: 16px; padding: 0 28px; border-bottom: 1px solid var(--border); flex-shrink: 0; }

        .btn-back { display: flex; align-items: center; gap: 8px; background: transparent; border: 1px solid var(--border); border-radius: 10px; color: var(--text-white); font-family: 'DM Sans', sans-serif; font-size: 13px; font-weight: 600; padding: 0 14px; height: 36px; cursor: pointer; text-decoration: none; flex-shrink: 0; transition: background .2s ease, border-color .2s ease; }
        .btn-back:hover { background: var(--accent-soft); border-color: var(--accent); }
        .btn-back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

        .set-header { display: flex; flex-direction: column; gap: 2px; flex: 1; }
        .set-title { font-family: 'Syne', sans-serif; font-size: 20px; font-weight: 900; color: var(--text-white); letter-spacing: -.3px; }
        .set-meta { font-size: 12px; color: var(--text-muted); display: flex; align-items: center; gap: 6px; }
        .set-meta .dot { width: 3px; height: 3px; background: var(--text-dim); border-radius: 50%; }

        /* ── CONTENT ── */
        .content { flex: 1; overflow-y: auto; padding: 32px 28px; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        .section-label { font-size: 13px; font-weight: 600; color: var(--text-muted); letter-spacing: .5px; margin-bottom: 20px; }

        /* ── GRID ── */
        .cards-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

        /* ── CARD ── */
        .card-fc { background: var(--card-bg); border: 1px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; cursor: pointer; position: relative; min-height: 200px; transition: background .2s ease, border-color .2s ease, transform .15s ease; animation: fadeUp .4s ease both; overflow: hidden; }
        .card-fc:hover { background: var(--card-hover); border-color: rgba(124,92,191,.3); transform: translateY(-2px); }

        .card-fc-banner { width: 100%; height: 110px; background: linear-gradient(135deg, #251f3a 0%, #1a1530 100%); display: flex; align-items: center; justify-content: center; position: relative; flex-shrink: 0; }
        .fc-stack { position: relative; width: 64px; height: 52px; display: flex; align-items: center; justify-content: center; }
        .fc-icon-back { width: 64px; height: 52px; }

        .banner-chip { position: absolute; top: 12px; left: 14px; padding: 3px 10px; background: var(--accent-chip); border-radius: 20px; font-size: 10px; font-weight: 700; color: #c8b8f0; letter-spacing: .5px; text-transform: uppercase; }

        .card-fc-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
        .fc-name { font-family: 'Syne', sans-serif; font-size: 14px; font-weight: 700; color: var(--text-white); letter-spacing: .3px; }
        .card-fc-meta { display: flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: 11px; margin-top: auto; }
        .card-fc-meta svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex-shrink: 0; }

        /* ── EMPTY ── */
        .empty-state { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 60px 20px; color: var(--text-dim); text-align: center; }
        .empty-state svg { width: 48px; height: 48px; stroke: var(--text-dim); fill: none; stroke-width: 1.2; stroke-linecap: round; stroke-linejoin: round; opacity: .5; }
        .empty-state p { font-size: 14px; }

        @@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar { width: 100% !important; flex-direction: row; height: 56px; padding: 0 16px; gap: 8px; border-right: none; border-bottom: 1px solid var(--border); }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-icon { width: 34px; height: 34px; min-width: 34px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .cards-grid { grid-template-columns: repeat(2, 1fr); }
            .content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png" alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item active" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>
        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Help/Index" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>
        <div class="sidebar-bottom">
            <a class="nav-item" href="/Account/Profile" data-tip="User">
                <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="nav-label">Profile</span>
            </a>
            <a class="nav-item" href="/Account/Logout" data-tip="Log Out">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <a class="btn-back" href="/Chat/Flashcards">
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
                Back
            </a>
            <div class="set-header">
                <div class="set-title">@setName</div>
                <div class="set-meta">
                    @sessionCount @(sessionCount == 1 ? "Set" : "Sets")
                    <span class="dot"></span>
                    @setDate
                </div>
            </div>
        </header>

        <div class="content">
            <div class="section-label">Flashcard Sets</div>
            <div class="cards-grid">
                @if (sessions == null || !sessions.Any())
                {
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        <p>No flashcard sets yet.<br>Generate a quiz in <strong>My Chats</strong> to populate this set.</p>
                    </div>
                }
                else
                {
                    int i = 0;
                    foreach (var s in sessions)
                    {
                        <div class="card-fc"
                             onclick="window.location.href='/Chat/FlashcardStudy?sessionId=@(s.SessionId)'"
                             style="animation-delay: @(i * 0.05)s">
                            <div class="card-fc-banner">
                                <span class="banner-chip">@s.CardCount Flashcards</span>
                                <div class="fc-stack">
                                    <svg class="fc-icon-back" viewBox="0 0 48 48" fill="none">
                                        <rect x="10" y="14" width="30" height="22" rx="3" stroke="rgba(255,255,255,0.35)" stroke-width="2" transform="rotate(-6 10 14)"/>
                                        <rect x="8" y="12" width="30" height="22" rx="3" fill="rgba(124,92,191,0.3)" stroke="rgba(255,255,255,0.7)" stroke-width="2"/>
                                    </svg>
                                </div>
                            </div>
                            <div class="card-fc-body">
                                <div class="fc-name">@s.Title</div>
                                <div class="card-fc-meta">
                                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                    @s.Date
                                </div>
                            </div>
                        </div>
                        i++;
                    }
                }
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();
</script>
</body>
</html>
