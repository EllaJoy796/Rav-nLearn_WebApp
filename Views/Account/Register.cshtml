@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RevnLearn - Sign Up</title>
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="~/favicon.png">
    <style>
        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-dark: #1e1e1e;
            --panel-dark: #1e1e1e;
            --input-bg: #323232;
            --input-border: #444;
            --text-white: #ffffff;
            --text-muted: #b4b4b4;
            --btn-bg: #ffffff;
            --btn-text: #000000;
            --btn-hover: #dddddd;
            --error-bg: #5a1a1a;
            --error-text: #ff8080;
            --focus-color: #7c5cbf;
        }

        html, body {
            height: 100%;
            background-color: var(--bg-dark);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        .page-wrapper {
            display: flex;
            height: 100vh;
            width: 100vw;
        }

        /* ─── LEFT SIDE: Illustration ─── */
        /* ─── LEFT SIDE: Illustration ─── */
        .left-panel {
            flex: 0 0 45%;
            background-color: var(--bg-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

        .left-panel img {
            width: 100%;
            max-width: 500px;
            height: auto;
            object-fit: contain;
            border-radius: 16px;
            animation: fadeInLeft 0.7s ease both;
            margin-left: 30%;
        }

        .left-panel .brand-fallback {
            text-align: center;
            animation: fadeInLeft 0.7s ease both;
        }

        .brand-fallback .logo-icon {
            width: 120px;
            height: 120px;
            background: linear-gradient(135deg, #7c5cbf, #4a90d9);
            border-radius: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 56px;
            margin: 0 auto 24px;
            box-shadow: 0 20px 60px rgba(124, 92, 191, 0.4);
        }

        .brand-fallback h2 {
            color: var(--text-white);
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .brand-fallback p {
            color: var(--text-muted);
            font-size: 14px;
            max-width: 260px;
            line-height: 1.6;
        }

        /* ─── RIGHT SIDE: Form Panel ─── */
        .right-panel {
            flex: 1;
            background-color: var(--panel-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            overflow-y: auto;
            animation: fadeInRight 0.7s ease both;
        }

        .form-container {
            width: 100%;
            max-width: 520px;
            padding: 8px 0;
        }

        /* ─── Heading ─── */
        .form-title {
            color: var(--text-white);
            font-size: clamp(26px, 3vw, 40px);
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .form-subtitle {
            color: var(--text-muted);
            font-size: 14px;
            margin-bottom: 32px;
        }

        /* ─── Error Banner ─── */
        .error-banner {
            background-color: var(--error-bg);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* ─── Form Fields ─── */
        .field-group {
            margin-bottom: 18px;
        }

        .field-group label {
            color: var(--text-white);
            font-size: 14px;
            font-weight: 600;
            display: block;
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper input {
            width: 100%;
            padding: 13px 16px;
            background-color: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 8px;
            color: var(--text-white);
            font-size: 14px;
            font-family: inherit;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
            outline: none;
        }

        .input-wrapper input:focus {
            border-color: var(--focus-color);
            box-shadow: 0 0 0 3px rgba(124, 92, 191, 0.15);
        }

        .input-wrapper input::placeholder {
            color: #666;
        }

        /* Show/hide password button */
        .btn-eye {
            position: absolute;
            right: 10px;
            background: var(--input-bg);
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 18px;
            padding: 4px 6px;
            border-radius: 4px;
            line-height: 1;
            transition: color 0.2s ease;
            user-select: none;
        }

        .btn-eye:hover {
            color: var(--text-white);
        }

        .input-wrapper.has-eye input {
            padding-right: 44px;
        }

        /* ─── Submit Button ─── */
        .btn-submit {
            width: 100%;
            padding: 15px;
            background-color: var(--btn-bg);
            color: var(--btn-text);
            font-size: 15px;
            font-weight: 700;
            font-family: inherit;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            margin-top: 10px;
            transition: background-color 0.2s ease, transform 0.1s ease;
            letter-spacing: 0.3px;
        }

        .btn-submit:hover {
            background-color: var(--btn-hover);
        }

        .btn-submit:active {
            transform: scale(0.99);
        }

        /* ─── Log In Row ─── */
        .bottom-row {
            text-align: center;
            margin-top: 24px;
            color: var(--text-muted);
            font-size: 13px;
        }

        .bottom-row a {
            color: var(--text-white);
            font-weight: 700;
            text-decoration: none;
            transition: opacity 0.2s;
        }

        .bottom-row a:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        /* ─── Animations ─── */
        @@keyframes fadeInLeft {
            from { opacity: 0; transform: translateX(-30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        @@keyframes fadeInRight {
            from { opacity: 0; transform: translateX(30px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        /* ─── Responsive ─── */
        @@media (max-width: 768px) {
            html, body { overflow: auto; }
            .page-wrapper { flex-direction: column; height: auto; min-height: 100vh; }
            .left-panel {
                flex: none;
                height: 200px;
                padding: 16px;
            }
            .left-panel img { max-width: 180px; }
            .right-panel { padding: 32px 24px; overflow-y: visible; }
        }
    </style>
</head>
<body>
    <div class="page-wrapper">

        <!-- LEFT: Image / Branding -->
        <div class="left-panel">
            @* Replace src with your actual image path, e.g. ~/images/Rev_nLearnBG1.png *@
            <img src="~/images/Rev_nLearnBG1.png"
                 alt="RavnLearn"
                 onerror="this.style.display='none'; document.getElementById('brand-fallback').style.display='block';" />
            <div class="brand-fallback" id="brand-fallback" style="display:none;">
                <div class="logo-icon">📚</div>
                <h2>RavnLearn</h2>
                <p>Create an account to organize your study resources.</p>
            </div>
        </div>

        <!-- RIGHT: Register Form -->
        <div class="right-panel">
            <div class="form-container">

                <h1 class="form-title">Create an account</h1>
                <p class="form-subtitle">Create an account to organize your study resources</p>

                @if (ViewBag.Error != null)
                {
                    <div class="error-banner">
                        <span>⚠️</span>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <form method="post" asp-action="Register" asp-controller="Account">
                    @Html.AntiForgeryToken()

                    <div class="field-group">
                        <label for="username">Username</label>
                        <div class="input-wrapper">
                            <input type="text"
                                   id="username"
                                   name="username"
                                   placeholder="Choose a username"
                                   autocomplete="username"
                                   required />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="email">Email</label>
                        <div class="input-wrapper">
                            <input type="email"
                                   id="email"
                                   name="email"
                                   placeholder="Enter your email"
                                   autocomplete="email"
                                   required />
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="password">Password</label>
                        <div class="input-wrapper has-eye">
                            <input type="password"
                                   id="password"
                                   name="password"
                                   placeholder="Create a password"
                                   autocomplete="new-password"
                                   required />
                            <button type="button"
                                    class="btn-eye"
                                    onclick="togglePassword('password', this)"
                                    title="Show/Hide password"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="2" y1="2" x2="22" y2="22" class="slash"/></svg></button>
                        </div>
                    </div>

                    <div class="field-group">
                        <label for="confirmPassword">Confirm Password</label>
                        <div class="input-wrapper has-eye">
                            <input type="password"
                                   id="confirmPassword"
                                   name="confirmPassword"
                                   placeholder="Repeat your password"
                                   autocomplete="new-password"
                                   required />
                            <button type="button"
                                    class="btn-eye"
                                    onclick="togglePassword('confirmPassword', this)"
                                    title="Show/Hide password"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/><line x1="2" y1="2" x2="22" y2="22" class="slash"/></svg></button>
                        </div>
                    </div>

                    <button type="submit" class="btn-submit">Sign Up</button>
                </form>

                <div class="bottom-row">
                    Already have an account? <a href="/Account/Login">Log in</a>
                </div>

            </div>
        </div>

    </div>

    <script>
        function togglePassword(inputId, btn) {
            const input = document.getElementById(inputId);
            const slash = btn.querySelector('.slash');
            if (input.type === 'password') {
                input.type = 'text';
                slash.style.display = 'none';
            } else {
                input.type = 'password';
                slash.style.display = '';
            }
        }

        // Client-side password match validation
        document.querySelector('form').addEventListener('submit', function (e) {
            const pw = document.getElementById('password').value;
            const cpw = document.getElementById('confirmPassword').value;
            if (pw !== cpw) {
                e.preventDefault();
                const existing = document.querySelector('.error-banner');
                if (existing) existing.remove();
                const banner = document.createElement('div');
                banner.className = 'error-banner';
                banner.innerHTML = '<span>⚠️</span><span>Passwords do not match.</span>';
                document.querySelector('.form-subtitle').insertAdjacentElement('afterend', banner);
            }
        });
    </script>
</body>
</html>
