@{
    ViewData["Title"] = "User Settings";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Rev'nLearn – Profile Settings</title>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --bg:               #0d0d12;
            --sidebar-bg:       #111118;
            --sidebar-width:    72px;
            --sidebar-expanded: 220px;
            --card-bg:          #1e1a2e;
            --card-hover:       #251f3a;
            --accent:           #7c5cbf;
            --accent-soft:      rgba(124,92,191,.18);
            --text-white:       #f0eeff;
            --text-muted:       #7a7490;
            --text-dim:         #4e4868;
            --border:           rgba(124,92,191,.12);
            --topbar-h:         64px;
            --section-bg:       #17151f;
        }

        /* ── LIGHT MODE ── */
        body.light-mode {
            --bg:          #f4f3ff;
            --sidebar-bg:  #ede9fa;
            --card-bg:     #ffffff;
            --section-bg:  #f9f8ff;
            --text-white:  #1a1535;
            --text-muted:  #5a5278;
            --text-dim:    #9590b0;
            --border:      rgba(124,92,191,.2);
            --accent-soft: rgba(124,92,191,.12);
        }
        body.light-mode .field-input { background: #edeaf8; color: var(--text-white); }
        body.light-mode .pref-row    { background: #edeaf8; }
        body.light-mode .nav-item     { color: #2d1f5e; }
        body.light-mode .nav-item.active { color: var(--accent); }
        body.light-mode .nav-group-label { color: #6b5fa0; }

        html, body {
            height: 100%;
            background: var(--bg);
            font-family: 'DM Sans', sans-serif;
            color: var(--text-white);
            overflow: hidden;
        }

        .shell { display: flex; height: 100vh; width: 100vw; }

        /* ══════════ SIDEBAR ══════════ */
        .sidebar {
            width: var(--sidebar-width);
            background: var(--sidebar-bg);
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding: 16px 0;
            flex-shrink: 0;
            z-index: 100;
            overflow: hidden;
            transition: width .25s ease;
            position: relative;
        }
        .sidebar:hover { width: var(--sidebar-expanded); }

        .sidebar-logo {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 15px;
            margin-bottom: 28px;
            overflow: hidden;
        }
        .logo-icon {
            width: 42px; height: 42px; min-width: 42px;
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
        }
        .logo-icon img { width: 38px; height: 38px; object-fit: contain; border-radius: 10px; }
        .logo-text {
            font-family: 'Syne', sans-serif;
            font-size: 15px; font-weight: 800;
            color: var(--text-white); white-space: nowrap;
            opacity: 0; transition: opacity .2s ease .05s;
        }
        .sidebar:hover .logo-text { opacity: 1; }

        .nav-group {
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }
        .nav-group + .nav-group {
            margin-top: 8px; padding-top: 16px;
            border-top: 1px solid var(--border);
        }
        .nav-group-label {
            font-size: 10px; font-weight: 700;
            color: var(--text-dim); letter-spacing: .8px;
            text-transform: uppercase;
            padding: 0 4px; margin-bottom: 6px;
            white-space: nowrap; opacity: 0;
            max-height: 0; overflow: hidden;
            transition: opacity .2s ease, max-height .2s ease;
        }
        .sidebar:hover .nav-group-label { opacity: 1; max-height: 20px; }

        .nav-item {
            width: 100%; height: 44px; border-radius: 10px;
            display: flex; align-items: center; gap: 12px;
            padding: 0 11px; cursor: pointer;
            transition: background .2s ease, color .2s ease;
            color: white; text-decoration: none;
            overflow: hidden; white-space: nowrap;
            position: relative;
        }
        .nav-item:hover { background: var(--accent-soft); color: var(--text-white); }
        .nav-item.active { background: var(--accent-soft); color: var(--accent); }
        .nav-item svg {
            width: 20px; height: 20px; min-width: 20px;
            stroke: currentColor; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .nav-label {
            font-size: 13px; font-weight: 600;
            opacity: 0; transition: opacity .2s ease .05s; overflow: hidden;
        }
        .sidebar:hover .nav-label { opacity: 1; }

        .nav-item::after {
            content: attr(data-tip);
            position: absolute; left: 82px;
            background: #1e1e2e; color: var(--text-white);
            font-size: 12px; font-weight: 600;
            padding: 5px 10px; border-radius: 6px;
            white-space: nowrap; pointer-events: none;
            opacity: 0; transition: opacity .15s ease;
            border: 1px solid var(--border); z-index: 200;
        }
        .sidebar:not(:hover) .nav-item:hover::after { opacity: 1; }

        .sidebar-bottom {
            margin-top: auto;
            display: flex; flex-direction: column;
            align-items: flex-start; gap: 2px;
            width: 100%; padding: 0 12px;
        }

        /* ══════════ MAIN ══════════ */
        .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; min-width: 0; }

        .topbar {
            height: var(--topbar-h);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 28px;
            border-bottom: 1px solid var(--border);
            flex-shrink: 0;
        }

        .page-title {
            font-family: 'Syne', sans-serif;
            font-size: 20px; font-weight: 900;
            color: var(--text-white); letter-spacing: -.3px;
        }

        .avatar-chip {
            width: 38px; height: 38px;
            border-radius: 10px;
            background: var(--accent);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif;
            font-size: 14px; font-weight: 800;
            color: #fff;
        }

        /* ══════════ CONTENT ══════════ */
        .content {
            flex: 1; overflow-y: auto;
            padding: 32px 28px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }
        .content::-webkit-scrollbar { width: 4px; }
        .content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }

        /* ══════════ SECTIONS ══════════ */
        .settings-section {
            background: var(--section-bg);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 20px;
            max-width: 720px;   /* ← add this */
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 20px;
        }

        .section-title {
            font-family: 'Syne', sans-serif;
            font-size: 16px; font-weight: 800;
            color: var(--text-white);
        }

        .btn-edit {
            display: flex; align-items: center; gap: 6px;
            background: var(--accent);
            border: none; border-radius: 8px;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 13px; font-weight: 600;
            padding: 0 14px; height: 34px;
            cursor: pointer;
            transition: background .2s ease;
        }
        .btn-edit:hover { background: #6b4daa; }
        .btn-edit svg {
            width: 14px; height: 14px;
            stroke: currentColor; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }

        /* ── FORM FIELDS ── */
        .field-group {
            display: flex; flex-direction: column;
            gap: 4px; margin-bottom: 16px;
        }
        .field-group:last-child { margin-bottom: 0; }

        .field-label {
            font-size: 12px; font-weight: 600;
            color: var(--text-muted);
        }

        .field-input {
            width: 100%; max-width: 340px;
            height: 40px;
            background: #0f0d18;
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 0 14px;
            color: var(--text-white);
            font-size: 13px;
            font-family: inherit;
            outline: none;
            transition: border-color .2s ease;
        }
        .field-input:focus { border-color: var(--accent); }
        .field-input:disabled { opacity: .5; cursor: not-allowed; }

        /* ── DISPLAY PREFERENCE ROW ── */
        .pref-row {
            display: flex; align-items: center;
            gap: 14px;
            background: #0f0d18;
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 14px 16px;
        }

        .pref-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            background: var(--accent-soft);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .pref-icon svg {
            width: 18px; height: 18px;
            stroke: #c8b8f0; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }

        .pref-text { flex: 1; }
        .pref-name {
            font-size: 14px; font-weight: 600;
            color: var(--text-white);
        }
        .pref-sub {
            font-size: 11px; color: var(--text-muted);
            margin-top: 2px;
        }

        /* Toggle */
        .toggle-wrap { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
        .toggle-wrap input { opacity: 0; width: 0; height: 0; position: absolute; }
        .toggle-track {
            position: absolute; inset: 0;
            background: #2a2640;
            border-radius: 12px;
            cursor: pointer;
            transition: background .2s ease;
        }
        .toggle-wrap input:checked + .toggle-track { background: var(--accent); }
        .toggle-thumb {
            position: absolute;
            top: 3px; left: 3px;
            width: 18px; height: 18px;
            background: #fff;
            border-radius: 50%;
            transition: transform .2s ease;
            pointer-events: none;
        }
        .toggle-wrap input:checked ~ .toggle-thumb { transform: translateX(20px); }

        @@media (max-width: 640px) {
            html, body { overflow: auto; }
            .shell { flex-direction: column; height: auto; min-height: 100vh; }
            .sidebar {
                width: 100% !important; flex-direction: row;
                height: 56px; padding: 0 16px; gap: 8px;
                border-right: none; border-bottom: 1px solid var(--border);
            }
            .sidebar-logo { margin-bottom: 0; margin-right: 8px; }
            .logo-text { opacity: 1; }
            .nav-group { flex-direction: row; padding: 0 4px; }
            .nav-group + .nav-group { margin-top: 0; padding-top: 0; border-top: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--border); }
            .nav-group-label { display: none; }
            .sidebar-bottom { margin-top: 0; margin-left: auto; flex-direction: row; padding: 0 4px; }
            .nav-item::after { display: none; }
            .nav-label { display: none; }
            .content { padding: 20px 16px; }
        }
    </style>
</head>
<body>
<div class="shell">

    <aside class="sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon">
                <img src="~/images/Untitled_design__4_-removebg-preview (1).png"
                     alt="Rev'nLearn"
                     onerror="this.style.display='none'; this.parentElement.innerHTML='🐦';" />
            </div>
            <span class="logo-text">Rev'nLearn</span>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Main</div>
            <a class="nav-item" href="/Chat/MyChats" data-tip="Home / Chat">
                <svg viewBox="0 0 24 24"><path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5z"/><polyline points="9 21 9 12 15 12 15 21"/></svg>
                <span class="nav-label">Home / Chat</span>
            </a>
            <a class="nav-item" href="/Chat/Flashcards" data-tip="Flashcards">
                <svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                <span class="nav-label">Flashcards</span>
            </a>
            <a class="nav-item" href="/Chat/Quizzes" data-tip="Quizzes">
                <svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                <span class="nav-label">Quizzes</span>
            </a>
        </div>

        <div class="nav-group">
            <div class="nav-group-label">Support</div>
            <a class="nav-item" href="/Help/Index" data-tip="How to use">
                <svg viewBox="0 0 24 24"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                <span class="nav-label">How to use</span>
            </a>
        </div>

        <div class="sidebar-bottom">
            <a class="nav-item active" href="/Account/Profile" data-tip="Profile" style="height:auto; padding: 8px 11px; align-items:flex-start;">
                <svg viewBox="0 0 24 24" style="margin-top:2px; flex-shrink:0;"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <span class="nav-label" style="display:flex; flex-direction:column; gap:1px; overflow:hidden;">
                    <span style="font-size:13px; font-weight:700; color:var(--text-white);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Username ?? "Profile")
                    </span>
                    <span style="font-size:11px; font-weight:400; color:var(--text-muted);
                                 white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                        @(ViewBag.Email ?? "")
                    </span>
                </span>
            </a>
            <a class="nav-item" href="#" data-tip="Log Out"
               onclick="event.preventDefault(); document.getElementById('logoutModal').style.display='flex';">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                <span class="nav-label">Log Out</span>
            </a>
        </div>
    </aside>

    <div class="main">

        <header class="topbar">
            <span class="page-title">Profile Settings</span>
            <div class="avatar-chip">@(ViewBag.UserInitial ?? "?")</div>
        </header>

        <div class="content">

            <!-- Personal Information -->
            <div class="settings-section">
                <div class="section-header">
                    <span class="section-title">Personal Information</span>
                    <button class="btn-edit" onclick="toggleEdit()">
                        <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        Edit
                    </button>
                </div>

                <div class="field-group">
                    <label class="field-label">Username</label>
                    <input class="field-input" id="usernameInput" type="text"
                           value="@(ViewBag.Username ?? "")" disabled />
                </div>

                <div class="field-group">
                    <label class="field-label">Email</label>
                    <input class="field-input" id="emailInput" type="email"
                           value="@(ViewBag.Email ?? "")" disabled
                           style="opacity:.4; cursor:not-allowed;" />
                </div>

                <div id="saveRow" style="display:none; margin-top:16px; display:none; gap:8px;">
                    <button class="btn-edit" onclick="saveProfile()" style="background:#5a3f9e;">Save</button>
                    <button class="btn-edit" onclick="cancelEdit()" style="background:#2a2640;">Cancel</button>
                </div>
            </div>

            <!-- Display Preferences -->
            <div class="settings-section">
                <div class="section-header">
                    <span class="section-title">Display Preferences</span>
                </div>

                <div class="pref-row">
                    <div class="pref-icon">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
                    </div>
                    <div class="pref-text">
                        <div class="pref-name">Light Mode</div>
                        <div class="pref-sub">Based on your system preference</div>
                    </div>
                    <label class="toggle-wrap">
                        <input type="checkbox" id="lightToggle" onchange="toggleLightMode(this.checked)" />
                        <div class="toggle-track"></div>
                        <div class="toggle-thumb"></div>
                    </label>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ── LOGOUT CONFIRMATION MODAL ── -->
<div id="logoutModal" style="
    display:none; position:fixed; inset:0; z-index:1000;
    background:rgba(0,0,0,.55); backdrop-filter:blur(4px);
    align-items:center; justify-content:center;">
    <div style="
        background:var(--card-bg); border:1px solid var(--border);
        border-radius:16px; padding:28px 28px 24px;
        width:340px; text-align:center;
        font-family:'DM Sans',sans-serif;">
        <div style="
            width:48px; height:48px; border-radius:14px;
            background:rgba(220,60,60,.12);
            display:flex; align-items:center; justify-content:center;
            margin:0 auto 16px;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="#e05555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
        </div>
        <div style="font-family:'Syne',sans-serif; font-size:16px; font-weight:800;
                    color:var(--text-white); margin-bottom:8px;">Log Out?</div>
        <div style="font-size:13px; color:var(--text-muted); margin-bottom:24px;">
            Are you sure you want to log out of Rev'nLearn?
        </div>
        <div style="display:flex; gap:10px; justify-content:center;">
            <button onclick="document.getElementById('logoutModal').style.display='none'"
                style="flex:1; height:38px; border-radius:9px; border:1px solid var(--border);
                       background:transparent; color:var(--text-white);
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer;">
                Cancel
            </button>
            <a href="/Account/Logout"
                style="flex:1; height:38px; border-radius:9px; border:none;
                       background:#c0392b; color:#fff; text-decoration:none;
                       font-family:'DM Sans',sans-serif; font-size:13px; font-weight:600;
                       cursor:pointer; display:flex; align-items:center; justify-content:center;">
                Yes, Log Out
            </a>
        </div>
    </div>
</div>

<script>
    let editing = false;

    function toggleEdit() {
        editing = !editing;
        document.getElementById('usernameInput').disabled = !editing;
        document.getElementById('saveRow').style.display = editing ? 'flex' : 'none';
    }

    function cancelEdit() {
        editing = false;
        document.getElementById('usernameInput').disabled = true;
        document.getElementById('saveRow').style.display = 'none';
    }

    function saveProfile() {
        const username = document.getElementById('usernameInput').value;
        const email    = document.getElementById('emailInput').value;
        fetch('/Account/UpdateProfile', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, email })
        })
        .then(r => r.json())
        .then(d => {
            if (d.success) cancelEdit();
            else alert('Failed to save: ' + (d.error ?? 'Unknown error'));
        })
        .catch(() => alert('Request failed.'));
    }

    /* ── THEME INIT ── */
    (function () {
        if (localStorage.getItem('lightMode') === 'true')
            document.body.classList.add('light-mode');
    })();

    function toggleLightMode(on) {
        document.body.classList.toggle('light-mode', on);
        localStorage.setItem('lightMode', on ? 'true' : 'false');
    }

    document.addEventListener('DOMContentLoaded', function () {
        const toggle = document.getElementById('lightToggle');
        if (toggle) toggle.checked = localStorage.getItem('lightMode') === 'true';
    });
</script>
</body>
</html>